{% render 'sp-section-heading', heading_settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "Featured section heading",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "typography_source",
      "label": "Heading typography",
      "default": "global",
      "options": [
        {
          "value": "global",
          "label": "Use global heading"
        },
        {
          "value": "custom",
          "label": "Custom heading"
        }
      ],
      "info": "Global uses Theme settings H1–H6. Choose Custom to use the size/weight controls in this heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLER"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p><em>Top sale in this week</em></p>"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Optional heading icon"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ]
    },
    {
      "type": "select",
      "id": "design",
      "label": "Heading design",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "Design 1 — Clean"
        },
        {
          "value": "2",
          "label": "Design 2 — Kalles split lines"
        },
        {
          "value": "3",
          "label": "Design 3 — Accent bar"
        },
        {
          "value": "4",
          "label": "Design 4 — Double line"
        },
        {
          "value": "5",
          "label": "Design 5 — Framed"
        },
        {
          "value": "6",
          "label": "Design 6 — Split rules"
        },
        {
          "value": "7",
          "label": "Design 7 — Accent dot"
        },
        {
          "value": "8",
          "label": "Design 8 — Editorial"
        },
        {
          "value": "9",
          "label": "Design 9 — Highlight"
        },
        {
          "value": "10",
          "label": "Design 10 — Compact caps"
        },
        {
          "value": "11",
          "label": "Design 11 — Minimal rule"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "horizontal",
      "label": "Horizontal heading + button",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Desktop alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Heading / subheading gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Desktop heading size",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_tablet",
      "label": "Tablet heading size",
      "min": 18,
      "max": 52,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 90,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 115
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -2,
      "max": 6,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "label": "Use custom heading colors",
      "default": false
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111",
      "info": "Used when Use custom heading colors is enabled."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666",
      "info": "Used when Use custom heading colors is enabled."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Design accent",
      "default": "#111111",
      "info": "Used when Use custom heading colors is enabled."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Optional button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Optional button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open button in new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured section heading"
    }
  ]
}
{% endschema %}
