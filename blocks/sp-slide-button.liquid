{%- if block.settings.label != blank and block.settings.link != blank -%}
  <a
    id="SpiderSlideButton-{{ block.id }}"
    class="sp-slide-button sp-slide-button--{{ block.settings.style }}{% if block.settings.full_width %} is-full{% endif %}"
    href="{{ block.settings.link }}"
    {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
    data-sp-slide-anim
    {{ block.shopify_attributes }}
    style="--sp-slide-btn-radius: {{ block.settings.radius }}px; --sp-slide-btn-icon-size: {{ block.settings.icon_size }}px; --sp-slide-btn-icon-gap: {{ block.settings.icon_gap }}px;{% if block.settings.style == 'custom' %} --sp-slide-btn-bg: {{ block.settings.custom_background }}; --sp-slide-btn-text: {{ block.settings.custom_text }}; --sp-slide-btn-border: {{ block.settings.custom_border }}; --sp-slide-btn-hover-bg: {{ block.settings.custom_hover_background }}; --sp-slide-btn-hover-text: {{ block.settings.custom_hover_text }}; --sp-slide-btn-hover-border: {{ block.settings.custom_hover_border }};{% endif %}"
  >
    {% if block.settings.icon == 'arrow' and block.settings.icon_position == 'before' %}<span class="sp-slide-button__icon" aria-hidden="true">→</span>{% endif %}
    <span>{{ block.settings.label }}</span>
    {% if block.settings.icon == 'arrow' and block.settings.icon_position == 'after' %}<span class="sp-slide-button__icon" aria-hidden="true">→</span>{% endif %}
  </a>
{%- endif -%}
{% schema %}
{
  "name": "Slide Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "tertiary",
          "label": "Tertiary"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "text",
          "label": "Text link"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        }
      ]
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "default": "after",
      "options": [
        {
          "value": "before",
          "label": "Before"
        },
        {
          "value": "after",
          "label": "After"
        }
      ],
      "visible_if": "{{ block.settings.icon != 'none' }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.icon != 'none' }}"
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Icon spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.icon != 'none' }}"
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Custom background",
      "default": "#111111",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom text",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Custom border",
      "default": "#111111",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_hover_background",
      "label": "Custom hover background",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_hover_text",
      "label": "Custom hover text",
      "default": "#111111",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_hover_border",
      "label": "Custom hover border",
      "default": "#111111",
      "visible_if": "{{ block.settings.style == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Slide Button"
    }
  ]
}
{% endschema %}
