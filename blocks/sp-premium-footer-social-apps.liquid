<div class="sp-pf__social-area" {{ block.shopify_attributes }}>
  {% if block.settings.show_socials %}
    <section class="sp-pf__social-section" aria-label="Social media">
      {% if block.settings.social_heading != blank %}<h2>{{ block.settings.social_heading | escape }}</h2>{% endif %}
      {% if block.settings.social_text != blank %}<p>{{ block.settings.social_text | escape }}</p>{% endif %}
      <ul class="sp-pf__social-list" role="list">
        {% assign networks = 'instagram,tiktok,youtube,facebook,twitter,pinterest,linkedin' | split: ',' %}
        {% for network in networks %}
          {% assign key = 'social_' | append: network %}
          {% assign social_url = settings[key] %}
          {% if social_url != blank %}
            <li><a href="{{ social_url }}" aria-label="{{ network | capitalize }}"{% if settings.social_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
              {% render 'sp-premium-footer-icon', name: network %}
            </a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
  {% endif %}
  {% if block.settings.show_apps %}
    <section class="sp-pf__apps" aria-label="Mobile applications">
      {% if block.settings.apps_heading != blank %}<h2>{{ block.settings.apps_heading | escape }}</h2>{% endif %}
      {% if block.settings.apps_description != blank %}<p>{{ block.settings.apps_description | escape }}</p>{% endif %}
      <div class="sp-pf__app-badges">
        {% if block.settings.apple_url != blank %}<a href="{{ block.settings.apple_url }}" aria-label="Download from Apple App Store" target="_blank" rel="noopener noreferrer"><span class="sp-pf__app-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M17.6 12.5c0-2 1.6-3 1.7-3-1-1.5-2.5-1.7-3.1-1.7-1.3-.1-2.5.8-3.2.8-.8 0-1.8-.8-2.9-.8C8.5 7.8 7 8.7 6.2 10c-1.7 2.9-.5 7.2 1.2 9.5.9 1.1 1.9 2.3 3 2.3 1.1 0 1.5-.7 2.9-.7 1.3 0 1.7.7 2.9.7s2-.9 2.8-2c.9-1.3 1.3-2.6 1.3-2.7-2.8-1.1-2.7-3.8-2.7-3.8ZM15.3 6.5c.7-.8 1.1-1.8 1-2.8-1 .1-2.1.7-2.8 1.5-.7.8-1.2 1.8-1.1 2.8 1.1.1 2.2-.6 2.9-1.5Z"/></svg></span><span><small>Download on the</small><strong>App Store</strong></span></a>{% endif %}
        {% if block.settings.google_url != blank %}<a href="{{ block.settings.google_url }}" aria-label="Get it on Google Play" target="_blank" rel="noopener noreferrer"><span class="sp-pf__google-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="#42d07b" d="M3 2v20l11-10z"/><path fill="#39b3f4" d="m3 2 15 8.5-4 1.5z"/><path fill="#ef574e" d="m3 22 15-8.5-4-1.5z"/><path fill="#ffd44e" d="m14 12 4-1.5 3 1.5-3 1.5z"/></svg></span><span><small>GET IT ON</small><strong>Google Play</strong></span></a>{% endif %}
      </div>
    </section>
  {% endif %}
</div>
{% schema %}
{"name":"Footer social & apps","tag":null,"settings":[
 {"type":"checkbox","id":"show_socials","label":"Show social media","default":true},
 {"type":"text","id":"social_heading","label":"Social heading","default":"Join the conversation"},
 {"type":"text","id":"social_text","label":"Social description","default":"Follow us for #BetterSound"},
 {"type":"paragraph","content":"Uses the existing Spider social links in Theme settings. Unconfigured profiles are hidden."},
 {"type":"checkbox","id":"show_apps","label":"Show app download area","default":true},
 {"type":"text","id":"apps_heading","label":"App heading","default":"Shop on the go"},
 {"type":"text","id":"apps_description","label":"App description","default":"Get the Spider app for a faster, more personal shopping experience."},
 {"type":"url","id":"apple_url","label":"App Store URL"},
 {"type":"url","id":"google_url","label":"Google Play URL"}
 ],"presets":[{"name":"Footer social & apps"}]}
{% endschema %}
