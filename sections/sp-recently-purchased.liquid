    },
    {
      "type": "range",
      "id": "request_timeout",
      "label": "Request timeout",
      "default": 8000,
      "min": 2000,
      "max": 9000,
      "step": 1000,
      "unit": "ms"
    },
    {
      "type": "range",
      "id": "maximum_events",
      "label": "Maximum public events",
      "default": 8,
      "min": 1,
      "max": 16,
      "step": 1
    },
    {
