{% comment %}
  Spider Global Search Modal — one independent System Group search surface.
  Product/collection predictive markup is supplied by sp-search-modal-predictive.liquid.
{% endcomment %}
{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-search-modal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-search-modal.js' | asset_url }}" defer></script>

{%- liquid
  assign sp_search_popular_count = 0
  assign sp_search_categories_count = 0
  for block in section.blocks
    if block.type == 'popular_search' and block.settings.query != blank
      assign sp_search_popular_count = sp_search_popular_count | plus: 1
    elsif block.type == 'category_link' and block.settings.collection != blank
      assign sp_search_categories_count = sp_search_categories_count | plus: 1
    endif
  endfor
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    --sp-smodal-width: {{ section.settings.desktop_width }}px;
    --sp-smodal-height: {{ section.settings.modal_height }}dvh;
    --sp-smodal-sidebar: {{ section.settings.sidebar_width }}px;
    --sp-smodal-radius: {{ section.settings.modal_radius }}px;
    --sp-smodal-backdrop: {{ section.settings.backdrop_opacity | divided_by: 100.0 }};
    --sp-smodal-input-height: {{ section.settings.input_height }}px;
    --sp-smodal-image-size: {{ section.settings.product_image_size }}px;
    --sp-smodal-duration: {{ section.settings.animation_duration }}ms;
    --sp-smodal-accent: var(--sp-section-accent, var(--sp-color-accent, #415DFF));
    --sp-smodal-text: var(--sp-section-text, var(--sp-color-text, #3F3F46));
    --sp-smodal-heading: var(--sp-section-heading, var(--sp-color-heading, #171717));
    --sp-smodal-border: var(--sp-section-border, var(--sp-color-border, #E4E4E7));
    --sp-smodal-surface: var(--sp-section-card, var(--sp-color-surface, #FFFFFF));
  }
{% endstyle %}
<div
  class="sp-smodal"
  id="SpGlobalSearchModal"
  data-sp-search-modal
  data-enabled="{{ section.settings.enable_modal }}"
  data-section-id="{{ section.id }}"
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-search-url="{{ routes.search_url }}"
  data-result-section="sp-search-modal-predictive"
  data-types="{% if section.settings.show_products %}product,{% endif %}{% if section.settings.show_collections %}collection,{% endif %}{% if section.settings.show_articles %}article,{% endif %}{% if section.settings.show_pages %}page,{% endif %}query"
  data-min-chars="{{ section.settings.min_chars }}"
  data-debounce="{{ section.settings.debounce_ms }}"
  data-product-limit="{{ section.settings.product_limit }}"
  data-collection-limit="{{ section.settings.collection_limit }}"
  data-show-rating="{{ section.settings.show_rating }}"
  data-show-compare="{{ section.settings.show_compare_price }}"
  data-show-sale="{{ section.settings.show_sale_badge }}"
  data-show-vendor="{{ section.settings.show_vendor }}"
  data-show-collection-count="{{ section.settings.show_collection_count }}"
  data-history="{{ section.settings.show_recent }}"
  data-history-max="{{ section.settings.recent_max }}"
  data-close-backdrop="{{ section.settings.close_backdrop }}"
  data-search-root="{{ routes.root_url }}"
  {% unless section.settings.enable_modal %}hidden{% else %}hidden{% endunless %}
  aria-hidden="true"
>
  <div class="sp-smodal__backdrop" data-sp-smodal-backdrop aria-hidden="true"></div>
  <div class="sp-smodal__dialog" role="dialog" aria-modal="true" aria-label="Search store" tabindex="-1" data-sp-smodal-dialog>
    <div class="sp-smodal__top">
      <form class="sp-smodal__form" action="{{ routes.search_url }}" method="get" role="search" data-sp-smodal-form>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.3 16.3 5 5"/></svg>
        <label for="SpSearchModalInput-{{ section.id }}" class="visually-hidden">Search store</label>
        <input id="SpSearchModalInput-{{ section.id }}" type="search" name="q" value="" autocomplete="off" placeholder="{{ section.settings.placeholder | escape }}" data-sp-smodal-input aria-controls="SpSearchModalResults-{{ section.id }}" aria-autocomplete="list" />
        <button type="button" class="sp-smodal__clear" data-sp-smodal-clear hidden aria-label="Clear search"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6m0-6-6 6"/></svg></button>
      </form>
      <button class="sp-smodal__close" type="button" data-sp-smodal-close aria-label="Close search"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m5 5 14 14M19 5 5 19"/></svg></button>
    </div>
    <div class="sp-smodal__content">
      <aside class="sp-smodal__sidebar" aria-label="Search suggestions">
        {% if section.settings.show_recent %}
        <section class="sp-smodal__side-group" data-sp-smodal-recent hidden>
          <div class="sp-smodal__group-heading"><h3>{{ section.settings.recent_heading | escape }}</h3><button type="button" class="sp-smodal__text-link" data-sp-smodal-clear-all>Clear all</button></div>
          <ul class="sp-smodal__side-list" data-sp-smodal-recent-list></ul>
        </section>
        {% endif %}
        {% if section.settings.show_popular and sp_search_popular_count > 0 %}
        <section class="sp-smodal__side-group">
          <h3>{{ section.settings.popular_heading | escape }}</h3>
          <ul class="sp-smodal__side-list">
            {% for block in section.blocks %}{% if block.type == 'popular_search' and block.settings.query != blank %}
              <li {{ block.shopify_attributes }}><button type="button" data-sp-smodal-term="{{ block.settings.query | escape }}"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m3 17 7-7 4 4 7-8M16 6h5v5"/></svg><span>{{ block.settings.title | default: block.settings.query | escape }}</span></button></li>
            {% endif %}{% endfor %}
          </ul>
        </section>
        {% endif %}
        {% if section.settings.show_categories and section.settings.category_menu != blank or section.settings.show_categories and sp_search_categories_count > 0 %}
        <section class="sp-smodal__side-group">
          <h3>{{ section.settings.categories_heading | escape }}</h3>
          <ul class="sp-smodal__side-list sp-smodal__category-list">
            {% if section.settings.category_menu != blank %}
              {% for link in section.settings.category_menu.links limit: 10 %}
              {%- assign item_collection = link.object -%}
              <li>
                <a href="{{ link.url }}">
                  {% if link.type == 'collection_link' and item_collection.image != blank %}{{ item_collection.image | image_url: width: 100 | image_tag: widths: '50,100', loading: 'lazy', alt: link.title, class: 'sp-smodal__category-image' }}{% else %}<span class="sp-smodal__category-placeholder" aria-hidden="true">◫</span>{% endif %}
                  <span>{{ link.title | escape }}</span><span class="sp-smodal__chevron" aria-hidden="true">›</span>
                </a>
              </li>
              {% endfor %}
            {% endif %}
            {% for block in section.blocks %}{% if block.type == 'category_link' and block.settings.collection != blank %}
              {%- assign category_collection = block.settings.collection -%}
              {%- assign category_image = block.settings.image | default: category_collection.image -%}
              <li {{ block.shopify_attributes }}><a href="{{ category_collection.url }}">
                {% if category_image != blank %}{{ category_image | image_url: width: 100 | image_tag: widths: '50,100', loading: 'lazy', alt: category_collection.title, class: 'sp-smodal__category-image' }}{% else %}<span class="sp-smodal__category-placeholder" aria-hidden="true">◫</span>{% endif %}
                <span>{{ block.settings.title | default: category_collection.title | escape }}</span><span class="sp-smodal__chevron" aria-hidden="true">›</span>
              </a></li>
            {% endif %}{% endfor %}
          </ul>
        </section>
        {% endif %}
        {% assign custom_link_count = 0 %}
        {% for block in section.blocks %}{% if block.type == 'custom_search_link' and block.settings.label != blank and block.settings.url != blank %}{% assign custom_link_count = custom_link_count | plus: 1 %}{% endif %}{% endfor %}
        {% if custom_link_count > 0 %}<section class="sp-smodal__side-group"><h3>Helpful links</h3><ul class="sp-smodal__side-list">
          {% for block in section.blocks %}{% if block.type == 'custom_search_link' and block.settings.label != blank and block.settings.url != blank %}<li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}">{{ block.settings.label | escape }} <span class="sp-smodal__chevron" aria-hidden="true">›</span></a></li>{% endif %}{% endfor %}
        </ul></section>{% endif %}
      </aside>
      <div class="sp-smodal__main">
        <div class="sp-smodal__results" id="SpSearchModalResults-{{ section.id }}" data-sp-smodal-results aria-live="polite" aria-busy="false">
          <div class="sp-smodal__initial" data-sp-smodal-initial>
            {% assign curated_count = 0 %}
            {% for block in section.blocks %}{% if block.type == 'category_link' and block.settings.collection != blank %}{% assign curated_count = curated_count | plus: 1 %}{% endif %}{% endfor %}
            {% if section.settings.show_collections and curated_count > 0 %}
            <div class="sp-smodal__results-heading"><h3>{{ section.settings.collections_heading | escape }}</h3><a href="{{ routes.collections_url | default: '/collections' }}">View all collections <span aria-hidden="true">→</span></a></div>
            <div class="sp-smodal__collection-grid">
              {% for block in section.blocks limit: 30 %}{% if block.type == 'category_link' and block.settings.collection != blank %}
                {% assign collection_item = block.settings.collection %}
                {% assign collection_image = block.settings.image | default: collection_item.image %}
                <a class="sp-smodal__collection" href="{{ collection_item.url }}">
                  {% if collection_image != blank %}{{ collection_image | image_url: width: 360 | image_tag: widths: '160,240,360', loading: 'lazy', class: 'sp-smodal__collection-photo', alt: collection_item.title }}{% else %}<span class="sp-smodal__collection-empty" aria-hidden="true">◫</span>{% endif %}
                  <span class="sp-smodal__collection-details"><strong>{{ block.settings.title | default: collection_item.title | escape }}</strong><small>{{ collection_item.all_products_count }} products</small></span>
                </a>
              {% endif %}{% endfor %}
            </div>
            {% else %}
              <div class="sp-smodal__initial-hint"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><p>Search products, collections, articles and pages.</p></div>
            {% endif %}
          </div>
        </div>
        <p class="sp-smodal__status visually-hidden" data-sp-smodal-status role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Search modal",
  "tag": "section",
  "class": "sp-global-search-section",
  "limit": 1,
  "enabled_on": {"groups": ["custom.system"]},
  "settings": [
    {"type":"header","content":"Global design system"},
    {"type":"color_scheme","id":"sp_color_scheme","label":"Color scheme","default":"scheme-1"},
    {"type":"checkbox","id":"enable_modal","label":"Enable global search modal","default":true},
    {"type":"header","content":"Desktop modal"},
    {"type":"range","id":"desktop_width","label":"Maximum width","min":800,"max":1500,"step":20,"unit":"px","default":1180},
    {"type":"range","id":"modal_height","label":"Maximum viewport height","min":70,"max":100,"step":5,"unit":"%","default":95},
    {"type":"range","id":"sidebar_width","label":"Sidebar width","min":240,"max":400,"step":20,"unit":"px","default":320},
    {"type":"range","id":"modal_radius","label":"Corner radius","min":0,"max":32,"step":2,"unit":"px","default":16},
    {"type":"range","id":"backdrop_opacity","label":"Backdrop opacity","min":0,"max":90,"step":5,"unit":"%","default":60},
    {"type":"checkbox","id":"close_backdrop","label":"Close on backdrop click","default":true},
    {"type":"range","id":"animation_duration","label":"Opening animation","min":100,"max":500,"step":25,"unit":"ms","default":300},
    {"type":"header","content":"Search field"},
    {"type":"text","id":"placeholder","label":"Input placeholder","default":"Search products, articles and pages"},
    {"type":"range","id":"input_height","label":"Input height","min":44,"max":64,"step":2,"unit":"px","default":52},
    {"type":"range","id":"min_chars","label":"Minimum characters","min":1,"max":4,"step":1,"default":2},
    {"type":"range","id":"debounce_ms","label":"Predictive delay","min":100,"max":500,"step":25,"unit":"ms","default":250},
    {"type":"header","content":"Left sidebar"},
    {"type":"checkbox","id":"show_recent","label":"Recent searches (browser local)","default":true},
    {"type":"text","id":"recent_heading","label":"Recent searches heading","default":"Recent searches"},
    {"type":"range","id":"recent_max","label":"Maximum recent queries","min":1,"max":10,"step":1,"default":5},
    {"type":"checkbox","id":"show_popular","label":"Show popular search links","default":true},
    {"type":"text","id":"popular_heading","label":"Popular searches heading","default":"Popular searches"},
    {"type":"checkbox","id":"show_categories","label":"Show categories","default":true},
    {"type":"text","id":"categories_heading","label":"Category heading","default":"Shop by category"},
    {"type":"link_list","id":"category_menu","label":"Categories navigation menu"},
    {"type":"header","content":"Results"},
    {"type":"checkbox","id":"show_products","label":"Show products","default":true},
    {"type":"checkbox","id":"show_collections","label":"Show collections","default":true},
    {"type":"checkbox","id":"show_articles","label":"Show articles","default":false},
    {"type":"checkbox","id":"show_pages","label":"Show pages","default":false},
    {"type":"text","id":"collections_heading","label":"Collections heading","default":"Collections"},
    {"type":"checkbox","id":"show_vendor","label":"Show product vendor","default":false},
    {"type":"checkbox","id":"show_rating","label":"Show genuine ratings when available","default":true},
    {"type":"checkbox","id":"show_sale_badge","label":"Show real sale badges","default":true},
    {"type":"checkbox","id":"show_compare_price","label":"Show compare-at prices","default":true},
    {"type":"checkbox","id":"show_collection_count","label":"Show collection product counts when available","default":true},
    {"type":"range","id":"product_limit","label":"Visible product rows","min":1,"max":10,"step":1,"default":4},
    {"type":"range","id":"collection_limit","label":"Visible collection cards","min":1,"max":10,"step":1,"default":4},
    {"type":"range","id":"product_image_size","label":"Product image size","min":64,"max":140,"step":4,"unit":"px","default":120},
    {"type":"paragraph","content":"Predictive counts show returned matches, not the entire store total. Product ratings appear only when rating metafields exist."},
    {"type":"header","content":"Mobile"},
    {"type":"paragraph","content":"On mobile the modal fills the viewport and stacks suggestions with product results. Safe-area padding is included."}
  ],
  "blocks": [
    {"type":"popular_search","name":"Popular search","settings":[
      {"type":"text","id":"title","label":"Display label"},
      {"type":"text","id":"query","label":"Search phrase"}
    ]},
    {"type":"category_link","name":"Category collection","settings":[
      {"type":"collection","id":"collection","label":"Collection"},
      {"type":"text","id":"title","label":"Custom title"},
      {"type":"image_picker","id":"image","label":"Custom image"}
    ]},
    {"type":"custom_search_link","name":"Helpful link","settings":[
      {"type":"text","id":"label","label":"Label"},
      {"type":"url","id":"url","label":"Link"}
    ]}
  ],
  "max_blocks": 40,
  "presets": [{"name":"Search modal"}]
}
{% endschema %}
