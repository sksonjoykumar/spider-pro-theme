{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-recently-viewed-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-recently-viewed-products.js' | asset_url }}" defer></script>

{%- liquid
  assign sp_product_design = blank
  assign sp_renderer_section = 'sp-rv-card-global'
  unless section.settings.use_global_product_settings
    assign sp_product_design = section.settings.product_style | default: '01' | append: '' | strip
    case sp_product_design
      when '01', '1'
        assign sp_renderer_section = 'sp-rv-card-1'
      when '02', '2'
        assign sp_renderer_section = 'sp-rv-card-2'
      when '03', '3'
        assign sp_renderer_section = 'sp-rv-card-3'
      when '04', '4'
        assign sp_renderer_section = 'sp-rv-card-4'
      when '05', '5'
        assign sp_renderer_section = 'sp-rv-card-5'
      when '06', '6'
        assign sp_renderer_section = 'sp-rv-card-6'
      when '07', '7'
        assign sp_renderer_section = 'sp-rv-card-7'
      when '08', '8'
        assign sp_renderer_section = 'sp-rv-card-8'
      else
        assign sp_renderer_section = 'sp-rv-card-1'
    endcase
  endunless

  assign sp_container_choice = section.settings.container_width | default: 'theme'
  assign sp_container_class = 'sp-container'
  case sp_container_choice
    when 'full'
      assign sp_container_class = 'sp-recently-viewed-products__container--full'
    when 'wide'
      assign sp_container_class = 'sp-container sp-container--wide'
    when 'narrow'
      assign sp_container_class = 'sp-container sp-container--narrow'
    when 'boxed'
      assign sp_container_class = 'sp-container'
    else
      if settings.sp_layout_style == 'full'
        assign sp_container_class = 'sp-recently-viewed-products__container--full'
      endif
  endcase

  assign sp_heading_style = section.settings.heading_style | default: 'h2'
  assign sp_heading_tag = sp_heading_style
  assign sp_typography_source = 'global'
  if sp_heading_style == 'custom'
    assign sp_heading_tag = 'h2'
    assign sp_typography_source = 'custom'
  endif

  assign sp_spacing_class = 'sp-recently-viewed-products--theme-spacing'
  if section.settings.spacing_source == 'custom'
    assign sp_spacing_class = 'sp-recently-viewed-products--custom-spacing'
  endif

  assign sp_autoplay_ms = section.settings.autoplay_speed | times: 1000
  assign sp_current_product_id = ''
  assign sp_current_product_handle = ''
  assign sp_current_variant_id = ''
  if request.page_type == 'product' and product != blank
    assign sp_current_product_id = product.id
    assign sp_current_product_handle = product.handle
    assign sp_current_variant_id = product.selected_or_first_available_variant.id
  endif
-%}

<sp-recently-viewed-products
  class="sp-recently-viewed-products {{ sp_spacing_class }}"
  data-sp-recently-viewed-products
  data-section-id="{{ section.id }}"
  data-renderer-section="{{ sp_renderer_section }}"
  data-products-to-show="{{ section.settings.products_to_show }}"
  data-min-products="{{ section.settings.minimum_products }}"
  data-history-max="{{ section.settings.history_max }}"
  data-expiration-days="{{ section.settings.expiration_days }}"
  data-hide-sold-out="{{ section.settings.hide_sold_out }}"
  data-layout="{{ section.settings.layout }}"
  data-current-product-id="{{ sp_current_product_id }}"
  data-current-product-handle="{{ sp_current_product_handle | escape }}"
  data-current-variant-id="{{ sp_current_variant_id }}"
  data-core-url="{{ 'sp-recently-viewed-core.js' | asset_url }}"
  data-design-mode="{{ request.design_mode }}"
  data-product-design="{% if sp_product_design != blank %}{{ sp_product_design }}{% else %}global{% endif %}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-money-format="{{ shop.money_with_currency_format | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-compare-max="4"
  data-buy-now="{{ settings.dynamic_checkout }}"
  aria-busy="true"
  aria-label="{{ section.settings.heading | default: 'Recently viewed' | escape }}"
  style="
    --sp-rv-cols-d: {{ section.settings.columns_desktop }};
    --sp-rv-cols-t: {{ section.settings.columns_tablet }};
    --sp-rv-cols-m: {{ section.settings.columns_mobile }};
    --sp-rv-gap-d: {{ section.settings.gap_desktop }}px;
    --sp-rv-gap-t: {{ section.settings.gap_tablet }}px;
    --sp-rv-gap-m: {{ section.settings.gap_mobile }}px;
    --sp-rv-pt-d: {{ section.settings.padding_top_desktop }}px;
    --sp-rv-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --sp-rv-pt-t: {{ section.settings.padding_top_tablet }}px;
    --sp-rv-pb-t: {{ section.settings.padding_bottom_tablet }}px;
    --sp-rv-pt-m: {{ section.settings.padding_top_mobile }}px;
    --sp-rv-pb-m: {{ section.settings.padding_bottom_mobile }}px;
  "
  {% unless request.design_mode %}hidden{% endunless %}
>
  <div class="{{ sp_container_class }} sp-recently-viewed-products__container">
    <div data-sp-rv-heading>
      {% render 'sp-section-heading',
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        heading_tag: sp_heading_tag,
        design: section.settings.heading_design,
        alignment: section.settings.heading_alignment,
        mobile_alignment: section.settings.heading_alignment_mobile,
        heading_gap: section.settings.heading_gap,
        bottom_spacing: section.settings.heading_bottom_spacing,
        typography_source: sp_typography_source,
        heading_size_desktop: section.settings.heading_size_desktop,
        heading_size_tablet: section.settings.heading_size_tablet,
        heading_size_mobile: section.settings.heading_size_mobile,
        heading_weight: section.settings.heading_weight,
        heading_line_height: section.settings.heading_line_height,
        heading_letter_spacing: section.settings.heading_letter_spacing,
        subheading_size: section.settings.subheading_size
      %}
    </div>

    {%- if section.settings.layout == 'grid' -%}
      <div class="sp-recently-viewed-products__grid sp-product-display" data-sp-rv-products data-title-lines="2"></div>
    {%- else -%}
      <div
        class="sp-recently-viewed-products__carousel sp-carousel-block sp-product-display"
        data-sp-rv-carousel
        data-loop="{{ section.settings.loop }}"
        data-autoplay="{{ section.settings.autoplay }}"
        data-autoplay-delay="{{ sp_autoplay_ms }}"
        data-pause-hover="{{ section.settings.pause_on_hover }}"
        data-drag="{{ section.settings.mouse_drag }}"
        data-outside-opacity="false"
        data-pagination-style="{{ section.settings.pagination_style }}"
        data-design-mode="{{ request.design_mode }}"
        data-title-lines="2"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading | default: 'Recently viewed products' | escape }}"
      >
        <div class="sp-recently-viewed-products__viewport" data-sp-carousel-viewport tabindex="0">
          <div class="sp-recently-viewed-products__track" data-sp-carousel-track data-sp-rv-products></div>
        </div>

        {%- if section.settings.show_arrows -%}
          <div class="sp-recently-viewed-products__navigation" aria-label="Recently viewed product navigation">
            <button class="sp-recently-viewed-products__arrow sp-recently-viewed-products__arrow--prev" type="button" data-sp-carousel-prev aria-label="Previous products">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="sp-recently-viewed-products__arrow sp-recently-viewed-products__arrow--next" type="button" data-sp-carousel-next aria-label="Next products">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_dots or section.settings.autoplay -%}
          <div class="sp-recently-viewed-products__controls">
            {%- if section.settings.show_dots -%}<div class="sp-recently-viewed-products__pagination" data-sp-carousel-pagination aria-label="Recently viewed pages"></div>{%- endif -%}
            {%- if section.settings.autoplay -%}
              <button class="sp-recently-viewed-products__pause" type="button" data-sp-carousel-pause aria-label="Pause autoplay" aria-pressed="false">
                <span aria-hidden="true">Ⅱ</span><span class="visually-hidden">Pause autoplay</span>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sp-recently-viewed-products__editor-state" data-sp-rv-editor-state {% unless request.design_mode %}hidden{% endunless %} role="status">
      Browse at least two products in this storefront to populate Recently Viewed Products. On a product page, the current product is intentionally excluded from its own Recently Viewed list.
    </div>

    {%- if section.settings.show_clear_history -%}
      <div class="sp-recently-viewed-products__footer" data-sp-rv-footer hidden>
        <button type="button" class="sp-button sp-button--secondary sp-recently-viewed-products__clear" data-sp-rv-clear>Clear recently viewed</button>
      </div>
    {%- endif -%}

    <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-sp-rv-status></p>
  </div>
</sp-recently-viewed-products>

<noscript><style>#shopify-section-{{ section.id }} .sp-recently-viewed-products{display:none!important}</style></noscript>

{% schema %}
