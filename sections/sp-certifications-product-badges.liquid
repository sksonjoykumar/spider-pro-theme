{% comment %}
  Spider native Certifications & Product Badges.
  Demo blocks are editor-only until explicitly enabled. No fabricated certification evidence.
{% endcomment %}
{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'sp-certifications-product-badges.css' | asset_url | stylesheet_tag }}
{%- if section.settings.layout_style == 'style_4' or section.settings.layout_style == 'style_5' or section.settings.details_behavior == 'modal' or section.settings.details_behavior == 'drawer' -%}
  <script src="{{ 'sp-certifications-product-badges.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- liquid
  assign s = section.settings
  assign active_ids = '|'
  assign inapplicable_ids = '|'
  assign active_categories = '|'
  assign featured_id = ''
  assign first_id = ''
  assign active_count = 0
  for block in section.blocks
    assign b = block.settings
    assign applicable = false
    case b.applicability_mode
      when 'all_products'
        assign applicable = true
      when 'informational_only'
        assign applicable = true
      when 'selected_products'
        if product != blank and b.applicable_products != blank
          for chosen in b.applicable_products
            if product.id == chosen.id
              assign applicable = true
              break
            endif
          endfor
        endif
      when 'selected_collections'
        if product != blank and b.applicable_collections != blank
          for chosen_collection in b.applicable_collections
            for current_collection in product.collections
              if chosen_collection.id == current_collection.id
                assign applicable = true
                break
              endif
            endfor
            if applicable
              break
            endif
          endfor
        endif
      when 'product_type'
        if product != blank and b.applicable_product_types != blank
          assign type_list = b.applicable_product_types | split: ','
          for given_type in type_list
            assign clean_type = given_type | strip
            if clean_type != blank and clean_type == product.type
              assign applicable = true
              break
            endif
          endfor
        endif
      when 'product_tag'
        if product != blank and b.applicable_tags != blank
          assign tags_list = b.applicable_tags | split: ','
          for given_tag in tags_list
            assign clean_tag = given_tag | strip
            if clean_tag != blank and product.tags contains clean_tag
              assign applicable = true
              break
            endif
          endfor
        endif
    endcase
    assign show_badge_now = false
    if b.enable_badge and applicable
      assign show_badge_now = true
    elsif b.enable_badge and b.show_when_not_applicable and product != blank
      assign show_badge_now = true
      assign inapplicable_ids = inapplicable_ids | append: block.id | append: '|'
    endif
    if request.design_mode
      assign show_badge_now = true
    endif
    if show_badge_now
      assign active_count = active_count | plus: 1
      assign active_ids = active_ids | append: block.id | append: '|'
      if first_id == blank
        assign first_id = block.id
      endif
      if b.featured_badge and featured_id == blank
        assign featured_id = block.id
      endif
      assign category_key = '|' | append: b.category | append: '|'
      unless active_categories contains category_key
        assign active_categories = active_categories | append: b.category | append: '|'
      endunless
    endif
  endfor
  if featured_id == blank
    assign featured_id = first_id
  endif
  assign container_class = 'sp-container'
  if s.section_max_width == 'wide'
    assign container_class = 'sp-container sp-container--wide'
  endif
  assign root_class = 'sp-cpb sp-cpb--' | append: s.layout_style | append: ' sp-cpb--heading-' | append: s.heading_size | append: ' sp-cpb--hover-' | append: s.card_hover_effect | append: ' sp-cpb--highlight-' | append: s.highlight_style | append: ' sp-cpb--media-' | append: s.media_style | append: ' sp-cpb--logo-fit-' | append: s.logo_fit | append: ' sp-cpb--notice-' | append: s.notice_style | append: ' sp-cpb--category-' | append: s.category_navigation_style | append: ' sp-cpb--mobile-category-' | append: s.mobile_category_navigation | append: ' sp-cpb--feature-' | append: s.featured_badge_position | append: ' sp-cpb--mobile-feature-' | append: s.mobile_featured_position
  unless s.card_equal_height
    assign root_class = root_class | append: ' sp-cpb--unequal'
  endunless
  assign cta_attributes = ''
  if s.section_button_new_tab
    assign cta_attributes = 'target="_blank" rel="noopener noreferrer"'
  endif
  assign safe_button_label = s.section_button_label | escape
-%}
{%- if active_count > 0 -%}
<section id="sp-cpb-{{ section.id }}" class="sp-section {{ root_class }}" data-sp-cpb-root data-sp-cpb-style="{{ s.layout_style }}" data-sp-cpb-infinite="{{ s.infinite_loop }}" data-sp-cpb-autoplay="{{ s.enable_autoplay }}" data-sp-cpb-autoplay-speed="{{ s.autoplay_speed }}" data-sp-cpb-pause-hover="{{ s.pause_on_hover }}" data-sp-cpb-pointer-drag="{{ s.enable_pointer_drag }}" data-sp-cpb-swipe="{{ s.enable_swipe }}" data-sp-cpb-details="{{ s.details_behavior }}" data-sp-cpb-default-category="{{ s.default_category }}" data-sp-cpb-details-navigation="{{ s.show_details_navigation }}" data-sp-cpb-rtl="{% if request.locale.direction == 'rtl' %}true{% else %}false{% endif %}" style="
--sp-cpb-pt:{{ s.padding_top }}px;--sp-cpb-pb:{{ s.padding_bottom }}px;
--sp-cpb-pt-t:{{ s.padding_top_tablet }}px;--sp-cpb-pb-t:{{ s.padding_bottom_tablet }}px;
--sp-cpb-pt-m:{{ s.padding_top_mobile }}px;--sp-cpb-pb-m:{{ s.padding_bottom_mobile }}px;
--sp-cpb-cols-d:{{ s.desktop_columns }};--sp-cpb-cols-t:{{ s.tablet_columns }};--sp-cpb-cols-m:{{ s.mobile_columns }};
--sp-cpb-gap-d:{{ s.grid_gap_desktop }}px;--sp-cpb-gap-t:{{ s.grid_gap_tablet }}px;--sp-cpb-gap-m:{{ s.grid_gap_mobile }}px;
--sp-cpb-radius:{{ s.card_border_radius }}px;--sp-cpb-bw:{{ s.card_border_width }}px;
--sp-cpb-card-pad:{{ s.card_padding_desktop }}px;--sp-cpb-card-min-height:{{ s.card_min_height | default: 184 }}px;--sp-cpb-card-pad-m:{{ s.card_padding_mobile }}px;
--sp-cpb-media-size:{{ s.media_size_desktop }}px;--sp-cpb-media-size-m:{{ s.media_size_mobile }}px;
--sp-cpb-media-radius:{{ s.media_border_radius }}px;--sp-cpb-logo-w:{{ s.logo_max_width }}px;--sp-cpb-logo-h:{{ s.logo_max_height }}px;
--sp-cpb-card-gap:{{ s.card_content_gap }}px;--sp-cpb-header-gap:{{ s.header_bottom_spacing }}px;
--sp-cpb-grid-to-notice:{{ s.grid_to_notice_spacing }}px;--sp-cpb-button-to-grid:{{ s.button_to_grid_spacing }}px;
--sp-cpb-header-to-button:{{ s.header_to_button_spacing }}px;
--sp-cpb-slides-d:{{ s.desktop_slides }};--sp-cpb-slides-t:{{ s.tablet_slides }};--sp-cpb-slides-m:{{ s.mobile_slides }};
--sp-cpb-card-bg:{% if s.use_custom_colors %}{{ s.card_background }}{% else %}var(--sp-section-card, var(--sp-color-card, #fff)){% endif %};
--sp-cpb-border:{% if s.use_custom_colors %}{{ s.card_border_color }}{% else %}var(--sp-section-border, #E4E4E7){% endif %};
--sp-cpb-icon-bg:{% if s.use_custom_colors %}{{ s.media_background }}{% else %}color-mix(in srgb, var(--sp-section-accent, #415DFF) 8%, var(--sp-section-card, #fff)){% endif %};
--sp-cpb-accent:{% if s.use_custom_colors %}{{ s.accent_color }}{% else %}var(--sp-section-accent, #415DFF){% endif %};
--sp-cpb-note-bg:color-mix(in srgb, var(--sp-cpb-accent) 7%, var(--sp-section-card,#fff));
--sp-cpb-card-align:{{ s.card_text_alignment }};
--sp-cpb-vertical-align:{{ s.content_vertical_alignment }};
--sp-cpb-shadow:{% if s.card_shadow == 'subtle' %}0 8px 25px rgba(0,0,0,.055){% elsif s.card_shadow == 'medium' %}0 14px 38px rgba(0,0,0,.10){% else %}none{% endif %};
--sp-cpb-logo-opacity:{{ s.logo_opacity | divided_by: 100.0 }};
--sp-cpb-logo-filter:{% if s.logo_grayscale %}grayscale(1){% else %}none{% endif %};
" aria-label="{{ s.heading | default: 'Standards and badges' | escape }}">
  <div class="{{ container_class }}">
    {%- if s.show_header -%}
      <div class="sp-cpb__intro sp-cpb__intro--{{ s.heading_alignment }}" style="--sp-cpb-header-width:{{ s.header_max_width }}px;--sp-cpb-desc-width:{{ s.description_width }}px;">
        {%- if s.eyebrow != blank -%}<p class="sp-cpb__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {% render 'sp-section-heading', heading_settings: s, heading: s.heading, subheading: s.description, heading_tag: 'h2', alignment: s.heading_alignment, mobile_alignment: 'center', bottom_spacing: 0 %}
        {%- if s.show_section_button and s.section_button_label != blank -%}
          <div class="sp-cpb__cta sp-cpb__cta--{{ s.section_button_position }}">
            {%- if s.section_button_link != blank -%}
              {% render 'button', label: safe_button_label, href: s.section_button_link, style: s.section_button_style, class: 'sp-cpb__cta-button', attributes: cta_attributes %}
            {%- elsif request.design_mode -%}
              <span class="sp-button sp-button--{{ s.section_button_style }} sp-cpb__cta-button sp-cpb__cta-demo" title="Set a button link to publish this action">{{ s.section_button_label | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.layout_style == 'style_4' -%}
      <div class="sp-cpb__filters" data-sp-cpb-filters aria-label="Filter standards by category">
        {%- if s.show_all_category -%}<button type="button" class="sp-cpb__filter" data-sp-cpb-filter="all" aria-pressed="true">{{ s.all_category_label | default: 'All standards' | escape }}</button>{%- endif -%}
        {%- assign cats = 'materials,sustainability,safety,ethics,warranty,other' | split: ',' -%}
        {%- for cat in cats -%}
          {%- assign cat_lookup = '|' | append: cat | append: '|' -%}
          {%- if active_categories contains cat_lookup -%}<button class="sp-cpb__filter" type="button" data-sp-cpb-filter="{{ cat }}" aria-pressed="false">{{ cat | capitalize }}</button>{%- endif -%}
        {%- endfor -%}
        <label class="sp-cpb__filter-select-wrap" for="sp-cpb-filter-select-{{ section.id }}"><span class="sp-cpb__visually-hidden">Choose category</span><select id="sp-cpb-filter-select-{{ section.id }}" data-sp-cpb-filter-select class="sp-cpb__filter-select">
          {%- if s.show_all_category -%}<option value="all">{{ s.all_category_label | escape }}</option>{%- endif -%}
          {%- for cat in cats -%}{%- assign cat_lookup = '|' | append: cat | append: '|' -%}{%- if active_categories contains cat_lookup -%}<option value="{{ cat }}">{{ cat | capitalize }}</option>{%- endif -%}{%- endfor -%}
        </select></label>
      </div>
    {%- endif -%}
    {%- if s.notice_position == 'before' -%}
    {%- if s.show_notice and s.notice_text != blank -%}
      <aside class="sp-cpb__notice sp-cpb__notice--{{ s.notice_position }}">
        {%- if s.notice_icon != 'none' -%}<span class="sp-cpb__notice-icon" aria-hidden="true">{% render 'sp-content-icon', name: s.notice_icon %}</span>{%- endif -%}
        <div>{%- if s.notice_heading != blank -%}<strong>{{ s.notice_heading | escape }}</strong>{%- endif -%}<div class="rte">{{ s.notice_text }}</div></div>
      </aside>
    {%- endif -%}
    {%- endif -%}
    <div class="sp-cpb__list-wrap{% if s.show_partial_next_card %} sp-cpb__list-wrap--peek{% endif %}" data-sp-cpb-track-wrap>
      <ul class="sp-cpb__list" data-sp-cpb-track aria-label="Standards and product badges">
        {%- for block in section.blocks -%}
          {%- assign needle = '|' | append: block.id | append: '|' -%}
          {%- if active_ids contains needle -%}
            {%- assign demo_badge = false -%}
            {%- unless block.settings.enable_badge -%}{%- assign demo_badge = true -%}{%- endunless -%}
            {%- assign not_applicable = false -%}
            {%- if inapplicable_ids contains needle -%}{%- assign not_applicable = true -%}{%- endif -%}
            {%- assign feature_this = false -%}
            {%- if block.id == featured_id and s.layout_style == 'style_3' -%}{%- assign feature_this = true -%}{%- endif -%}
            {% render 'sp-certification-badge-card', block: block, section: section, is_featured: feature_this, demo: demo_badge, not_applicable: not_applicable %}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    {%- if s.layout_style == 'style_5' and active_count > 1 -%}
      <div class="sp-cpb__carousel-controls" data-sp-cpb-controls>
        {%- if s.show_arrows -%}<button type="button" data-sp-cpb-prev class="sp-cpb__arrow" aria-label="Previous standards"><span aria-hidden="true">{% if request.locale.direction == 'rtl' %}→{% else %}←{% endif %}</span></button>{%- endif -%}
        {%- if s.show_dots -%}<div class="sp-cpb__dots" data-sp-cpb-dots aria-label="Carousel pages"></div>{%- endif -%}
        {%- if s.show_progress_bar -%}<div class="sp-cpb__progress" aria-hidden="true"><span data-sp-cpb-progress></span></div>{%- endif -%}
        {%- if s.show_arrows -%}<button type="button" data-sp-cpb-next class="sp-cpb__arrow" aria-label="Next standards"><span aria-hidden="true">{% if request.locale.direction == 'rtl' %}←{% else %}→{% endif %}</span></button>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.notice_position == 'after' -%}
    {%- if s.show_notice and s.notice_text != blank -%}
      <aside class="sp-cpb__notice sp-cpb__notice--{{ s.notice_position }}">
        {%- if s.notice_icon != 'none' -%}<span class="sp-cpb__notice-icon" aria-hidden="true">{% render 'sp-content-icon', name: s.notice_icon %}</span>{%- endif -%}
        <div>{%- if s.notice_heading != blank -%}<strong>{{ s.notice_heading | escape }}</strong>{%- endif -%}<div class="rte">{{ s.notice_text }}</div></div>
      </aside>
    {%- endif -%}
    {%- endif -%}
    {%- if s.show_product_disclaimer and product != blank and s.product_disclaimer != blank -%}<div class="sp-cpb__product-disclaimer rte">{{ s.product_disclaimer }}</div>{%- endif -%}
  </div>
  {%- if s.details_behavior == 'modal' or s.details_behavior == 'drawer' -%}
    <dialog class="sp-cpb__dialog{% if s.details_behavior == 'drawer' %} sp-cpb__dialog--drawer{% endif %}" data-sp-cpb-dialog data-sp-cpb-overlay-close="{{ s.close_on_overlay }}" aria-labelledby="sp-cpb-dialog-title-{{ section.id }}">
      <div class="sp-cpb__dialog-inner"><div class="sp-cpb__dialog-head"><h2 id="sp-cpb-dialog-title-{{ section.id }}" data-sp-cpb-dialog-title>{{ s.details_modal_title | escape }}</h2><div class="sp-cpb__dialog-actions">{% if s.show_details_navigation %}<button type="button" class="sp-cpb__dialog-nav" data-sp-cpb-detail-prev aria-label="Previous standard">←</button><button type="button" class="sp-cpb__dialog-nav" data-sp-cpb-detail-next aria-label="Next standard">→</button>{% endif %}<button type="button" data-sp-cpb-close class="sp-cpb__close" aria-label="Close details">×</button></div></div><div data-sp-cpb-dialog-content class="sp-cpb__dialog-content"></div></div>
    </dialog>
  {%- endif -%}
</section>
{%- elsif request.design_mode -%}
  <div class="sp-container"><p>Add certification blocks to preview this section.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Certifications & Badges",
  "tag": "section",
  "class": "sp-cpb-shopify-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Native color scheme"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Uses Spider Theme global color schemes."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STANDARDS THAT MATTER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made Better. Verified Clearly."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Transparent materials, responsible practices, and quality you can trust.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "large",
      "options": [
        {
          "value": "global",
          "label": "Theme heading"
        },
        {
          "value": "small",
          "label": "Compact"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "description_width",
      "label": "Description width",
      "default": 800,
      "min": 300,
      "max": 1100,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Header max width",
      "default": 1180,
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px"
    },
    {
