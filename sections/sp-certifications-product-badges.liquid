      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout style"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Badge layout",
      "default": "style_1",
      "options": [
        {
          "value": "style_1",
          "label": "Certification Card Grid"
        },
        {
          "value": "style_2",
          "label": "Minimal Badge Wall"
        },
        {
          "value": "style_3",
          "label": "Featured Standard"
        },
        {
          "value": "style_4",
          "label": "Categorized Standards"
        },
        {
          "value": "style_5",
          "label": "Certification Carousel"
        }
      ]
    },
    {
      "type": "select",
