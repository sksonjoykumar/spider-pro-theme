      "type": "select",
      "id": "featured_badge_position",
      "label": "Featured position",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_featured_position",
      "label": "Mobile featured position",
      "default": "first",
      "options": [
        {
          "value": "first",
          "label": "First"
        },
        {
          "value": "natural",
          "label": "Original order"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section button"
    },
    {
      "type": "checkbox",
      "id": "show_section_button",
      "label": "Show section button",
      "default": true
    },
    {
      "type": "text",
      "id": "section_button_label",
      "label": "Button text",
      "default": "View our standards"
    },
    {
