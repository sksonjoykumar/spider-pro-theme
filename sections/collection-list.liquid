    {
      "type": "header",
      "content": "Responsive layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop items per row",
      "min": 2,
      "max": 7,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet items per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile items per row",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Responsive grid"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        }
      ]
    },
    {
      "type": "range",
