{{ 'sp-content-sections.css' | asset_url | stylesheet_tag }}
{% render 'sp-section-color-scheme', section: section %}

{%- liquid
  assign collection_style = section.settings.collection_style | default: 'minimal'
  assign section_width = section.settings.section_width | default: 'full'
  assign image_shape = section.settings.image_shape | default: 'circle'
  assign mobile_layout = section.settings.mobile_layout | default: 'grid'
  assign editorial_label_position = section.settings.editorial_label_position | default: 'below'
  assign card_background = 'var(--sp-section-card, var(--sp-color-card, #FFFFFF))'
  if section.settings.card_background == 'transparent'
    assign card_background = 'transparent'
  elsif section.settings.card_background == 'surface'
    assign card_background = 'var(--sp-section-surface, var(--sp-color-surface, #F5F5F5))'
  endif
  assign card_border = '1px solid transparent'
  if section.settings.show_card_border
    assign card_border = '1px solid var(--sp-section-border, var(--sp-color-border, #E4E4E7))'
  endif
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign show_section_header = false
  if section.settings.show_heading and section.settings.heading != blank
    assign show_section_header = true
  elsif section.settings.show_description and section.settings.description != blank
    assign show_section_header = true
  endif
-%}

<section
  class="sp-section sp-collections-list sp-collections-list--style-{{ collection_style }} sp-collections-list--shape-{{ image_shape }} sp-collections-list--mobile-{{ mobile_layout }} sp-collections-list--editorial-{{ editorial_label_position }} sp-collections-list--hover-{{ section.settings.image_hover }}"
  data-section-id="{{ section.id }}"
  aria-label="{% if section.settings.show_heading and section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}Collection navigation{% endif %}"
  style="
    --sp-collections-cols-d: {{ section.settings.columns }};
    --sp-collections-cols-t: {{ section.settings.columns_tablet }};
    --sp-collections-cols-m: {{ section.settings.columns_mobile }};
    --sp-collections-image-d: {{ section.settings.image_size_desktop }}px;
    --sp-collections-image-t: {{ section.settings.image_size_desktop | times: 0.8 }}px;
    --sp-collections-image-m: {{ section.settings.image_size_mobile }}px;
    --sp-collections-image-compact-m: {{ section.settings.image_size_mobile | times: 0.8 }}px;
    --sp-collections-image-tile-m: {{ section.settings.image_size_mobile | times: 0.6 }}px;
    --sp-collections-image-position: {{ section.settings.image_position }};
    --sp-collections-image-compact-d: {{ section.settings.image_size_desktop | times: 0.72 }}px;
    --sp-collections-image-tile-d: {{ section.settings.image_size_desktop | times: 0.5 }}px;
    --sp-collections-gap-d: {{ section.settings.item_gap_desktop }}px;
    --sp-collections-gap-m: {{ section.settings.item_gap_mobile }}px;
    --sp-collections-label-gap: {{ section.settings.image_label_gap }}px;
    --sp-collections-max-width: {{ section.settings.content_max_width }}px;
    --sp-collections-radius: {{ section.settings.card_radius }}px;
    --sp-collections-card-bg: {{ card_background }};
    --sp-collections-card-border: {{ card_border }};
    --sp-collections-overlay-opacity: {{ overlay_opacity }};
    --sp-collections-pad-top: {{ section.settings.padding_top }}px;
    --sp-collections-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sp-collections-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --sp-collections-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --sp-collections-heading-gap: {{ section.settings.heading_gap }}px;
  "
>
  <div class="sp-collections-list__container sp-collections-list__container--{{ section_width }}">
    {% if show_section_header %}
      <header class="sp-collections-list__header sp-collections-list__header--{{ section.settings.heading_alignment }}">
        {% if section.settings.show_heading and section.settings.heading != blank %}
          <h2 class="sp-collections-list__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.show_description and section.settings.description != blank %}
          <div class="sp-collections-list__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <ul class="sp-collections-list__items" role="list">
      {% for block in section.blocks %}
          {% liquid
            assign item_collection = block.settings.collection
            assign item_title = block.settings.custom_label
            if item_title == blank and item_collection != blank
              assign item_title = item_collection.title
            endif
            if item_title == blank
              assign item_title = 'Collection'
            endif

            assign item_image = block.settings.custom_image
            if item_image == blank and item_collection != blank
              assign item_image = item_collection.image
            endif
            if item_image == blank and item_collection != blank and item_collection.products.first.featured_media
              assign item_image = item_collection.products.first.featured_media.preview_image
            endif

            assign item_alt = block.settings.image_alt
            if item_alt == blank and item_image != blank and item_image.alt != blank
              assign item_alt = item_image.alt
            endif
            if item_alt == blank
              assign item_alt = item_title
            endif

            assign item_url = block.settings.custom_link
            if item_url == blank and item_collection != blank
              assign item_url = item_collection.url
            endif

            assign item_loading = 'lazy'
            if forloop.index <= section.settings.columns
              assign item_loading = 'eager'
            endif
          %}

          <li class="sp-collections-list__item" {% if block.settings.hide_item %}hidden{% endif %} {{ block.shopify_attributes }}>
            {% unless block.settings.hide_item %}
            {% if item_url != blank %}
              <a class="sp-collections-list__link" href="{{ item_url }}" aria-label="{{ item_title | escape }}">
            {% else %}
              <div class="sp-collections-list__link">
            {% endif %}
                <div class="sp-collections-list__media">
                  {% if item_image != blank %}
                    {% render 'responsive-image',
                      image: item_image,
                      widths: '96, 128, 160, 208, 256, 320, 420, 560',
                      sizes: '(min-width: 1600px) 256px, (min-width: 990px) 22vw, (min-width: 750px) 30vw, 50vw',
                      loading: item_loading,
                      class: 'sp-collections-list__image',
                      alt: item_alt
                    %}
                  {% else %}
                    {% render 'placeholder-image', name: 'collection-1', class: 'sp-collections-list__image sp-collections-list__placeholder' %}
                  {% endif %}
                </div>

                <span class="sp-collections-list__content">
                  <span class="sp-collections-list__label">{{ item_title | escape }}</span>
                  {% if section.settings.show_arrows and block.settings.show_arrow %}
                    <svg class="sp-collections-list__arrow" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                      <path d="M3.5 10h12M10.5 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% endif %}
                </span>
            {% if item_url != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
            {% endunless %}
          </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
