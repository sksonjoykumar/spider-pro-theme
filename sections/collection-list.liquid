          "value": "minimal",
          "label": "1. Minimal Circular Collections"
        },
        {
          "value": "compact",
          "label": "2. Compact Circular Navigation"
        },
        {
          "value": "cards",
          "label": "3. Premium Image Cards"
        },
        {
          "value": "editorial",
          "label": "4. Editorial Collection Grid"
        },
        {
          "value": "bordered",
          "label": "5. Modern Bordered Tiles"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "contained",
          "label": "Contained"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content maximum width",
      "min": 960,
      "max": 2400,
      "step": 80,
      "unit": "px",
      "default": 2400
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show section heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop collections"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_gap",
