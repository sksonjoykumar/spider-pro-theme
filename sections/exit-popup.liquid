{%- liquid
  assign page_type = request.page_type
  assign eligible = false

  case page_type
    when 'index'
      assign eligible = section.settings.show_home
    when 'product'
      assign eligible = section.settings.show_product
    when 'collection'
      assign eligible = section.settings.show_collection
    when 'blog'
      assign eligible = section.settings.show_blog
    when 'article'
      assign eligible = section.settings.show_article
    when 'cart'
      assign eligible = section.settings.show_cart
    when 'page'
      assign eligible = section.settings.show_other
    when 'search'
      if section.settings.exclude_search == false
        assign eligible = section.settings.show_other
      endif
    when '404'
      if section.settings.exclude_404 == false
        assign eligible = section.settings.show_other
      endif
    else
      if page_type contains 'customers'
        if section.settings.exclude_customer == false
          assign eligible = section.settings.show_other
        endif
      else
        assign eligible = section.settings.show_other
      endif
  endcase

  if request.design_mode
    assign eligible = true
  endif

  assign source_products = blank
  if section.settings.product_source == 'manual'
    assign source_products = section.settings.product_list
  elsif section.settings.product_source == 'collection'
    if section.settings.collection != blank
      assign source_products = section.settings.collection.products
    endif
  elsif section.settings.product_source == 'auto'
    if section.settings.product_list != blank
      assign source_products = section.settings.product_list
    elsif section.settings.collection != blank
      assign source_products = section.settings.collection.products
    endif
  endif

  assign product_count = 0
  if source_products != blank
    assign product_count = source_products.size | at_most: section.settings.product_limit
  endif

  assign has_products = false
  if product_count > 0 and section.settings.popup_layout != 'content_only' and section.settings.popup_layout != 'image_content' and section.settings.popup_layout != 'reference_split'
    assign has_products = true
  endif

  assign has_media = false
  if section.settings.enable_promo_image and section.settings.popup_layout != 'content_only' and section.settings.popup_layout != 'content_products'
    if section.settings.image != blank or section.settings.image_mobile != blank
      assign has_media = true
    endif
  endif

  assign dialog_id = 'SpExitPopup-' | append: section.id
  assign label_id = 'SpExitPopupLabel-' | append: section.id
  assign desc_id = 'SpExitPopupDesc-' | append: section.id
  assign backdrop_alpha = section.settings.backdrop_opacity | divided_by: 100.0

  # Premium UI presets provide strong defaults while retaining merchant overrides.
  assign resolved_bg = section.settings.popup_background
  assign resolved_heading = section.settings.heading_color
  assign resolved_text = section.settings.text_color
  assign resolved_link = section.settings.link_color
  assign resolved_border = section.settings.border_color
  assign resolved_products_bg = section.settings.products_background
  assign resolved_products_text = section.settings.products_text
  assign resolved_products_border = section.settings.products_border

  if section.settings.style_preset == 'dark_promotion'
    if resolved_bg == '#FFFFFF' or resolved_bg == '#ffffff'
      assign resolved_bg = '#1D1D1D'
    endif
    if resolved_heading == '#111111'
      assign resolved_heading = '#FFFFFF'
    endif
    if resolved_text == '#333333'
      assign resolved_text = '#C9C9C9'
    endif
    if resolved_link == '#111111'
      assign resolved_link = '#FFFFFF'
    endif
    if resolved_border == '#E5E5E5' or resolved_border == '#e5e5e5'
      assign resolved_border = '#454545'
    endif
    if resolved_products_bg == '#F8F8F8' or resolved_products_bg == '#f8f8f8'
      assign resolved_products_bg = '#252525'
    endif
    if resolved_products_text == '#222222'
      assign resolved_products_text = '#F4F4F4'
    endif
    if resolved_products_border == '#E8E8E8' or resolved_products_border == '#e8e8e8'
      assign resolved_products_border = '#3D3D3D'
    endif
  elsif section.settings.style_preset == 'accent_promotion'
    if resolved_bg == '#FFFFFF' or resolved_bg == '#ffffff'
      assign resolved_bg = '#10282D'
    endif
    if resolved_heading == '#111111'
      assign resolved_heading = '#FFFFFF'
    endif
    if resolved_text == '#333333'
      assign resolved_text = '#D7E5E7'
    endif
    if resolved_link == '#111111'
      assign resolved_link = '#FFFFFF'
    endif
    if resolved_border == '#E5E5E5' or resolved_border == '#e5e5e5'
      assign resolved_border = '#35545A'
    endif
  endif
-%}

{%- if eligible -%}
  {{ 'sp-exit-popup.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sp-exit-popup.js' | asset_url }}" defer></script>

  <sp-exit-popup
    class="sp-exit-popup sp-exit-popup--layout-{{ section.settings.popup_layout }} sp-exit-popup--preset-{{ section.settings.style_preset }} sp-exit-popup--discount-{{ section.settings.discount_style }} sp-exit-popup--cta-{{ section.settings.cta_width }}{% if section.settings.cta_full_mobile %} sp-exit-popup--cta-mobile-full{% endif %}{% if has_media %} has-media{% endif %}{% if section.settings.reference_image_side == 'right' %} sp-exit-popup--image-right{% endif %}{% unless section.settings.reference_show_mobile_image %} sp-exit-popup--hide-reference-mobile-image{% endunless %}{% if has_products %} has-products{% endif %}"
    data-section-id="{{ section.id }}"
    data-trigger="{{ section.settings.trigger }}"
    data-time-delay="{{ section.settings.time_delay }}"
    data-scroll-percent="{{ section.settings.scroll_percent }}"
    data-mobile-fallback="{{ section.settings.mobile_fallback }}"
    data-mobile-delay="{{ section.settings.mobile_delay }}"
    data-mobile-scroll-percent="{{ section.settings.mobile_scroll_percent }}"
    data-frequency="{{ section.settings.frequency }}"
    data-custom-days="{{ section.settings.custom_days }}"
    data-max-opens="{{ section.settings.max_opens_session }}"
    data-show-mobile="{{ section.settings.show_mobile }}"
    data-show-tablet="{{ section.settings.show_tablet }}"
    data-show-desktop="{{ section.settings.show_desktop }}"
    data-backdrop-close="{{ section.settings.backdrop_close }}"
    data-preview-editor="{{ section.settings.preview_editor }}"
    data-close-newsletter-success="{{ section.settings.close_newsletter_success }}"
    data-dismiss-discount-copy="{{ section.settings.dismiss_discount_copy }}"
    data-dismiss-cta="{{ section.settings.dismiss_cta }}"
    data-animation="{{ section.settings.animation }}"
    data-animation-duration="{{ section.settings.animation_duration }}"
    data-design-mode="{{ request.design_mode }}"
    style="
      --sp-exit-width: {{ section.settings.desktop_width }}px;
      --sp-exit-image-share: {{ section.settings.reference_image_share }}%;
      --sp-exit-reference-min-height: {{ section.settings.reference_min_height }}px;
      --sp-exit-reference-heading-d: {{ section.settings.reference_heading_desktop }}px;
      --sp-exit-reference-heading-m: {{ section.settings.reference_heading_mobile }}px;
      --sp-exit-reference-description-d: {{ section.settings.reference_description_desktop }}px;
      --sp-exit-reference-image-height-m: {{ section.settings.reference_mobile_image_height }}px;
      --sp-exit-reference-gold: {{ section.settings.reference_gold_color }};
      --sp-exit-reference-form-bg: {{ section.settings.reference_button_color }};
      --sp-exit-reference-badge-size: {{ section.settings.promo_badge_size }}px;
      --sp-exit-reference-badge-bg: {{ section.settings.promo_badge_background }};
      --sp-exit-reference-badge-fg: {{ section.settings.promo_badge_text_color }};
      --sp-exit-reference-image-shade: {{ section.settings.promo_image_overlay | divided_by: 100.0 }};
      --sp-exit-width-no-products: {{ section.settings.no_products_width }}px;
      --sp-exit-max-height: {{ section.settings.max_height }}dvh;
      --sp-exit-radius-d: {{ section.settings.radius_d }}px;
      --sp-exit-radius-t: {{ section.settings.radius_t }}px;
      --sp-exit-radius-m: {{ section.settings.radius_m }}px;
      --sp-exit-content-pad-y-d: {{ section.settings.content_pad_y_d }}px;
      --sp-exit-content-pad-x-d: {{ section.settings.content_pad_x_d }}px;
      --sp-exit-content-pad-y-t: {{ section.settings.content_pad_y_t }}px;
      --sp-exit-content-pad-x-t: {{ section.settings.content_pad_x_t }}px;
      --sp-exit-content-pad-y-m: {{ section.settings.content_pad_y_m }}px;
      --sp-exit-content-pad-x-m: {{ section.settings.content_pad_x_m }}px;
      --sp-exit-bg: {{ resolved_bg }};
      --sp-exit-heading: {{ resolved_heading }};
      --sp-exit-text: {{ resolved_text }};
      --sp-exit-link: {{ resolved_link }};
      --sp-exit-border: {{ resolved_border }};
      --sp-exit-products-bg: {{ resolved_products_bg }};
      --sp-exit-products-text: {{ resolved_products_text }};
      --sp-exit-products-border: {{ resolved_products_border }};
      --sp-exit-backdrop-bg: {{ section.settings.backdrop_color | color_modify: 'alpha', backdrop_alpha }};
      --sp-exit-backdrop-blur: {{ section.settings.backdrop_blur }}px;
      --sp-exit-animation-duration: {{ section.settings.animation_duration }}ms;
      --sp-exit-content-max: {{ section.settings.content_max_width }}px;
      --sp-exit-heading-max: {{ section.settings.heading_max_width }}px;
      --sp-exit-copy-max: {{ section.settings.copy_max_width }}px;
      --sp-exit-close-size: {{ section.settings.close_size }}px;
      --sp-exit-cta-min-width: {{ section.settings.cta_min_width }}px;
      --sp-exit-cta-height: {{ section.settings.cta_height }}px;
      --sp-exit-cta-bg: {{ section.settings.cta_background }};
      --sp-exit-cta-text: {{ section.settings.cta_text }};
      --sp-exit-cta-border: {{ section.settings.cta_border }};
      --sp-exit-cta-hover-bg: {{ section.settings.cta_hover_background }};
      --sp-exit-cta-hover-text: {{ section.settings.cta_hover_text }};
      --sp-exit-surface-muted: {{ section.settings.surface_muted }};
      --sp-exit-discount-radius: {{ section.settings.discount_radius }}px;
      --sp-exit-product-ratio: {% case section.settings.product_ratio %}{% when 'square' %}1 / 1{% when 'portrait' %}2 / 3{% when 'four_five' %}4 / 5{% when 'landscape' %}4 / 3{% when 'custom' %}{{ section.settings.custom_ratio_w }} / {{ section.settings.custom_ratio_h }}{% else %}auto{% endcase %};
    "
  >
    <dialog
      id="{{ dialog_id }}"
      class="sp-exit-popup__dialog sp-exit-popup__dialog--{{ section.settings.shadow }} sp-exit-popup__dialog--desktop-{{ section.settings.desktop_layout }} sp-exit-popup__dialog--mobile-{{ section.settings.mobile_layout }}"
      data-sp-exit-popup-dialog
      aria-labelledby="{{ label_id }}"
      aria-describedby="{{ desc_id }}"
    >
      <span id="{{ label_id }}" class="visually-hidden">{{ section.settings.accessible_label | default: 'Special offer' | escape }}</span>
      <span id="{{ desc_id }}" class="visually-hidden">{{ section.settings.accessible_description | default: 'Promotional popup' | escape }}</span>

      {%- if section.settings.show_close_button -%}
        <button
          type="button"
          class="sp-exit-popup__close sp-exit-popup__close--{{ section.settings.close_position }} sp-exit-popup__close--style-{{ section.settings.close_style }}"
          data-sp-exit-popup-close
          aria-label="Close popup"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      {%- endif -%}

      <div class="sp-exit-popup__scroll" data-sp-exit-popup-scroll>
        <div class="sp-exit-popup__layout">
          <div class="sp-exit-popup__primary{% if section.settings.popup_layout == 'reference_split' %} sp-exit-popup__primary--reference{% endif %}">
            {%- if has_media -%}
              {% render 'sp-exit-popup-media', section: section %}
            {%- endif -%}

            <div class="sp-exit-popup__content sp-exit-popup__content--{{ section.settings.content_align_d }} sp-exit-popup__content--mobile-{{ section.settings.content_align_m }} sp-exit-popup__content--v-{{ section.settings.content_vertical }}">
              {% render 'sp-exit-popup-content', section: section %}
            </div>
          </div>

          {%- if has_products -%}
            {% render 'sp-exit-popup-products', section: section, products: source_products, product_count: product_count %}
          {%- endif -%}
        </div>
      </div>
    </dialog>
  </sp-exit-popup>
{%- endif -%}

{% schema %}
{
  "name": "Exit popup",
  "class": "sp-system-exit-popup",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "custom.system"
    ]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "GENERAL"
    },
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible label",
      "default": "Special offer"
    },
    {
      "type": "text",
      "id": "accessible_description",
      "label": "Accessible description",
      "default": "Promotional popup"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "select",
      "id": "close_position",
      "label": "Close button position",
      "default": "right",
