      "min": -1,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Custom tab colors"
    },
    {
      "type": "checkbox",
      "id": "custom_tab_colors",
      "label": "Use custom tab colors",
      "default": false
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab color",
      "default": "#36c8dc"
    },
    {
      "type": "color",
      "id": "tab_inactive_color",
      "label": "Inactive tab color",
      "default": "#737373"
    },
    {
      "type": "color",
      "id": "tab_hover_color",
      "label": "Hover tab color",
      "default": "#171717"
    },
    {
