{%- assign sp_fit_axes = 'height,chest,waist,hips,inseam,shoulder' | split: ',' -%}
{%- comment -%}
  Spider Size Guide & Fit Finder: no external requests, no measurement storage.
  All recommendations require a merchant-approved rule configuration.
{%- endcomment -%}
{%- liquid
  assign fit_product = product
  if fit_product == blank
    assign fit_product = section.settings.selected_product
  endif
  assign sp_fit_preview = request.design_mode
  assign sp_fit_usable = section.settings.approve_size_rules
  if request.design_mode and section.settings.editor_preview_demo
    assign sp_fit_usable = true
  endif
-%}
{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-size-guide-fit-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-size-guide-fit-finder.js' | asset_url }}" defer="defer"></script>
<section id="SpSizeFit-{{ section.id }}" class="sp-fit sp-fit--{{ section.settings.layout_style }} sp-fit--chart-{{ section.settings.side_position }} sp-fit--image-{{ section.settings.image_position_desktop }} sp-fit--modal-{{ section.settings.modal_style }}" data-sp-fit-root data-sp-section-id="{{ section.id }}" data-sp-layout="{{ section.settings.layout_style }}" data-sp-accordion-mode="{{ section.settings.accordion_mode }}" data-sp-approved="{{ sp_fit_usable }}" data-sp-unit="{{ section.settings.unit_default }}" data-sp-remember-unit="{{ section.settings.remember_unit_preference }}" data-sp-enabled="{{ section.settings.enable_size_finder }}" style="--sp-fit-width:{{ section.settings.section_max_width }}px;--sp-fit-radius:{{ section.settings.card_border_radius }}px;--sp-fit-pad-d:{{ section.settings.card_padding_desktop }}px;--sp-fit-pad-m:{{ section.settings.card_padding_mobile }}px;--sp-fit-gap:{{ section.settings.content_gap_desktop }}px;--sp-fit-field-gap:{{ section.settings.form_field_gap }}px;--sp-fit-p-top:{{ section.settings.padding_top }}px;--sp-fit-p-bottom:{{ section.settings.padding_bottom }}px;--sp-fit-t-top:{{ section.settings.padding_top_tablet }}px;--sp-fit-t-bottom:{{ section.settings.padding_bottom_tablet }}px;--sp-fit-m-top:{{ section.settings.padding_top_mobile }}px;--sp-fit-m-bottom:{{ section.settings.padding_bottom_mobile }}px;--sp-fit-header-gap:{{ section.settings.header_bottom_spacing }}px;--sp-fit-illustration-width:{{ section.settings.measurement_image_max_width }}px;">
  <div class="sp-container sp-fit__container">
    {% if section.settings.show_header %}<div class="sp-fit__header sp-fit__header--{{ section.settings.heading_alignment }}">
      {% if section.settings.eyebrow != blank %}<p class="sp-eyebrow sp-fit__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% render 'sp-section-heading', section: section, heading: section.settings.heading, subheading: section.settings.description, alignment: section.settings.heading_alignment, bottom_spacing: 0 %}
    </div>{% endif %}
    <div class="sp-fit__shell">
      {% if section.settings.layout_style == 'style_1' %}
        <div class="sp-fit__topbar">
          <div class="sp-fit__tabs" role="tablist" aria-label="Sizing tools">
            <button id="SpFitTabGuide-{{ section.id }}" type="button" role="tab" aria-controls="SpFitGuide-{{ section.id }}" aria-selected="{% if section.settings.default_active_panel == 'size_guide' %}true{% else %}false{% endif %}" tabindex="{% if section.settings.default_active_panel == 'size_guide' %}0{% else %}-1{% endif %}" data-sp-tab="size_guide">{{ section.settings.guide_label | escape }}</button>
            <button id="SpFitTabFinder-{{ section.id }}" type="button" role="tab" aria-controls="SpFitFinder-{{ section.id }}" aria-selected="{% if section.settings.default_active_panel == 'fit_finder' %}true{% else %}false{% endif %}" tabindex="{% if section.settings.default_active_panel == 'fit_finder' %}0{% else %}-1{% endif %}" data-sp-tab="fit_finder">{{ section.settings.finder_label | escape }}</button>
          </div>
          {% render 'sp-fit-unit-toggle', section: section %}
        </div>
        <div class="sp-fit__guide-panel" id="SpFitGuide-{{ section.id }}" role="tabpanel" aria-labelledby="SpFitTabGuide-{{ section.id }}" data-sp-panel="size_guide" {% if section.settings.default_active_panel != 'size_guide' %}hidden{% endif %}>
          {% render 'sp-size-guide-table', section: section %}
        </div>
        <div class="sp-fit__finder-panel" id="SpFitFinder-{{ section.id }}" role="tabpanel" aria-labelledby="SpFitTabFinder-{{ section.id }}" data-sp-panel="fit_finder" {% if section.settings.default_active_panel != 'fit_finder' %}hidden{% endif %}>
          {% render 'sp-fit-illustration', section: section %}
          {% render 'sp-fit-finder-form', section: section %}
        </div>
      {% elsif section.settings.layout_style == 'style_2' %}
        <div class="sp-fit__topbar sp-fit__topbar--units">{% render 'sp-fit-unit-toggle', section: section %}</div>
        <div class="sp-fit__side-grid"><div>{% render 'sp-size-guide-table', section: section %}</div><div>{% render 'sp-fit-finder-form', section: section %}</div></div>
      {% elsif section.settings.layout_style == 'style_3' %}
        <div class="sp-fit__topbar sp-fit__topbar--units">{% render 'sp-fit-unit-toggle', section: section %}</div>
        <div class="sp-fit__wizard-shell">{% render 'sp-fit-finder-form', section: section %}<details class="sp-fit__chart-details" data-sp-guide-details><summary>View full size chart</summary>{% render 'sp-size-guide-table', section: section %}</details></div>
      {% elsif section.settings.layout_style == 'style_4' %}
        <div class="sp-fit__launchers"><p>Choose your best size with our sizing tools.</p><div><button type="button" class="sp-button sp-button--secondary" data-sp-launch="size_guide">View size guide</button><button type="button" class="sp-button sp-button--primary" data-sp-launch="fit_finder">Find my size</button></div></div>
        <dialog class="sp-fit__dialog" data-sp-dialog aria-label="Size guide and fit finder"><div class="sp-fit__dialog-header"><strong>Size guide & Fit finder</strong><button type="button" class="sp-fit__close" data-sp-dialog-close aria-label="Close size guide">✕</button></div><div class="sp-fit__topbar sp-fit__topbar--units">{% render 'sp-fit-unit-toggle', section: section %}</div><div class="sp-fit__dialog-view" data-sp-dialog-view="size_guide">{% render 'sp-size-guide-table', section: section %}</div><div class="sp-fit__dialog-view" data-sp-dialog-view="fit_finder">{% render 'sp-fit-finder-form', section: section %}</div></dialog>
      {% else %}
        <div class="sp-fit__topbar sp-fit__topbar--units">{% render 'sp-fit-unit-toggle', section: section %}</div>
        <div class="sp-fit__accordions">
          <details data-sp-accordion><summary>How to measure</summary><div class="sp-fit__instructions">{% render 'sp-fit-instructions', section: section %}</div></details>
          <details data-sp-accordion><summary>Size chart</summary>{% render 'sp-size-guide-table', section: section %}</details>
          <details data-sp-accordion open><summary>Find my size</summary>{% render 'sp-fit-finder-form', section: section %}</details>
          <details data-sp-accordion><summary>Fit information</summary><p>Use the provided body ranges as a guide. Slim fits closer to the body, while relaxed may select the next configured size.</p></details>
        </div>
      {% endif %}
    </div>
  </div>
  <script type="application/json" data-sp-fit-config>{
    "approved": {{ sp_fit_usable | json }},
    "basis": {{ section.settings.measurement_basis | json }},
    "sizeScope": {{ section.settings.size_scope | json }},
    "scopeProductId": {{ section.settings.selected_product.id | json }},
    "designMode": {{ request.design_mode | json }},
    "productId": {{ fit_product.id | json }},
    "productOptions": {% if fit_product != blank %}{{ fit_product.options | json }}{% else %}[]{% endif %},
    "selectedVariantId": {{ fit_product.selected_or_first_available_variant.id | json }},
    "enableVariantMatch": {{ section.settings.enable_variant_matching | json }},
    "enableVariantSelection": {{ section.settings.enable_variant_selection | json }},
    "sizeOption": {{ section.settings.size_option_name | json }},
    "noMatchText": {{ section.settings.no_match_text | json }},
    "supportLink": {{ section.settings.support_link | json }},
    "fieldRequired": { {% for axis in sp_fit_axes %}{{ axis | json }}:{% assign required_key = 'required_' | append: axis %}{{ section.settings[required_key] | json }}{% unless forloop.last %},{% endunless %}{% endfor %} },
    "variants": [{% if fit_product != blank %}{% for variant in fit_product.variants limit: 100 %}{"id":{{ variant.id | json }},"available":{{ variant.available | json }},"options":{{ variant.options | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],
    "rules": [{% assign first_rule = true %}{% for block in section.blocks %}{% if block.type == 'size_rule' and block.settings.size_label != blank %}{% unless first_rule %},{% endunless %}{% assign first_rule = false %}{"id":{{ block.id | json }},"label":{{ block.settings.size_label | json }},"aliases":{{ block.settings.size_aliases | json }},"order":{{ block.settings.display_order | json }},"note":{{ block.settings.fit_note | json }},"ranges":{ {% for axis in sp_fit_axes %}{% assign min_key = axis | append: '_min_cm' %}{% assign max_key = axis | append: '_max_cm' %}{{ axis | json }}:[{{ block.settings[min_key] | json }},{{ block.settings[max_key] | json }}]{% unless forloop.last %},{% endunless %}{% endfor %} }}{% endif %}{% endfor %}]
  }</script>
</section>
{% schema %}
{
  "name": "Size Guide & Fit Finder",
  "tag": "section",
  "class": "sp-size-guide-section",
    "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
