      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_bottom_spacing",
      "label": "Header bottom spacing",
      "min": 8,
      "max": 96,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout Style"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Section layout",
