          "value": "style_2",
          "label": "Side-by-side Guide"
        },
        {
          "value": "style_3",
          "label": "Step-by-step Wizard"
        },
        {
          "value": "style_4",
          "label": "Compact Modal Launcher"
        },
        {
          "value": "style_5",
          "label": "Accordion Assistant"
        }
      ],
      "default": "style_1"
    },
    {
      "type": "select",
      "id": "side_position",
      "label": "Side-by-side chart position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
