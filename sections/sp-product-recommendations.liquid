{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-product-recommendations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-product-recommendations.js' | asset_url }}" defer></script>

{%- liquid
  assign sp_has_results = false
  if recommendations.performed? and recommendations.products_count > 0
    assign sp_has_results = true
  endif

  assign sp_product_design = blank
  unless section.settings.use_global_product_settings
    assign sp_product_design = section.settings.product_style
  endunless

  assign sp_container_choice = section.settings.container_width | default: 'theme'
  assign sp_container_class = 'sp-container'
  assign sp_is_full = false

  case sp_container_choice
    when 'full'
      assign sp_container_class = 'sp-product-recommendations__container--full'
      assign sp_is_full = true
    when 'wide'
      assign sp_container_class = 'sp-container sp-container--wide'
    when 'narrow'
      assign sp_container_class = 'sp-container sp-container--narrow'
    when 'boxed'
      assign sp_container_class = 'sp-container'
    else
      if settings.sp_layout_style == 'full'
        assign sp_container_class = 'sp-product-recommendations__container--full'
        assign sp_is_full = true
      else
        assign sp_container_class = 'sp-container'
      endif
  endcase

  assign sp_heading_style = section.settings.heading_style | default: 'h2'
  assign sp_heading_tag = sp_heading_style
  assign sp_typography_source = 'global'
  if sp_heading_style == 'custom'
    assign sp_heading_tag = 'h2'
    assign sp_typography_source = 'custom'
  endif
  assign sp_subheading = section.settings.subheading | escape

  assign sp_cols_d = section.settings.columns_desktop | default: 4
  assign sp_cols_t = section.settings.columns_tablet | default: 3
  assign sp_cols_m = section.settings.columns_mobile | default: 2

  assign sp_gap_d = settings.product_grid_gap | default: 24
  assign sp_gap_t = settings.product_grid_gap | default: 24
  assign sp_gap_m = settings.mobile_grid_gap | default: 16
  unless section.settings.use_theme_gap
    assign sp_gap_d = section.settings.gap_desktop
    assign sp_gap_t = section.settings.gap_tablet
    assign sp_gap_m = section.settings.gap_mobile
  endunless

  assign sp_max_width = settings.sp_container_width | default: 1280
  case sp_container_choice
    when 'wide'
      assign sp_max_width = settings.sp_wide_width | default: 1600
    when 'narrow'
      assign sp_max_width = settings.sp_narrow_width | default: 800
  endcase
  if sp_container_choice == 'theme' and settings.sp_layout_style == 'full'
    assign sp_is_full = true
  endif

  capture sp_sizes
    if sp_is_full
      echo '(min-width: 990px) calc((100vw - 64px) / '
      echo sp_cols_d
      echo '), (min-width: 750px) calc((100vw - 48px) / '
      echo sp_cols_t
      echo '), calc((100vw - 32px) / '
      echo sp_cols_m
      echo ')'
    else
      echo '(min-width: 990px) calc(min('
      echo sp_max_width
      echo 'px, calc(100vw - 64px)) / '
      echo sp_cols_d
      echo '), (min-width: 750px) calc((100vw - 48px) / '
      echo sp_cols_t
      echo '), calc((100vw - 32px) / '
      echo sp_cols_m
      echo ')'
    endif
  endcapture

  assign sp_autoplay_ms = section.settings.autoplay_speed | default: 5 | times: 1000
  assign sp_spacing_source = section.settings.spacing_source | default: 'theme'
-%}

<sp-product-recommendations
  id="SpiderProductRecommendations-{{ section.id }}"
  class="sp-product-recommendations sp-product-section{% if sp_spacing_source == 'theme' %} sp-product-recommendations--theme-spacing{% else %} sp-product-recommendations--custom-spacing{% endif %}"
  data-sp-product-recommendations
  data-sp-product-section
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-recommendations-url="{{ routes.product_recommendations_url }}"
  data-limit="{{ section.settings.products_to_show }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-performed="{{ recommendations.performed? }}"
  data-has-results="{{ sp_has_results }}"
  data-layout="{{ section.settings.layout }}"
  data-design-mode="{{ request.design_mode }}"
  data-money-format="{{ shop.money_with_currency_format | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-compare-max="4"
  data-buy-now="{{ settings.dynamic_checkout }}"
  data-swatch-color-map-json=""
  aria-busy="{% if recommendations.performed? %}false{% else %}true{% endif %}"
  aria-label="{{ section.settings.heading | default: 'You may also like' | escape }}"
  style="
    --sp-rec-cols-d: {{ sp_cols_d }};
    --sp-rec-cols-t: {{ sp_cols_t }};
    --sp-rec-cols-m: {{ sp_cols_m }};
    --sp-rec-gap-d: {{ sp_gap_d }}px;
    --sp-rec-gap-t: {{ sp_gap_t }}px;
    --sp-rec-gap-m: {{ sp_gap_m }}px;
    --sp-rec-pt-d: {{ section.settings.padding_top_desktop }}px;
    --sp-rec-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --sp-rec-pt-t: {{ section.settings.padding_top_tablet }}px;
    --sp-rec-pb-t: {{ section.settings.padding_bottom_tablet }}px;
    --sp-rec-pt-m: {{ section.settings.padding_top_mobile }}px;
    --sp-rec-pb-m: {{ section.settings.padding_bottom_mobile }}px;
  "
  {% unless sp_has_results or request.design_mode %}hidden{% endunless %}
>
  <div class="{{ sp_container_class }} sp-product-recommendations__container" data-sp-recommendations-content>
    {%- if sp_has_results -%}
      {% render 'sp-section-heading',
        heading: section.settings.heading,
        subheading: sp_subheading,
        heading_tag: sp_heading_tag,
        design: section.settings.heading_design,
        alignment: section.settings.heading_alignment,
        mobile_alignment: section.settings.heading_alignment,
        heading_gap: section.settings.heading_gap,
        bottom_spacing: section.settings.heading_bottom_spacing,
        typography_source: sp_typography_source,
        heading_size_desktop: section.settings.heading_size_desktop,
        heading_size_tablet: section.settings.heading_size_tablet,
        heading_size_mobile: section.settings.heading_size_mobile,
        heading_weight: section.settings.heading_weight,
        heading_line_height: section.settings.heading_line_height,
        heading_letter_spacing: section.settings.heading_letter_spacing,
        subheading_size: section.settings.subheading_size
      %}

      {%- if section.settings.layout == 'grid' -%}
        <div class="sp-product-recommendations__grid" data-sp-recommendations-products>
          {%- assign sp_seen_ids = '|' -%}
          {%- for recommendation in recommendations.products limit: section.settings.products_to_show -%}
            {%- capture sp_token -%}|{{ recommendation.id }}|{%- endcapture -%}
            {%- unless recommendation.id == product.id or sp_seen_ids contains sp_token -%}
              {% render 'sp-product-card',
                product: recommendation,
                context: 'product-recommendations',
                design: sp_product_design,
                section_id: section.id,
                instance_id: 'recommendations',
                sizes: sp_sizes,
                product_index: forloop.index,
                section_index: section.index
              %}
              {%- assign sp_seen_ids = sp_seen_ids | append: sp_token -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div
          class="sp-product-recommendations__carousel sp-carousel-block"
          data-sp-recommendations-carousel
          data-loop="{{ section.settings.loop }}"
          data-autoplay="{{ section.settings.autoplay }}"
          data-autoplay-delay="{{ sp_autoplay_ms }}"
          data-pause-hover="{{ section.settings.pause_on_hover }}"
          data-drag="{{ section.settings.mouse_drag }}"
          data-outside-opacity="false"
          data-pagination-style="{{ section.settings.pagination_style }}"
          data-design-mode="{{ request.design_mode }}"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.heading | default: 'Recommended products' | escape }}"
        >
          <div class="sp-product-recommendations__viewport" data-sp-carousel-viewport tabindex="0">
            <div class="sp-product-recommendations__track" data-sp-carousel-track data-sp-recommendations-products>
              {%- assign sp_seen_ids = '|' -%}
              {%- for recommendation in recommendations.products limit: section.settings.products_to_show -%}
                {%- capture sp_token -%}|{{ recommendation.id }}|{%- endcapture -%}
                {%- unless recommendation.id == product.id or sp_seen_ids contains sp_token -%}
                  {% render 'sp-product-card',
                    product: recommendation,
                    context: 'product-recommendations',
                    design: sp_product_design,
                    section_id: section.id,
                    instance_id: 'recommendations',
                    sizes: sp_sizes,
                    product_index: forloop.index,
                    section_index: section.index
                  %}
                  {%- assign sp_seen_ids = sp_seen_ids | append: sp_token -%}
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.show_arrows -%}
            <div class="sp-product-recommendations__navigation" aria-label="Product recommendation navigation">
              <button class="sp-product-recommendations__arrow sp-product-recommendations__arrow--prev" type="button" data-sp-carousel-prev aria-label="Previous products">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="sp-product-recommendations__arrow sp-product-recommendations__arrow--next" type="button" data-sp-carousel-next aria-label="Next products">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          {%- endif -%}

          {%- if section.settings.show_dots or section.settings.autoplay -%}
            <div class="sp-product-recommendations__controls">
              {%- if section.settings.show_dots -%}<div class="sp-product-recommendations__pagination" data-sp-carousel-pagination aria-label="Recommendation pages"></div>{%- endif -%}
              {%- if section.settings.autoplay -%}
                <button class="sp-product-recommendations__pause" type="button" data-sp-carousel-pause aria-label="Pause autoplay" aria-pressed="false">
                  <span class="sp-product-recommendations__pause-icon" aria-hidden="true">Ⅱ</span>
                  <span class="visually-hidden">Pause autoplay</span>
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      {% render 'sp-section-heading',
        heading: section.settings.heading,
        subheading: sp_subheading,
        heading_tag: sp_heading_tag,
        design: section.settings.heading_design,
        alignment: section.settings.heading_alignment,
        mobile_alignment: section.settings.heading_alignment,
        heading_gap: section.settings.heading_gap,
        bottom_spacing: section.settings.heading_bottom_spacing,
        typography_source: sp_typography_source,
        heading_size_desktop: section.settings.heading_size_desktop,
        heading_size_tablet: section.settings.heading_size_tablet,
        heading_size_mobile: section.settings.heading_size_mobile,
        heading_weight: section.settings.heading_weight,
        heading_line_height: section.settings.heading_line_height,
        heading_letter_spacing: section.settings.heading_letter_spacing,
        subheading_size: section.settings.subheading_size
      %}
      <div class="sp-product-recommendations__editor-state" role="status" data-sp-recommendations-editor-state>
        {%- if recommendations.performed? -%}
          No {{ section.settings.recommendation_type }} product recommendations were returned for this product.
        {%- else -%}
          Product recommendations load automatically from Shopify for the current product.
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</sp-product-recommendations>

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "class": "sp-section-product-recommendations",
  "enabled_on": {
    "templates": [
      "product",
      "collection",
      "list-collections"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Recommendation type",
      "default": "related",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "complementary",
          "label": "Complementary products"
        }
      ]
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "use_global_product_settings",
      "label": "Use global Product Settings",
      "default": true,
      "info": "Uses Theme settings → Product Settings for the eight premium Product Card Styles and the shared Spider Product Card. Turn off only to override Product Design for this section."
    },
    {
      "type": "select",
      "id": "product_style",
      "label": "Product design override",
      "default": "01",
      "info": "Choose one of 8 Spider premium product card layouts; use Global Product Settings to inherit the global selection.",
      "options": [
        {
          "value": "01",
          "label": "01 — Classic Premium"
        },
        {
          "value": "02",
          "label": "02 — Modern Badges"
        },
        {
          "value": "03",
          "label": "03 — Variant Preview"
        },
        {
          "value": "04",
          "label": "04 — Image Overlay"
        },
        {
          "value": "05",
          "label": "05 — Apparel Swatches"
        },
        {
          "value": "06",
          "label": "06 — Stock Status"
        },
        {
          "value": "07",
          "label": "07 — Minimal Luxury"
        },
        {
          "value": "08",
          "label": "08 — Lifestyle Wide"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "carousel",
