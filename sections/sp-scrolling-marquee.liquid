{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'sp-scrolling-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-scrolling-marquee.js' | asset_url }}" defer></script>
{%- liquid
  assign sp_style = section.settings.layout_style
  assign sp_highlight_color = section.settings.highlight_color | downcase
  assign sp_first_row = true
  assign sp_second_row = false
  if sp_style == 'style_1'
    assign sp_first_row = section.settings.show_row_1
    assign sp_second_row = section.settings.show_row_2
  elsif sp_style == 'style_3'
    assign sp_first_row = false
    assign sp_second_row = true
  endif
  assign sp_media_only = false
  if sp_style == 'style_4'
    assign sp_media_only = true
  endif
-%}
<section class="sp-scrolling-marquee sp-scrolling-marquee--{{ sp_style }} sp-scrolling-marquee--{{ section.settings.section_width }}{% if section.settings.enable_edge_fade %} sp-scrolling-marquee--edge-fade{% endif %}{% if section.settings.logo_grayscale %} sp-scrolling-marquee--grayscale{% endif %}{% if section.settings.logo_hover_effect == 'none' %} sp-scrolling-marquee--no-logo-hover{% endif %}" id="sp-scrolling-marquee-{{ section.id }}" data-sp-scrolling-marquee data-sp-layout="{{ sp_style }}" data-sp-hover="{{ section.settings.pause_on_hover }}" data-sp-focus="{{ section.settings.pause_on_focus }}" data-sp-touch="{{ section.settings.pause_on_touch }}" data-sp-delay="{{ section.settings.resume_delay }}" data-sp-mobile-speed="{{ section.settings.mobile_speed_multiplier | divided_by: 100.0 }}" data-sp-auto-drag="{{ section.settings.drag_auto_advance }}" dir="{{ section.settings.direction_override | default: 'auto' }}" style="--sp-mq-pad-top:{{ section.settings.padding_top }}px;--sp-mq-pad-bottom:{{ section.settings.padding_bottom }}px;--sp-mq-pad-top-t:{{ section.settings.padding_top_tablet }}px;--sp-mq-pad-bottom-t:{{ section.settings.padding_bottom_tablet }}px;--sp-mq-pad-top-m:{{ section.settings.padding_top_mobile }}px;--sp-mq-pad-bottom-m:{{ section.settings.padding_bottom_mobile }}px;--sp-mq-header-gap:{{ section.settings.header_to_marquee_spacing }}px;--sp-mq-row-gap:{{ section.settings.row_gap }}px;--sp-mq-item-gap:{{ section.settings.item_gap }}px;--sp-mq-edge:{{ section.settings.edge_fade_width }}px;--sp-mq-icon-size:{{ section.settings.icon_size_desktop }}px;--sp-mq-icon-size-m:{{ section.settings.icon_size_mobile }}px;--sp-mq-image-width:{{ section.settings.image_width_desktop }}px;--sp-mq-image-width-m:{{ section.settings.image_width_mobile }}px;--sp-mq-image-height:{{ section.settings.image_height }}px;--sp-mq-logo-opacity:{{ section.settings.logo_opacity | divided_by: 100.0 }};--sp-mq-max-width:{{ section.settings.section_max_width }}px;--sp-mq-row-content-width:{{ section.settings.row_content_max_width }}px;--sp-mq-separator-size:{{ section.settings.separator_size }}px;--sp-mq-separator-gap:{{ section.settings.separator_spacing }}px;--sp-mq-header-max:{{ section.settings.header_max_width }}px;--sp-mq-header-align:{{ section.settings.heading_alignment }};--sp-mq-description-width:{{ section.settings.description_width }}px;--sp-mq-icon-fit:{{ section.settings.image_fit }};{% if sp_highlight_color != '#415dff' %}--sp-mq-highlight:{{ section.settings.highlight_color }};{% endif %}">
  {% if section.settings.show_header %}
    <div class="sp-scrolling-marquee__header sp-container">
      {% if section.settings.eyebrow != blank %}<p class="sp-scrolling-marquee__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% render 'sp-section-heading', heading_settings: section.settings, heading: section.settings.heading, subheading: section.settings.description, heading_tag: 'h2', heading_size_desktop: section.settings.heading_size, heading_size_tablet: section.settings.heading_size_tablet, heading_size_mobile: section.settings.heading_size_mobile, heading_alignment: section.settings.heading_alignment, alignment: section.settings.heading_alignment, mobile_alignment: section.settings.heading_alignment_mobile, typography_source: 'custom', heading_weight: 750, bottom_spacing: 0 %}
    </div>
  {% endif %}
  <div class="sp-scrolling-marquee__outer{% if section.settings.marquee_width == 'contained' %} sp-scrolling-marquee__outer--contained{% endif %}">
    {% if section.settings.pause_button and sp_style != 'style_5' %}
      <div class="sp-scrolling-marquee__controls"><button class="sp-scrolling-marquee__pause" data-sp-marquee-pause type="button" aria-pressed="false" aria-label="Pause marquee animation"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 5v14M17 5v14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg><span class="sp-scrolling-marquee__pause-label">Pause</span></button></div>
    {% endif %}
    {% for row_number in (1..2) %}
      {%- liquid
        assign sp_row_enabled = false
        assign sp_row_key = 'row_1'
        if row_number == 1
          assign sp_row_enabled = sp_first_row
        else
          assign sp_row_enabled = sp_second_row
          assign sp_row_key = 'row_2'
        endif
        assign sp_row_valid_count = 0
        for block in section.blocks
          if block.settings.row == sp_row_key
            assign sp_has_content = false
            if block.settings.item_type == 'logo' or block.settings.item_type == 'image'
              if block.settings.image != blank or request.design_mode
                assign sp_has_content = true
              endif
            elsif block.settings.text != blank or block.settings.heading != blank
              assign sp_has_content = true
            endif
            if sp_media_only
              unless block.settings.item_type == 'logo' or block.settings.item_type == 'image'
                assign sp_has_content = false
              endunless
            endif
            if sp_has_content
              assign sp_row_valid_count = sp_row_valid_count | plus: 1
            endif
          endif
        endfor
        if sp_row_valid_count == 0
          assign sp_row_enabled = false
        endif
      -%}
      {% if sp_row_enabled %}
        {%- if row_number == 1 -%}
          {%- assign sp_row_gap = section.settings.row_1_gap -%}
          {%- assign sp_row_speed = section.settings.row_1_speed -%}
          {%- assign sp_row_direction = section.settings.row_1_direction -%}
          {%- assign sp_row_height = section.settings.row_1_height -%}
          {%- assign sp_row_size = section.settings.row_1_text_size -%}
          {%- assign sp_row_weight = section.settings.row_1_text_weight -%}
          {%- assign sp_row_bg = section.settings.row_1_background -%}
          {%- assign sp_row_fg = section.settings.row_1_text_color -%}
          {%- assign sp_row_icon = section.settings.row_1_icon_color -%}
          {%- assign sp_row_border = section.settings.row_1_border_width -%}
        {%- else -%}
          {%- assign sp_row_gap = section.settings.row_2_gap -%}
          {%- assign sp_row_speed = section.settings.row_2_speed -%}
          {%- assign sp_row_direction = section.settings.row_2_direction -%}
          {%- assign sp_row_height = section.settings.row_2_height -%}
          {%- assign sp_row_size = section.settings.row_2_text_size -%}
          {%- assign sp_row_weight = section.settings.row_2_text_weight -%}
          {%- assign sp_row_bg = section.settings.row_2_background -%}
          {%- assign sp_row_fg = section.settings.row_2_text_color -%}
          {%- assign sp_row_icon = section.settings.row_2_icon_color -%}
          {%- assign sp_row_border = section.settings.row_2_border_width -%}
        {%- endif -%}
        <div class="sp-marquee-row sp-marquee-row--{{ sp_row_key }}{% if section.settings.use_row_custom_colors %} sp-marquee-row--custom-color{% endif %}" data-sp-marquee-row data-sp-direction="{{ sp_row_direction }}" data-sp-speed="{{ sp_row_speed }}" style="--sp-mq-row-gap:{{ sp_row_gap }}px;--sp-mq-row-height:{{ sp_row_height }}px;--sp-mq-row-size:{{ sp_row_size }}px;--sp-mq-row-weight:{{ sp_row_weight }};--sp-mq-row-bg-custom:{{ sp_row_bg }};--sp-mq-row-fg-custom:{{ sp_row_fg }};--sp-mq-row-icon-custom:{{ sp_row_icon }};--sp-mq-row-border:{{ sp_row_border }}px">
          <div class="sp-marquee-row__viewport" data-sp-marquee-viewport role="group" tabindex="{% if sp_style == 'style_5' %}0{% else %}-1{% endif %}" aria-label="{% if row_number == 1 %}Promotions{% else %}Shopping benefits{% endif %}">
            <div class="sp-marquee-row__track" data-sp-marquee-track>
              <ul class="sp-marquee-row__group" data-sp-marquee-original>
                {%- for block in section.blocks -%}
                  {%- if block.settings.row == sp_row_key -%}
                    {%- if sp_media_only -%}
                      {%- if block.settings.item_type == 'image' or block.settings.item_type == 'logo' -%}{% render 'sp-marquee-item', block: block, section: section, layout_style: sp_style %}{%- endif -%}
                    {%- else -%}{% render 'sp-marquee-item', block: block, section: section, layout_style: sp_style %}{%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          </div>
          {% if sp_style == 'style_5' and section.settings.drag_arrows %}
            <div class="sp-marquee-row__nav"><button type="button" data-sp-marquee-prev aria-label="Previous items"><span aria-hidden="true">←</span></button><button type="button" data-sp-marquee-next aria-label="Next items"><span aria-hidden="true">→</span></button></div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
    {% if section.blocks.size == 0 and request.design_mode %}<div class="sp-scrolling-marquee__empty">Add marquee items in the Theme Editor to display them here.</div>{% endif %}
    {% if sp_style == 'style_5' and section.settings.show_interaction_hint %}<p class="sp-scrolling-marquee__drag-hint">{{ section.settings.interaction_hint | escape }}</p>{% endif %}
    {% if sp_style == 'style_4' and request.design_mode %}<p class="sp-scrolling-marquee__editor-hint">Upload logo images into Row 1 blocks to populate this layout.</p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Scrolling Marquee",
  "tag": "section",
  "class": "sp-scrolling-marquee-section",
    "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Global styling"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Spider color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY SHOP WITH US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Reasons to Love Spider"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtful service and better essentials, from checkout to delivery.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "Mobile heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 30,
      "max": 80,
      "step": 2,
      "default": 54,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_tablet",
      "label": "Tablet heading size",
      "min": 26,
      "max": 60,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 22,
      "max": 46,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Header max width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 1100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_width",
      "label": "Description max width",
      "min": 400,
      "max": 1100,
      "step": 20,
      "default": 820,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout style"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "style_1",
          "label": "Double Opposite Marquee"
        },
        {
          "value": "style_2",
          "label": "Single Text Ticker"
        },
        {
          "value": "style_3",
          "label": "Icon Benefit Ribbon"
        },
        {
          "value": "style_4",
          "label": "Logo & Media Marquee"
        },
        {
          "value": "style_5",
          "label": "Interactive Drag Marquee"
        }
      ],
      "default": "style_1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "contained_header_full_width_rows",
          "label": "Contained header / full rows"
        },
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "contained",
          "label": "Contained"
        }
      ],
      "default": "contained_header_full_width_rows"
    },
    {
      "type": "select",
      "id": "marquee_width",
      "label": "Marquee rows width",
      "options": [
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "contained",
          "label": "Contained"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Maximum content width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "default": 1500,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_content_max_width",
      "label": "Static list max width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "default": 1500,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "direction_override",
      "label": "Text direction",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "ltr",
          "label": "Left-to-right"
        },
        {
          "value": "rtl",
          "label": "Right-to-left"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Row 1 – Promotions"
    },
    {
      "type": "checkbox",
      "id": "show_row_1",
      "label": "Show promotional row",
      "default": true
    },
    {
      "type": "select",
      "id": "row_1_direction",
      "label": "Movement direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "row_1_speed",
      "label": "Speed (px/s)",
      "min": 10,
      "max": 150,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_1_gap",
      "label": "Item gap",
      "min": 8,
      "max": 120,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_1_height",
      "label": "Minimum row height",
      "min": 48,
      "max": 180,
      "step": 4,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_1_text_size",
      "label": "Text size",
      "min": 14,
      "max": 48,
      "step": 1,
      "default": 27,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_1_text_weight",
      "label": "Font weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 800
    },
    {
      "type": "color",
      "id": "row_1_background",
      "label": "Row background",
      "default": "#415DFF"
    },
    {
      "type": "color",
      "id": "row_1_text_color",
      "label": "Row text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "row_1_icon_color",
      "label": "Separators and icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "row_1_border_width",
      "label": "Border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Row 2 – Benefits"
    },
    {
      "type": "checkbox",
      "id": "show_row_2",
      "label": "Show benefits row",
      "default": true
    },
    {
      "type": "select",
      "id": "row_2_direction",
      "label": "Movement direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "row_2_speed",
      "label": "Speed (px/s)",
      "min": 10,
      "max": 150,
      "step": 5,
      "default": 35,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_2_gap",
      "label": "Item gap",
      "min": 8,
      "max": 120,
      "step": 2,
      "default": 46,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_2_height",
      "label": "Minimum row height",
      "min": 48,
      "max": 180,
      "step": 4,
      "default": 112,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_2_text_size",
      "label": "Text size",
      "min": 14,
      "max": 48,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_2_text_weight",
      "label": "Font weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 800
    },
    {
      "type": "color",
      "id": "row_2_background",
      "label": "Row background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "row_2_text_color",
      "label": "Row text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "row_2_icon_color",
      "label": "Benefit icon color",
      "default": "#415DFF"
    },
    {
      "type": "range",
      "id": "row_2_border_width",
      "label": "Border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Speed / motion"
    },
    {
      "type": "select",
      "id": "speed_unit",
      "label": "Speed units",
      "options": [
        {
          "value": "px_per_second",
          "label": "Pixels per second"
        }
      ],
      "default": "px_per_second",
      "info": "Animation duration is calculated from the original row width."
    },
    {
      "type": "range",
      "id": "mobile_speed_multiplier",
      "label": "Mobile speed (%)",
      "min": 40,
      "max": 120,
      "step": 10,
      "default": 80,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_focus",
      "label": "Pause on keyboard focus",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_touch",
      "label": "Pause on touch",
      "default": true
    },
    {
      "type": "range",
      "id": "resume_delay",
      "label": "Resume delay (ms)",
      "min": 500,
      "max": 6000,
      "step": 100,
      "default": 3000,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "pause_button",
      "label": "Show accessible pause/play button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_interaction_hint",
      "label": "Show drag hint",
      "default": false
    },
    {
      "type": "text",
      "id": "interaction_hint",
      "label": "Drag hint",
      "default": "Drag or swipe to explore"
    },
    {
      "type": "header",
      "content": "Separators"
    },
    {
      "type": "checkbox",
      "id": "show_separators",
      "label": "Show separators",
      "default": true
    },
    {
      "type": "select",
      "id": "separator_type",
      "label": "Separator style",
      "options": [
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        },
        {
          "value": "line",
          "label": "Line"
        },
        {
          "value": "custom_icon",
          "label": "Uploaded icon"
        },
        {
          "value": "custom_text",
          "label": "Custom text"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "sparkle"
    },
    {
      "type": "image_picker",
      "id": "custom_separator_icon",
      "label": "Custom separator image"
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Custom separator text",
      "default": "•"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 12,
      "max": 48,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "separator_spacing",
      "label": "Separator spacing",
      "min": 8,
      "max": 64,
      "step": 2,
