{{ 'sp-footer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-footer.js' | asset_url }}" defer></script>
{% render 'sp-section-color-scheme', section: section %}
<footer id="SpFooter-{{ section.id }}" class="sp-pf{% unless section.settings.show_nav_dividers %} sp-pf--no-column-dividers{% endunless %}{% if section.settings.show_top_border %} sp-pf--top-border{% endif %}" data-sp-premium-footer data-section-id="{{ section.id }}" data-pf-initial-open="{{ section.settings.mobile_first_menu_open }}" data-pf-single-open="{{ section.settings.mobile_single_menu_open }}" style="--pf-max:{{ section.settings.max_width }}px;--pf-gap:{{ section.settings.nav_gap }}px;--pf-row-gap:{{ section.settings.section_row_gap }}px;--pf-mobile-row-gap:{{ section.settings.mobile_section_row_gap }}px;--pf-link-gap:{{ section.settings.menu_link_gap }}px;--pf-pt:{{ section.settings.padding_top }}px;--pf-pb:{{ section.settings.padding_bottom }}px;--pf-mobile-pt:{{ section.settings.mobile_padding_top }}px;--pf-mobile-pb:{{ section.settings.mobile_padding_bottom }}px;--pf-radius:{{ section.settings.card_radius }}px;--pf-mobile-menu-padding:{{ section.settings.mobile_menu_padding }}px;--pf-mobile-icon-size:{{ section.settings.mobile_icon_size }}px;--pf-mobile-icon-radius:{{ section.settings.mobile_icon_radius }}px;" {{ section.shopify_attributes }}>
  <div class="sp-pf__wrap">
    <div class="sp-pf__layout">
      {% content_for 'blocks' %}
    </div>
    {%- comment -%}
      Developer credit is owned by this Footer section, not a nested Theme Block.
      This guarantees that the section toggle renders once, even when merchants
      remove or reorder the copyright block in the Theme Editor.
    {%- endcomment -%}
    {% if section.settings.show_developer_credit and section.settings.developer_name != blank %}
      <div class="sp-pf__developer-credit" data-sp-pf-developer-credit>
        {% if section.settings.developer_label != blank %}<span class="sp-pf__developer-label">{{ section.settings.developer_label | escape }}</span>{% endif %}
        {% if section.settings.developer_url != blank %}
          <a href="{{ section.settings.developer_url | escape }}"{% if section.settings.developer_open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ section.settings.developer_name | escape }}</a>
        {% else %}
          <span class="sp-pf__developer-name">{{ section.settings.developer_name | escape }}</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "sp-premium-footer-section",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "sp-premium-footer-newsletter"
    },
    {
      "type": "sp-premium-footer-brand"
    },
    {
      "type": "sp-premium-footer-menu"
    },
    {
      "type": "sp-premium-footer-social-apps"
    },
    {
      "type": "sp-premium-footer-benefits"
    },
    {
      "type": "sp-premium-footer-copyright"
    },
    {
      "type": "sp-premium-footer-payments"
    },
    {
      "type": "sp-premium-footer-localization"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Spider theme palette"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Spider color scheme",
      "default": "scheme-3",
      "info": "Always uses the selected Spider global color scheme. Edit the scheme under Theme settings → Colors."
    },
    {
      "type": "header",
      "content": "Layout & spacing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "nav_gap",
      "label": "Desktop column gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_row_gap",
      "label": "Desktop section row gap",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_section_row_gap",
      "label": "Mobile section row gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "menu_link_gap",
      "label": "Navigation link spacing",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Rounded panel corners",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Footer appearance"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show separator above footer",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_nav_dividers",
      "label": "Show desktop column separators",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile navigation"
    },
    {
      "type": "select",
      "id": "mobile_accordion_icon",
      "label": "Accordion icon",
      "options": [
        {
          "value": "chevron",
          "label": "Minimal chevron"
        },
        {
          "value": "plus",
          "label": "Premium plus / minus"
        }
      ],
      "default": "plus"
    },
    {
      "type": "range",
      "id": "mobile_icon_size",
      "label": "Icon button size",
      "min": 28,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_icon_radius",
      "label": "Icon corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_menu_padding",
      "label": "Menu row vertical spacing",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "mobile_first_menu_open",
      "label": "Open first menu by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_single_menu_open",
      "label": "Only one mobile menu open",
      "default": true
    },
    {
      "type": "header",
      "content": "Developer credit"
    },
    {
      "type": "checkbox",
      "id": "show_developer_credit",
      "label": "Show developer credit",
      "default": false
    },
    {
      "type": "text",
      "id": "developer_label",
      "label": "Credit label",
      "default": "Developed by",
      "visible_if": "{{ section.settings.show_developer_credit }}"
    },
    {
      "type": "text",
      "id": "developer_name",
      "label": "Developer name",
      "visible_if": "{{ section.settings.show_developer_credit }}"
    },
    {
      "type": "url",
      "id": "developer_url",
      "label": "Developer website",
      "visible_if": "{{ section.settings.show_developer_credit }}"
    },
    {
      "type": "checkbox",
      "id": "developer_open_new_tab",
      "label": "Open developer link in new tab",
      "default": true,
      "visible_if": "{{ section.settings.show_developer_credit }}"
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "category": "Footer",
      "blocks": [
        {
          "type": "sp-premium-footer-newsletter"
        },
        {
          "type": "sp-premium-footer-brand"
        },
        {
          "type": "sp-premium-footer-menu",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "sp-premium-footer-menu",
          "settings": {
            "heading": "Support"
          }
        },
        {
          "type": "sp-premium-footer-menu",
          "settings": {
            "heading": "Company"
          }
        },
        {
          "type": "sp-premium-footer-menu",
          "settings": {
            "heading": "Policies"
          }
        },
        {
          "type": "sp-premium-footer-social-apps"
        },
        {
          "type": "sp-premium-footer-benefits",
          "blocks": [
            {
              "type": "sp-premium-footer-benefit",
              "settings": {
                "icon": "truck",
                "heading": "Free shipping",
                "description": "On qualifying orders"
              }
            },
            {
              "type": "sp-premium-footer-benefit",
              "settings": {
                "icon": "package",
                "heading": "Easy returns",
                "description": "See our return policy"
              }
            },
            {
              "type": "sp-premium-footer-benefit",
              "settings": {
                "icon": "shield",
                "heading": "Secure checkout",
                "description": "Shop with confidence"
              }
            },
            {
              "type": "sp-premium-footer-benefit",
              "settings": {
                "icon": "award",
                "heading": "Warranty support",
                "description": "See warranty terms"
              }
            }
          ]
        },
        {
          "type": "sp-premium-footer-copyright"
        },
        {
          "type": "sp-premium-footer-payments"
        },
        {
          "type": "sp-premium-footer-localization"
        }
      ]
    }
  ]
}
{% endschema %}
