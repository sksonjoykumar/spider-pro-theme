{{ 'sp-promotional-banner-cards.css' | asset_url | stylesheet_tag }}
{% render 'sp-section-color-scheme', section: section %}
{%- liquid
  assign container_class = 'sp-container'
  if section.settings.section_width == 'wide'
    assign container_class = 'sp-container sp-container--wide'
  elsif section.settings.section_width == 'full'
    assign container_class = 'sp-promo__container--full'
  endif
  assign featured_id = blank
  for promo in section.blocks
    if promo.type == 'promotion' and promo.settings.featured_banner and featured_id == blank
      assign featured_id = promo.id
    endif
  endfor
  if featured_id == blank
    assign featured_id = section.blocks.first.id
  endif
  assign render_featured_first = false
  if section.settings.layout_style == 'style_1' or section.settings.layout_style == 'style_5'
    assign render_featured_first = true
  endif
-%}
{% style %}
  #shopify-section-{{ section.id }} .sp-promo {
    --sp-promo-gap-d:{{ section.settings.grid_gap_desktop }}px;
    --sp-promo-gap-t:{{ section.settings.grid_gap_tablet }}px;
    --sp-promo-gap-m:{{ section.settings.grid_gap_mobile }}px;
    --sp-promo-height-d:{{ section.settings.card_min_height_desktop }}px;
    --sp-promo-max-width:{{ section.settings.section_max_width }}px;
    --sp-promo-height-t:{{ section.settings.card_min_height_tablet }}px;
    --sp-promo-height-m:{{ section.settings.card_min_height_mobile }}px;
    --sp-promo-padding-d:{{ section.settings.content_padding_desktop }}px;
    --sp-promo-padding-t:{{ section.settings.content_padding_tablet }}px;
    --sp-promo-padding-m:{{ section.settings.content_padding_mobile }}px;
    --sp-promo-radius:{{ section.settings.card_border_radius }}px;
    --sp-promo-border:{{ section.settings.card_border_width }}px;
    --sp-promo-border-color:{{ section.settings.card_border_color }};
    --sp-promo-surface:{{ section.settings.card_background }};
    --sp-promo-content-surface:{{ section.settings.content_background }};
    --sp-promo-shadow:{% if section.settings.card_shadow %}var(--sp-shadow-soft, 0 10px 25px rgba(0,0,0,.08)){% else %}none{% endif %};
    --sp-promo-columns-d:{{ section.settings.desktop_columns }};
    --sp-promo-columns-t:{{ section.settings.tablet_columns }};
    --sp-promo-columns-m:{{ section.settings.mobile_columns }};
    --sp-promo-featured-width:{{ section.settings.featured_card_width }}%;
    --sp-promo-head-max:{{ section.settings.header_max_width }}px;
    --sp-promo-heading-size:{{ section.settings.section_heading_size }}px;
    --sp-promo-card-heading-size:{{ section.settings.card_heading_size }}px;
    --sp-promo-compact-title:{{ section.settings.supporting_heading_size }}px;
    --sp-promo-body-size:{{ section.settings.description_size }}px;
    --sp-promo-eyebrow-size:{{ section.settings.eyebrow_size }}px;
    --sp-promo-button-size:{{ section.settings.button_size }}px;
    --sp-promo-card-gap:{{ section.settings.card_content_gap }}px;
    --sp-promo-padding-top-d:{{ section.settings.padding_top }}px;
    --sp-promo-padding-bottom-d:{{ section.settings.padding_bottom }}px;
    --sp-promo-padding-top-t:{{ section.settings.padding_top_tablet }}px;
    --sp-promo-padding-bottom-t:{{ section.settings.padding_bottom_tablet }}px;
    --sp-promo-padding-top-m:{{ section.settings.padding_top_mobile }}px;
    --sp-promo-padding-bottom-m:{{ section.settings.padding_bottom_mobile }}px;
    --sp-promo-slide-count-d:{{ section.settings.desktop_slides }};
    --sp-promo-slide-count-t:{{ section.settings.tablet_slides }};
    --sp-promo-slide-count-m:{{ section.settings.mobile_slides }};
  }
{% endstyle %}
<section class="sp-promo sp-promo--{{ section.settings.layout_style }} sp-promo--hover-{{ section.settings.hover_effect }} sp-promo--mobile-feature-{{ section.settings.mobile_featured_position }} sp-promo--desktop-feature-{{ section.settings.featured_card_position }} sp-promo--count-{{ section.blocks.size }} sp-promo--split-{{ section.settings.split_image_position }} sp-promo--mobile-split-{{ section.settings.split_mobile_order }} sp-promo--ratio-{{ section.settings.image_ratio }}{% if section.settings.partial_next_slide %} sp-promo--peek{% endif %}"
 data-sp-promo-section
 data-sp-promo-id="{{ section.id }}"
 data-sp-promo-layout="{{ section.settings.layout_style }}"
 data-sp-promo-autoplay="{{ section.settings.enable_autoplay }}"
 data-sp-promo-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}"
 data-sp-promo-loop="{{ section.settings.infinite_loop }}"
 data-sp-promo-drag="{{ section.settings.enable_pointer_drag }}"
 data-sp-promo-pause-hover="{{ section.settings.pause_on_hover }}"
 data-sp-promo-design-mode="{{ request.design_mode }}">
 <div class="{{ container_class }} sp-promo__inner">
  {%- if section.settings.show_header -%}
    <div class="sp-promo__header sp-promo__header--{{ section.settings.heading_alignment }}">
      {%- if section.settings.eyebrow != blank -%}<p class="sp-promo__section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- render 'sp-section-heading', heading: section.settings.heading, subheading: section.settings.description, heading_tag: 'h2', typography_source: 'global', alignment: section.settings.heading_alignment, bottom_spacing: 0 -%}
    </div>
  {%- endif -%}
  {% if section.settings.layout_style == 'style_4' and section.settings.show_arrows %}
    <div class="sp-promo__carousel-top">
      <button type="button" class="sp-promo__arrow" data-sp-promo-prev aria-label="Previous promotions" disabled><span aria-hidden="true">←</span></button>
      <button type="button" class="sp-promo__arrow" data-sp-promo-next aria-label="Next promotions"><span aria-hidden="true">→</span></button>
    </div>
  {% endif %}
  <div class="sp-promo__viewport" data-sp-promo-viewport {% if section.settings.layout_style == 'style_4' %}role="region" aria-roledescription="carousel" aria-label="{{ section.settings.heading | default: 'Promotional cards' | escape }}"{% endif %}>
   <div class="sp-promo__grid" data-sp-promo-track role="list">
     {%- if render_featured_first -%}
       {%- for block in section.blocks -%}
         {%- if block.id == featured_id -%}
           <div class="sp-promo__item sp-promo__item--featured" data-sp-promo-item role="listitem">
             {% render 'sp-promotional-banner-card', block: block, section: section, featured: true, forloop_index: forloop.index %}
           </div>
         {%- endif -%}
       {%- endfor -%}
     {%- endif -%}
     {%- for block in section.blocks -%}
       {%- unless render_featured_first and block.id == featured_id -%}
         <div class="sp-promo__item{% if block.id == featured_id and render_featured_first == false %} sp-promo__item--featured{% endif %}" data-sp-promo-item role="listitem">
           {% render 'sp-promotional-banner-card', block: block, section: section, featured: false, forloop_index: forloop.index %}
         </div>
       {%- endunless -%}
     {%- endfor -%}
   </div>
  </div>
  {%- if section.blocks.size == 0 and request.design_mode -%}
    <p class="sp-promo__empty">Add a promotional card block to get started.</p>
  {%- endif -%}
  {% if section.settings.layout_style == 'style_4' %}
   {% if section.settings.show_progress_bar %}<div class="sp-promo__progress" aria-hidden="true"><span data-sp-promo-progress></span></div>{% endif %}
   {% if section.settings.show_dots %}<div class="sp-promo__dots" data-sp-promo-dots aria-label="Carousel pages"></div>{% endif %}
  {% endif %}
 </div>
</section>
{% if section.settings.layout_style == 'style_4' %}<script src="{{ 'sp-promotional-banner-cards.js' | asset_url }}" defer></script>{% endif %}

