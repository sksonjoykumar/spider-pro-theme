{%- comment -%}
  Spider Countdown Campaign Banner. Merchant must enable verified offer to publish.
  Static copy remains accessible if JavaScript fails. Each section is self-contained.
{%- endcomment -%}
{%- liquid
  assign sp_show = section.settings.campaign_enabled
  if request.design_mode
    assign sp_show = true
  endif
  assign sp_s = section.settings
  assign sp_product = sp_s.featured_product
  if sp_product == blank and sp_s.featured_collection != blank
    assign sp_product = sp_s.featured_collection.products.first
  endif
  assign sp_variant = sp_product.selected_or_first_available_variant
  assign sp_campaign_image = sp_s.desktop_image
  if sp_s.layout_style == 'style_5' and sp_s.use_product_image and sp_product != blank and sp_s.product_image_override == blank
    assign sp_campaign_image = sp_product.featured_image
  elsif sp_s.layout_style == 'style_5' and sp_s.product_image_override != blank
    assign sp_campaign_image = sp_s.product_image_override
  endif
  assign sp_show_trust = sp_s.allow_trust_claims
  if request.design_mode
    assign sp_show_trust = true
  endif
  assign sp_has_start = false
  if sp_s.scheduled_start != blank
    assign sp_has_start = true
  endif
  assign sp_scheme_content = sp_s.content_color_scheme
  assign sp_scheme_media = sp_s.media_color_scheme
  assign sp_scheme_strip = sp_s.strip_color_scheme
  assign sp_scheme_expired = sp_s.expired_color_scheme
  if sp_s.inherit_panel_scheme
    assign sp_scheme_content = sp_s.sp_color_scheme
    assign sp_scheme_media = sp_s.sp_color_scheme
    assign sp_scheme_strip = sp_s.sp_color_scheme
    assign sp_scheme_expired = sp_s.sp_color_scheme
  endif
-%}
{%- if sp_show -%}
  {% render 'sp-section-color-scheme', section: section %}
  {{ 'sp-countdown-campaign-banner.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sp-countdown-campaign-banner.js' | asset_url }}" defer></script>
  <section
    id="sp-campaign-{{ section.id }}"
    class="sp-campaign sp-campaign--{{ sp_s.layout_style }}{% if sp_s.show_edge_accent %} sp-campaign--edge-accent{% endif %}{% if sp_s.show_media_angle %} sp-campaign--media-angle{% endif %}{% if sp_s.full_width %} sp-campaign--full{% endif %}{% if sp_s.mobile_media_first %} sp-campaign--mobile-media-first{% endif %}{% if sp_s.mobile_full_buttons %} sp-campaign--mobile-full-buttons{% endif %}{% if sp_s.enable_animations %} sp-campaign--animate{% endif %}"
    data-sp-campaign
    data-sp-design-mode="{{ request.design_mode }}"
    data-sp-enabled="{{ sp_s.enable_countdown }}"
    data-sp-mode="{{ sp_s.countdown_mode }}"
    data-sp-deadline="{{ sp_s.deadline | escape }}"
    data-sp-start="{{ sp_s.scheduled_start | escape }}"
    data-sp-before="{{ sp_s.prestart_behavior }}"
    data-sp-expiry="{{ sp_s.expiry_behavior }}"
    data-sp-zero-days="{{ sp_s.hide_zero_days }}"
    data-sp-leading-zero="{{ sp_s.leading_zero }}"
    data-sp-update="{{ sp_s.update_on_expire }}"
    data-sp-preview-days="{{ sp_s.preview_days }}"
    data-sp-preview-hours="{{ sp_s.preview_hours }}"
    data-sp-preview-minutes="{{ sp_s.preview_minutes }}"
    data-sp-preview-seconds="{{ sp_s.preview_seconds }}"
    data-sp-days-one="{{ sp_s.day_singular | escape }}"
    data-sp-days-many="{{ sp_s.days_label | escape }}"
    data-sp-hours-one="{{ sp_s.hour_singular | escape }}"
    data-sp-hours-many="{{ sp_s.hours_label | escape }}"
    data-sp-minutes-one="{{ sp_s.minute_singular | escape }}"
    data-sp-minutes-many="{{ sp_s.minutes_label | escape }}"
    data-sp-seconds-one="{{ sp_s.second_singular | escape }}"
    data-sp-seconds-many="{{ sp_s.seconds_label | escape }}"
    data-sp-copy-active-eyebrow="{{ sp_s.eyebrow | escape }}"
    data-sp-copy-active-heading="{{ sp_s.heading | escape }}"
    data-sp-copy-active-description="{{ sp_s.description | escape }}"
    data-sp-copy-upcoming-eyebrow="{{ sp_s.upcoming_eyebrow | escape }}"
    data-sp-copy-upcoming-heading="{{ sp_s.upcoming_heading | escape }}"
    data-sp-copy-upcoming-description="{{ sp_s.upcoming_description | escape }}"
    data-sp-copy-expired-eyebrow="{{ sp_s.expired_eyebrow | escape }}"
    data-sp-copy-expired-heading="{{ sp_s.expired_heading | escape }}"
    data-sp-copy-expired-description="{{ sp_s.expired_description | escape }}"
    data-sp-copy-error="{{ sp_s.invalid_date_message | escape }}"
    data-sp-accessible-prefix="{{ sp_s.countdown_accessibility_label | escape }}"
    data-sp-text-active-note="{{ sp_s.ending_note | escape }}"
    data-sp-text-before-note="{{ sp_s.upcoming_note | escape }}"
    data-sp-text-expired-note="{{ sp_s.expired_note | escape }}"
    data-sp-caption-active="{{ sp_s.image_badge_heading | escape }}"
    data-sp-caption-before="{{ sp_s.upcoming_image_badge | escape }}"
    data-sp-caption-expired="{{ sp_s.expired_image_badge | escape }}"
    data-sp-has-start="{{ sp_has_start }}"
    data-sp-state="{% if sp_has_start %}upcoming{% else %}active{% endif %}"
    style="--sp-campaign-accent-width:{{ sp_s.edge_accent_width }}px;--sp-campaign-copy-padding:{{ sp_s.copy_padding }}px;--sp-campaign-copy-padding-mobile:{{ sp_s.copy_padding_mobile }}px;--sp-campaign-mobile-trust-cols:{{ sp_s.mobile_trust_columns }};--sp-campaign-pad-top:{{ sp_s.padding_top }}px;--sp-campaign-pad-bottom:{{ sp_s.padding_bottom }}px;--sp-campaign-pad-mobile-top:{{ sp_s.mobile_padding_top }}px;--sp-campaign-pad-mobile-bottom:{{ sp_s.mobile_padding_bottom }}px;--sp-campaign-max:{{ sp_s.max_width }}px;--sp-campaign-radius:{{ sp_s.section_radius }}px;--sp-campaign-timer-radius:{{ sp_s.timer_radius }}px;--sp-campaign-timer-size:{{ sp_s.timer_size }}px;--sp-campaign-heading-size:{{ sp_s.heading_size }}px;--sp-campaign-content-share:{{ sp_s.content_ratio }}%;--sp-campaign-media-height:{{ sp_s.media_height_desktop }}px;--sp-campaign-media-height-mobile:{{ sp_s.media_height_mobile }}px;--sp-campaign-overlay:{{ sp_s.overlay_strength | divided_by: 100.0 }};--sp-campaign-pattern-opacity:{{ sp_s.pattern_opacity | divided_by: 100.0 }};--sp-campaign-content-align:{{ sp_s.content_align }};--sp-campaign-text-align:{{ sp_s.desktop_alignment }};--sp-campaign-mobile-text-align:{{ sp_s.mobile_alignment }};--sp-campaign-timer-align:{{ sp_s.timer_alignment }};--sp-campaign-media-object:{{ sp_s.image_fit }};--sp-campaign-media-position:{{ sp_s.image_position }};--sp-campaign-badge-position:{{ sp_s.image_badge_position }};--sp-campaign-overflow-shadow:{% if sp_s.shadow == 'strong' %}0 18px 55px #0002{% elsif sp_s.shadow == 'soft' %}0 10px 32px #0001{% else %}none{% endif %};"
    aria-label="{{ sp_s.section_accessibility_label | default: 'Limited time promotion' | escape }}"
  >
    {%- capture sp_content_style -%}--sp-cp-bg:{{ sp_scheme_content.settings.background | default: '#1b1d22' }};--sp-cp-text:{{ sp_scheme_content.settings.text | default: '#ffffff' }};--sp-cp-heading:{{ sp_scheme_content.settings.heading | default: '#ffffff' }};--sp-cp-accent:{{ sp_scheme_content.settings.accent | default: '#415dff' }};--sp-cp-muted:{{ sp_scheme_content.settings.muted | default: '#dadee9' }};{%- endcapture -%}
    {%- capture sp_media_style -%}--sp-mp-bg:{{ sp_scheme_media.settings.background | default: '#edeae5' }};--sp-mp-text:{{ sp_scheme_media.settings.text | default: '#171717' }};{%- endcapture -%}
    {%- capture sp_strip_style -%}--sp-st-bg:{{ sp_scheme_strip.settings.background | default: '#202328' }};--sp-st-color:{{ sp_scheme_strip.settings.text | default: '#ffffff' }};{%- endcapture -%}
    {%- capture sp_expired_style -%}--sp-ex-bg:{{ sp_scheme_expired.settings.background | default: '#252830' }};--sp-ex-text:{{ sp_scheme_expired.settings.text | default: '#ffffff' }};{%- endcapture -%}
    <div class="{% if sp_s.full_width %}sp-campaign__wrapper{% else %}sp-container sp-campaign__wrapper{% endif %}">
      <div class="sp-campaign__shell{% if sp_s.show_border %} sp-campaign__shell--bordered{% endif %}{% if sp_s.decorative_pattern %} sp-campaign__shell--pattern{% endif %}" style="{{ sp_expired_style }}">
        <div class="sp-campaign__main{% if sp_s.desktop_media_first %} sp-campaign__main--media-first{% endif %}">
          <div class="sp-campaign__copy" style="{{ sp_content_style }}">
            <div class="sp-campaign__copy-inner">
              {%- if sp_s.eyebrow != blank -%}<p class="sp-campaign__eyebrow" data-sp-copy="eyebrow">{% if sp_has_start %}{{ sp_s.upcoming_eyebrow | escape }}{% else %}{{ sp_s.eyebrow | escape }}{% endif %}</p>{%- endif -%}
              {%- if sp_s.show_promotional_badge and sp_s.promotional_badge != blank -%}
                <div class="sp-campaign__sale-badge" data-sp-offer-only>{{ sp_s.promotional_badge | escape }}</div>
              {%- endif -%}
              <h2 class="sp-campaign__heading" id="sp-campaign-heading-{{ section.id }}" data-sp-copy="heading">{% if sp_has_start %}{{ sp_s.upcoming_heading | escape }}{% else %}{{ sp_s.heading | escape }}{% endif %}</h2>
              <p class="sp-campaign__description" data-sp-copy="description">{% if sp_has_start %}{{ sp_s.upcoming_description | escape }}{% else %}{{ sp_s.description | escape }}{% endif %}</p>
              {%- if sp_s.enable_countdown -%}
                <div class="sp-campaign__clock sp-campaign__clock--{{ sp_s.timer_card_style }}{% if sp_s.show_timer_separators %} sp-campaign__clock--separators{% endif %}" data-sp-clock data-sp-show-days="{{ sp_s.show_days }}" data-sp-show-hours="{{ sp_s.show_hours }}" data-sp-show-minutes="{{ sp_s.show_minutes }}" data-sp-show-seconds="{{ sp_s.show_seconds }}" role="group" aria-label="{{ sp_s.countdown_accessibility_label | escape }}">
                  {%- render 'sp-countdown-timer', section: section -%}
                </div>
                <p class="sp-campaign__clock-fallback" data-sp-clock-fallback>{{ sp_s.static_deadline_note | escape }}</p>
                <p class="sp-campaign__sr-only" data-sp-clock-accessible aria-live="off">{{ sp_s.static_deadline_note | escape }}</p>
                {%- if request.design_mode -%}<p class="sp-campaign__admin-warning" data-sp-warning hidden>Set a valid deadline with timezone, such as 2026-12-31T23:59:59Z.</p>{%- endif -%}
              {%- endif -%}
              <div class="sp-campaign__actions{% if sp_s.cta_layout == 'stack' %} sp-campaign__actions--stack{% endif %}" data-sp-actions>
                {%- if sp_s.primary_label != blank and sp_s.primary_link != blank -%}
                  {%- assign sp_p_label = sp_s.primary_label | escape -%}
                  {%- render 'button', label: sp_p_label, href: sp_s.primary_link, style: sp_s.primary_button_style, class: 'sp-campaign__button sp-campaign__button--primary' -%}
                {%- elsif request.design_mode and sp_s.primary_label != blank -%}<span class="sp-button sp-button--secondary sp-campaign__button sp-campaign__button--primary" aria-disabled="true">{{ sp_s.primary_label | escape }}</span>{%- endif -%}
                {%- if sp_s.secondary_label != blank and sp_s.secondary_link != blank -%}
                  {%- assign sp_s_label = sp_s.secondary_label | escape -%}
                  {%- capture sp_new_target -%}{% if sp_s.secondary_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}{%- endcapture -%}
                  {%- render 'button', label: sp_s_label, href: sp_s.secondary_link, style: sp_s.secondary_button_style, class: 'sp-campaign__button sp-campaign__button--secondary', attributes: sp_new_target -%}
                {%- elsif request.design_mode and sp_s.secondary_label != blank -%}<span class="sp-button sp-button--outline sp-campaign__button sp-campaign__button--secondary" aria-disabled="true">{{ sp_s.secondary_label | escape }}</span>{%- endif -%}
                {%- if sp_s.expired_cta_label != blank and sp_s.expired_cta_link != blank -%}
                  <a href="{{ sp_s.expired_cta_link }}" class="sp-button sp-button--primary sp-campaign__expired-cta" data-sp-expired-action hidden>{{ sp_s.expired_cta_label | escape }}</a>
                {%- endif -%}
              </div>
              {%- if sp_s.ending_note != blank or sp_s.upcoming_note != blank -%}
                <p class="sp-campaign__ending" data-sp-note><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><span data-sp-note-value>{% if sp_has_start %}{{ sp_s.upcoming_note | escape }}{% else %}{{ sp_s.ending_note | escape }}{% endif %}</span></p>
              {%- endif -%}
              {%- if sp_s.legal_note != blank -%}<div class="sp-campaign__legal rte">{{ sp_s.legal_note }}</div>{%- endif -%}
            </div>
          </div>
          {%- unless sp_s.layout_style == 'style_3' -%}
            <div class="sp-campaign__media" style="{{ sp_media_style }}">
              {%- if sp_s.layout_style == 'style_5' and sp_product != blank -%}
                {%- if sp_campaign_image != blank -%}
                  <div class="sp-campaign__media-image">
                    {%- if sp_s.mobile_image != blank and sp_s.use_product_image == false -%}<picture><source media="(max-width: 749px)" srcset="{{ sp_s.mobile_image | image_url: width: 900 }}">{%- endif -%}
                    {%- render 'responsive-image', image: sp_campaign_image, widths: '320,480,640,750,900,1200,1600', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', class: 'sp-campaign__image', alt: sp_s.image_alt -%}
                    {%- if sp_s.mobile_image != blank and sp_s.use_product_image == false -%}</picture>{%- endif -%}
                  </div>
                {%- endif -%}
                <div class="sp-campaign__product-card">
                  {% if sp_s.show_product_vendor and sp_product.vendor != blank %}<p class="sp-campaign__product-vendor">{{ sp_product.vendor | escape }}</p>{% endif %}
                  <h3 class="sp-campaign__product-title">{{ sp_product.title | escape }}</h3>
                  {% if sp_s.show_product_price and sp_variant != blank %}<p class="sp-campaign__price">{{ sp_variant.price | money }}{% if sp_s.show_compare_price and sp_variant.compare_at_price > sp_variant.price %} <s>{{ sp_variant.compare_at_price | money }}</s>{% endif %}</p>{% endif %}
                  {% if sp_s.product_cta_label != blank %}<a class="sp-button sp-button--primary sp-campaign__product-link" href="{{ sp_product.url }}">{{ sp_s.product_cta_label | escape }}</a>{% endif %}
                </div>
              {%- else -%}
                {%- if sp_campaign_image != blank -%}
                  <picture>
                    {%- if sp_s.mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ sp_s.mobile_image | image_url: width: 750 }} 750w, {{ sp_s.mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw">{%- endif -%}
                    {%- render 'responsive-image', image: sp_campaign_image, widths: '320,480,640,750,900,1200,1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', class: 'sp-campaign__image', alt: sp_s.image_alt -%}
                  </picture>
                {%- elsif request.design_mode -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'sp-campaign__placeholder' }}
                {%- endif -%}
                {%- if sp_s.layout_style == 'style_5' and request.design_mode and sp_product == blank -%}
                  <div class="sp-campaign__product-card"><p class="sp-campaign__product-vendor">Shopify product spotlight</p><h3 class="sp-campaign__product-title">Select a product or collection</h3><p>Configure a real product to display its image, price, and product link.</p></div>
                {%- endif -%}
                {%- if sp_s.show_image_badge and sp_s.image_badge_heading != blank -%}
                  <div class="sp-campaign__image-badge" data-sp-image-badge data-sp-offer-only>
                    {% if sp_s.image_badge_eyebrow != blank %}<span>{{ sp_s.image_badge_eyebrow | escape }}</span>{% endif %}
                    <strong data-sp-image-badge-heading>{{ sp_s.image_badge_heading | escape }}</strong>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endunless -%}
        </div>
        {%- if sp_s.show_bottom_strip and sp_show_trust -%}
          <div class="sp-campaign__trust-strip" style="{{ sp_strip_style }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust_feature' -%}
                {%- if request.design_mode or sp_s.allow_trust_claims -%}
                  <div class="sp-campaign__trust-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 96 | image_tag: widths: '48,96', sizes: '42px', loading: 'lazy', class: 'sp-campaign__trust-image', alt: '' }}
                    {%- else -%}
                      {% render 'sp-countdown-icon', name: block.settings.icon %}
                    {%- endif -%}
                    <div class="sp-campaign__trust-copy">
                      {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.accessible_name | default: block.settings.heading | escape }}">{{ block.settings.heading | escape }}</a>{% else %}<strong>{{ block.settings.heading | escape }}</strong>{% endif %}
                      {% if block.settings.description != blank %}<span>{{ block.settings.description | escape }}</span>{% endif %}
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- assign sp_highlights_count = 0 -%}
        {%- for block in section.blocks -%}{% if block.type == 'highlight' %}{% assign sp_highlights_count = sp_highlights_count | plus: 1 %}{% endif %}{%- endfor -%}
        {%- if sp_highlights_count > 0 -%}
          <div class="sp-campaign__highlights">
            {% for block in section.blocks %}{% if block.type == 'highlight' %}<div class="sp-campaign__highlight" {{ block.shopify_attributes }}>
              {% render 'sp-countdown-icon', name: block.settings.icon %}<span>{{ block.settings.label | escape }}</span><strong>{{ block.settings.value | escape }}</strong>
              {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.label | escape }}: {{ block.settings.value | escape }}"></a>{% endif %}
            </div>{% endif %}{% endfor %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Countdown Campaign Banner",
  "tag": "section",
  "class": "sp-campaign-shopify-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Setup and colors"
    },
    {
      "type": "checkbox",
      "id": "campaign_enabled",
      "label": "Publish this campaign",
      "default": false,
      "info": "Disabled by default. Preview appears in Theme Editor only. Confirm genuine offer terms before enabling."
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Section scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "content_color_scheme",
      "label": "Content panel scheme",
      "default": "scheme-3"
    },
    {
      "type": "color_scheme",
      "id": "media_color_scheme",
      "label": "Image panel scheme",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "strip_color_scheme",
      "label": "Trust strip scheme",
      "default": "scheme-3"
    },
    {
      "type": "color_scheme",
      "id": "expired_color_scheme",
      "label": "Expired panel scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "inherit_panel_scheme",
      "label": "Use main scheme for all panels",
      "default": false,
      "info": "Off keeps existing independent Content, Image, Trust strip and Expired schemes. Enable to inherit the selected global Section scheme for every panel."
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "style_1",
      "options": [
        {
          "value": "style_1",
          "label": "Split campaign"
        },
        {
          "value": "style_2",
          "label": "Full image overlay"
        },
        {
          "value": "style_3",
          "label": "Compact countdown strip"
        },
        {
          "value": "style_4",
          "label": "Centered event card"
        },
        {
          "value": "style_5",
          "label": "Product spotlight"
        }
      ]
    },
    {
      "type": "header",
      "content": "Campaign content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LIMITED-TIME EVENT"
    },
    {
      "type": "text",
      "id": "promotional_badge",
      "label": "Offer badge",
      "default": "UP TO 30% OFF"
    },
    {
      "type": "checkbox",
      "id": "show_promotional_badge",
      "label": "Show offer badge",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Weekend Drop Ends Soon"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Save on everyday favorites before the clock runs out."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop the event"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "View all offers"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "primary_button_style",
      "label": "Primary button style",
      "default": "secondary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ]
    },
    {
      "type": "select",
      "id": "secondary_button_style",
      "label": "Second button style",
      "default": "outline",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "secondary_new_tab",
      "label": "Open second button in new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "ending_note",
      "label": "Campaign ending note",
      "default": "Check the offer terms for the final deadline."
    },
    {
      "type": "richtext",
      "id": "legal_note",
      "label": "Legal / disclaimer"
    },
    {
      "type": "header",
      "content": "Countdown and deadline"
    },
    {
      "type": "checkbox",
      "id": "enable_countdown",
      "label": "Enable countdown",
      "default": true
    },
    {
      "type": "select",
      "id": "countdown_mode",
      "label": "Timer mode",
      "default": "manual_preview",
      "options": [
        {
