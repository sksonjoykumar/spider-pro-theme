{{ 'sp-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-product-advanced.js' | asset_url }}" defer></script>
{% if section.settings.enable_sticky_add_to_cart %}
  {{ 'sp-sticky-add-to-cart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sp-sticky-add-to-cart.js' | asset_url }}" defer="defer"></script>
{% endif %}
{% render 'sp-section-color-scheme', section: section %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign has_quantity_block = false
  for scan_block in section.blocks
    if scan_block.type == 'quantity'
      assign has_quantity_block = true
    endif
  endfor
  assign template_suffix = template.suffix | default: 'default'
  assign container_class = 'sp-container'
  case section.settings.container_width
    when 'narrow'
      assign container_class = 'sp-container sp-container--narrow'
    when 'wide'
      assign container_class = 'sp-container sp-container--wide'
    when 'full'
      assign container_class = 'sp-main-product__container--full'
  endcase

  assign gallery_layout = section.settings.gallery_layout
  if gallery_layout == blank or gallery_layout == 'theme_default'
    if settings.product_gallery == 'stacked'
      assign gallery_layout = 'stacked'
    elsif settings.product_gallery == 'grid'
      assign gallery_layout = 'grid'
    elsif settings.thumb_position == 'bottom'
      assign gallery_layout = 'thumbnails_bottom'
    else
      assign gallery_layout = 'thumbnails_left'
    endif
  endif

  assign sticky_info = section.settings.sticky_product_info
  if template_suffix == 'sticky-cart'
    assign sticky_info = true
  endif
%}

<section
  class="sp-section sp-main-product sp-product--{{ template_suffix }}{% if sticky_info %} sp-main-product--sticky{% endif %}"
  data-main-product
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-url="{{ product.url }}"
  data-selected-variant-id="{{ current_variant.id }}"
  data-unavailable-label="{{ 'products.product.unavailable' | t | escape }}"
  data-sold-label="{{ 'products.product.sold_out' | t | escape }}"
  data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-in-stock-label="{{ 'products.product.inventory_in_stock' | t | escape }}"
  data-out-stock-label="{{ 'products.inventory.out_of_stock' | t | escape }}"
  data-low-stock-label="{{ 'products.product.inventory_low_stock' | t | escape }}"
  data-low-stock-count-template="{{ 'products.product.inventory_low_stock_show_count' | t: quantity: '__QTY__' | escape }}"
  data-cart-ajax-updates="{{ section.settings.cart_ajax_updates }}"
  data-cart-open-after-add="{{ section.settings.cart_open_after_add }}"
  data-cart-type="{{ section.settings.cart_type | default: 'drawer' | escape }}"
  style="--sp-product-media-width: {{ section.settings.media_width | default: 56 }}%; --sp-product-content-gap: {{ section.settings.content_gap | default: 48 }}px; --sp-product-media-gap: {{ section.settings.media_gap | default: 12 }}px; --sp-product-title-size-d: {{ section.settings.title_size_desktop | default: 36 }}px; --sp-product-title-size-m: {{ section.settings.title_size_mobile | default: 28 }}px; --sp-product-price-size-d: {{ section.settings.price_size_desktop | default: 28 }}px; --sp-product-price-size-m: {{ section.settings.price_size_mobile | default: 24 }}px; --sp-product-features-gap: {{ section.settings.feature_gap | default: 12 }}px;{% if section.settings.spacing_source == 'custom' %} --sp-product-pad-top: {{ section.settings.padding_top | default: 64 }}px; --sp-product-pad-bottom: {{ section.settings.padding_bottom | default: 64 }}px; --sp-product-pad-top-mobile: {{ section.settings.padding_top_mobile | default: 32 }}px; --sp-product-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;{% endif %}"
>
  <div class="{{ container_class }} sp-main-product__layout">
    <div class="sp-main-product__media">
      {% render 'product-media-gallery', product: product, section: section, layout: gallery_layout %}
    </div>

    <div class="sp-main-product__info">
      <div class="sp-main-product__info-inner" data-product-info>
        {% assign options_block_present = false %}
        {% for scan_block in section.blocks %}{% if scan_block.type == 'options' %}{% assign options_block_present = true %}{% endif %}{% endfor %}
        {% assign buy_buttons_rendered = false %}
        {% assign has_product_blocks = false %}
        {% assign feature_row_open = false %}
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            {% unless feature_row_open %}<div class="sp-product-features" role="list">{% assign feature_row_open = true %}{% endunless %}
          {% elsif feature_row_open %}
            </div>{% assign feature_row_open = false %}
          {% endif %}
          {% unless block.type == '@app' %}{% assign has_product_blocks = true %}{% endunless %}
          {% liquid
            assign advanced_visible = true
            case block.type
              when 'countdown_timer'
                if block.settings.enabled == false
                  assign advanced_visible = false
                elsif block.settings.target_datetime == blank and product.metafields.custom.sale_ends_at.value == blank
                  assign advanced_visible = false
                endif
              when 'delivery_time'
                if block.settings.enabled == false or block.settings.max_days == 0
                  assign advanced_visible = false
                endif
              when 'extra_link'
                if block.settings.link == blank or block.settings.label == blank
                  assign advanced_visible = false
                endif
              when 'live_review'
                if product.metafields.reviews.rating.value == blank and product.metafields.custom.featured_review.value == blank
                  assign advanced_visible = false
                endif
              when 'total_sold_flash'
                assign total_sold_value = block.settings.verified_count | default: 0 | plus: 0
                if total_sold_value <= 0
                  assign total_sold_value = product.metafields.custom.total_sold.value | default: 0 | plus: 0
                endif
                if total_sold_value <= 0
                  assign advanced_visible = false
                endif
              when 'trust_badge'
                if block.settings.badge_image == blank and block.settings.heading == blank and block.settings.description == blank
                  assign advanced_visible = false
                endif
            endcase
          %}
          {% if advanced_visible %}
          <div class="sp-product-block sp-product-block--{{ block.type | handle }}" data-product-block="{{ block.type }}" {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when '@app' %}
                {% render block %}

              {% when 'vendor' %}
                {% if product.vendor != blank %}<p class="sp-product-vendor">{{ product.vendor | escape }}</p>{% endif %}

              {% when 'title' %}
                {% liquid
                  assign title_class = 'sp-heading--h1'
                  case block.settings.heading_style
                    when 'global_h2'
                      assign title_class = 'sp-heading--h2'
                    when 'global_h3'
                      assign title_class = 'sp-heading--h3'
                    when 'custom'
                      assign title_class = 'sp-product-title--custom'
                  endcase
                %}
                <h1 class="sp-product-title {{ title_class }}"{% if block.settings.heading_style == 'custom' %} style="--sp-product-custom-title-size: {{ block.settings.custom_size | default: 38 }}px;"{% endif %}>{{ product.title | escape }}</h1>

              {% when 'rating' %}
                {% assign rating_value = product.metafields.reviews.rating.value %}
                {% if rating_value != blank %}
                  {% assign rating_percent = rating_value.rating | times: 100.0 | divided_by: rating_value.scale_max %}
                  <div class="sp-product-rating" aria-label="{{ rating_value.rating }} out of {{ rating_value.scale_max }}">
                    <span class="sp-product-rating__stars" aria-hidden="true" style="--sp-rating-percent: {{ rating_percent }}%">★★★★★</span>
                    <strong>{{ rating_value.rating }}</strong>
                    {% if product.metafields.reviews.rating_count != blank %}<span class="sp-product-rating__count">({{ product.metafields.reviews.rating_count }})</span>{% endif %}
                  </div>
                {% elsif request.design_mode %}
                  <p class="sp-product-editor-note">{{ 'products.product.reviews_app_required' | t }}</p>
                {% endif %}

              {% when 'price' %}
                {% render 'product-price', product: product, variant: current_variant, show_compare: block.settings.show_compare, show_savings: block.settings.show_savings, savings_mode: block.settings.savings_mode %}

              {% when 'sku' %}
                <div class="sp-product-meta-row{% if current_variant.sku == blank and block.settings.hide_empty %} is-empty{% endif %}" data-sku-row>
                  <span class="sp-product-meta-row__label">{{ block.settings.label | default: 'SKU' | escape }}:</span>
                  <span data-product-sku>{{ current_variant.sku | escape }}</span>
                </div>
                {% if block.settings.show_barcode %}
                  <div class="sp-product-meta-row{% if current_variant.barcode == blank and block.settings.hide_empty %} is-empty{% endif %}" data-barcode-row>
                    <span class="sp-product-meta-row__label">{{ block.settings.barcode_label | default: 'Barcode' | escape }}:</span>
                    <span data-product-barcode>{{ current_variant.barcode | escape }}</span>
                  </div>
                {% endif %}

              {% when 'inventory' %}
                {% render 'inventory-status', product: product, variant: current_variant, threshold: block.settings.low_stock_threshold, show_exact: block.settings.show_exact_quantity %}

              {% when 'options' %}
                {% render 'variant-picker', product: product, product_form_id: product_form_id, block: block %}

              {% when 'quantity' %}
                {% assign quantity_id = 'Quantity-' | append: section.id | append: '-' | append: block.id %}
                <div class="sp-product-quantity-block">
                  <span class="sp-product-option__label">{{ 'products.product.quantity.label' | t }}</span>
                  {% render 'quantity-input', id: quantity_id, form_id: product_form_id, value: current_variant.quantity_rule.min, min: current_variant.quantity_rule.min, max: current_variant.quantity_rule.max, step: current_variant.quantity_rule.increment %}
                </div>

              {% when 'buy_buttons' %}
                {% unless buy_buttons_rendered %}
                  {% assign buy_buttons_rendered = true %}
                  {% render 'product-form', product: product, product_form_id: product_form_id, variant: current_variant, block: block, has_options_block: options_block_present %}
                {% endunless %}

              {% when 'wishlist_compare' %}
                <div class="sp-product-secondary-actions">
                  {% if block.settings.show_wishlist %}
                    <button class="sp-product-secondary-action" type="button" data-main-product-wishlist aria-pressed="false">
                      {% render 'icon', name: 'heart' %}<span data-wishlist-label>{{ block.settings.wishlist_label | default: 'Wishlist' | escape }}</span>
                    </button>
                  {% endif %}
                  {% if block.settings.show_compare %}
                    <button class="sp-product-secondary-action" type="button" data-main-product-compare aria-pressed="false">
                      {% render 'icon', name: 'compare' %}<span data-compare-label>{{ block.settings.compare_label | default: 'Compare' | escape }}</span>
                    </button>
                  {% endif %}
                </div>

              {% when 'shipping_text' %}
                <div class="sp-product-shipping-text">
                  <span class="sp-product-shipping-text__icon">{% render 'icon', name: 'truck' %}</span>
                  <div class="sp-product-shipping-text__body rte">
                  {% if block.settings.heading != blank %}<strong>{{ block.settings.heading | escape }}</strong>{% endif %}
                  {% if block.settings.text != blank %}
                    {{ block.settings.text }}
                  {% elsif settings.shipping_info_page != blank %}
                    <p><a href="{{ settings.shipping_info_page.url }}">{{ settings.shipping_info_page.title | escape }}</a></p>
                  {% else %}
                    <p>{{ 'products.product.shipping_policy_html' | t }}</p>
                  {% endif %}
                  {% if block.settings.policy_link != blank %}<p class="sp-product-shipping-text__policy"><a href="{{ block.settings.policy_link }}">{{ block.settings.policy_label | default: 'Shipping details' | escape }}</a></p>{% endif %}
                  </div>
                </div>

              {% when 'pickup_availability' %}
                {% render 'pickup-availability', product: product, variant: current_variant %}

              {% when 'description' %}
                {% if product.description != blank %}
                  {% if block.settings.display_mode == 'accordion' %}
                    {% assign description_panel_id = 'ProductAccordion-' | append: section.id | append: '-' | append: block.id %}
                    <div class="sp-product-accordion{% if block.settings.open_by_default %} is-open{% endif %}" data-product-accordion>
                      <button class="sp-product-accordion__toggle" type="button" aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}" aria-controls="{{ description_panel_id }}" data-product-accordion-toggle>
                        <span>{{ block.settings.heading | default: 'Description' | escape }}</span>{% render 'icon', name: 'chevron' %}
                      </button>
                      <div id="{{ description_panel_id }}" class="sp-product-accordion__content rte" data-product-accordion-panel{% unless block.settings.open_by_default %} hidden{% endunless %}>{{ product.description }}</div>
                    </div>
                  {% else %}
                    <div class="sp-product-description rte">{{ product.description }}</div>
                  {% endif %}
                {% endif %}

              {% when 'accordion' %}
                {% liquid
                  assign accordion_content = block.settings.content
                  if block.settings.content_source == 'description'
                    assign accordion_content = product.description
                  elsif block.settings.content_source == 'page' and block.settings.page != blank
                    assign accordion_content = block.settings.page.content
                  endif
                %}
                {% if accordion_content != blank %}
                  {% assign accordion_panel_id = 'ProductAccordion-' | append: section.id | append: '-' | append: block.id %}
                  <div class="sp-product-accordion{% if block.settings.open_by_default %} is-open{% endif %}" data-product-accordion>
                    <button class="sp-product-accordion__toggle" type="button" aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}" aria-controls="{{ accordion_panel_id }}" data-product-accordion-toggle>
                      <span>{{ block.settings.heading | escape }}</span>{% render 'icon', name: 'chevron' %}
                    </button>
                    <div id="{{ accordion_panel_id }}" class="sp-product-accordion__content rte" data-product-accordion-panel{% unless block.settings.open_by_default %} hidden{% endunless %}>{{ accordion_content }}</div>
                  </div>
                {% endif %}

              {% when 'text' %}
                {% if block.settings.text != blank %}<div class="sp-product-text rte">{{ block.settings.text }}</div>{% endif %}

              {% when 'icon_with_text' %}
                <div class="sp-product-icon-text">
                  {% render 'icon', name: block.settings.icon %}
                  <div class="rte">{{ block.settings.text }}</div>
                </div>

              {% when 'feature' %}
                <div class="sp-product-feature" role="listitem">
                  <span class="sp-product-feature__icon">{% render 'sp-product-feature-icon', name: block.settings.icon %}</span>
                  {% if block.settings.title != blank %}<strong class="sp-product-feature__title">{{ block.settings.title | escape }}</strong>{% endif %}
                  {% if block.settings.description != blank %}<div class="sp-product-feature__description">{{ block.settings.description | escape }}</div>{% endif %}
                </div>

              {% when 'share' %}
                {% assign full_share_url = shop.url | append: product.url %}
                {% if block.settings.share_mode == 'links' %}
                  <div class="sp-product-social" aria-label="{{ block.settings.label | default: 'Share' | escape }}">
                    {% if block.settings.heading != blank %}<span class="sp-product-social__heading">{{ block.settings.heading | escape }}</span>{% endif %}
                    {% if block.settings.facebook %}<a href="https://www.facebook.com/sharer/sharer.php?u={{ full_share_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">Facebook</a>{% endif %}
                    {% if block.settings.pinterest and product.featured_image != blank %}<a href="https://pinterest.com/pin/create/button/?url={{ full_share_url | url_encode }}&amp;media={{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | url_encode }}&amp;description={{ product.title | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Pinterest">Pinterest</a>{% endif %}
                    {% if block.settings.x %}<a href="https://twitter.com/intent/tweet?url={{ full_share_url | url_encode }}&amp;text={{ product.title | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>{% endif %}
                    {% if block.settings.whatsapp %}<a href="https://wa.me/?text={{ product.title | append: ' ' | append: full_share_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">WhatsApp</a>{% endif %}
                    {% if block.settings.email %}<a href="mailto:?subject={{ product.title | url_encode }}&amp;body={{ full_share_url | url_encode }}" aria-label="Share by email">Email</a>{% endif %}
                  </div>
                {% else %}
                  <button class="sp-product-secondary-action sp-product-share" type="button" data-product-share data-share-url="{{ product.url }}">
                    {% render 'icon', name: 'share' %}<span>{{ block.settings.label | default: 'Share' | escape }}</span>
                  </button>
                {% endif %}

              {% when 'countdown_timer', 'delivery_time', 'extra_link', 'live_review', 'total_sold_flash', 'trust_badge' %}
                {% render 'sp-product-advanced-block', block: block, product: product, current_variant: current_variant, section: section %}

              {% when 'custom_liquid' %}
                <div class="sp-product-custom-liquid">{{ block.settings.custom_liquid }}</div>
            {% endcase %}
          </div>
          {% endif %}
        {% endfor %}
        {% if feature_row_open %}</div>{% endif %}

        {% unless has_product_blocks %}
          <div class="sp-product-block sp-product-block--title"><h1 class="sp-product-title sp-heading--h1">{{ product.title | escape }}</h1></div>
          <div class="sp-product-block sp-product-block--price">{% render 'product-price', product: product, variant: current_variant, show_compare: true %}</div>
          {% if settings.product_show_sku %}<div class="sp-product-block sp-product-block--sku"><div class="sp-product-meta-row"><span class="sp-product-meta-row__label">SKU:</span> <span data-product-sku>{{ current_variant.sku | escape }}</span></div></div>{% endif %}
          <div class="sp-product-block sp-product-block--inventory">{% render 'inventory-status', product: product, variant: current_variant, threshold: 5, show_exact: false %}</div>
          <div class="sp-product-block sp-product-block--options">{% render 'variant-picker', product: product, product_form_id: product_form_id %}</div>
          {% if settings.show_quantity %}<div class="sp-product-block sp-product-block--quantity">{% assign legacy_quantity_id = 'Quantity-' | append: section.id %}<span class="sp-product-option__label">{{ 'products.product.quantity.label' | t }}</span>{% render 'quantity-input', id: legacy_quantity_id, form_id: product_form_id, value: current_variant.quantity_rule.min, min: current_variant.quantity_rule.min, max: current_variant.quantity_rule.max, step: current_variant.quantity_rule.increment %}</div>{% endif %}
          <div class="sp-product-block sp-product-block--buy-buttons">{% render 'product-form', product: product, product_form_id: product_form_id, variant: current_variant, has_options_block: true %}</div>
          {% if settings.show_pickup %}<div class="sp-product-block sp-product-block--pickup-availability">{% render 'pickup-availability', product: product, variant: current_variant %}</div>{% endif %}
          {% render 'product-extras', product: product %}
          {% if product.description != blank %}<div class="sp-product-block sp-product-block--description"><div class="sp-product-description rte">{{ product.description }}</div></div>{% endif %}
        {% endunless %}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id | json }},
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "vendor": {{ product.vendor | json }},
      "url": {{ product.url | json }},
      "featuredImage": {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
      "options": [{% for option in product.options_with_values %}{"name":{{ option.name | json }},"position":{{ option.position | json }},"values":{{ option.values | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "variants": [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "sku": {{ variant.sku | json }},
            "barcode": {{ variant.barcode | json }},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},
            "featured_image_id": {% if variant.featured_image %}{{ variant.featured_image.id | json }}{% else %}null{% endif %},
            "price_formatted": {{ variant.price | money | json }},
            "compare_at_price_formatted": {% if variant.compare_at_price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "savings_amount_formatted": {% if variant.compare_at_price and variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | money | json }}{% else %}null{% endif %},
            "unit_price_formatted": {% if variant.unit_price %}{{ variant.unit_price | money | json }}{% else %}null{% endif %},
            "inventory_management": {{ variant.inventory_management | json }},
            "inventory_quantity": {{ variant.inventory_quantity | json }},
            "quantity_rule": {"min":{{ variant.quantity_rule.min | default: 1 | json }},"max":{{ variant.quantity_rule.max | json }},"increment":{{ variant.quantity_rule.increment | default: 1 | json }}},
            "unit_price": {{ variant.unit_price | json }},
            "unit_price_measurement": {{ variant.unit_price_measurement | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "money_format": {{ shop.money_format | json }}
    }
  </script>

  <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-product-live-region></div>

  {% if section.settings.enable_sticky_add_to_cart and request.page_type == 'product' %}
    {% render 'sp-sticky-add-to-cart', product: product, section: section, product_form_id: product_form_id, current_variant: current_variant, has_quantity_block: has_quantity_block %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "header",
      "content": "Product page layout"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Uses Spider global color-scheme tokens."
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media width",
      "default": 55,
      "min": 45,
      "max": 65,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Media / information gap",
      "default": 36,
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "sticky_product_info",
      "label": "Sticky product information on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Product cart behavior"
    },
    {
      "type": "checkbox",
      "id": "cart_ajax_updates",
      "label": "Enable AJAX add to cart",
      "info": "Uses the canonical Spider cart controller on this Product page. Turn off to use Shopify's native form fallback.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "cart_open_after_add",
      "label": "Open cart after add",
      "info": "When Cart type is Drawer, opens the existing Spider Cart Drawer after a successful AJAX add.",
      "default": true
    },
    {
      "type": "select",
      "id": "cart_type",
      "label": "Cart type",
      "info": "Controls the post-add experience for this Main Product section.",
      "default": "drawer",
      "options": [
        {
          "value": "drawer",
          "label": "Drawer"
        },
        {
          "value": "page",
          "label": "Page"
        }
      ]
    },
    {"type":"header","content":"Sticky Add to Cart"},
    {"type":"checkbox","id":"enable_sticky_add_to_cart","label":"Enable Sticky Add to Cart","default":true},
