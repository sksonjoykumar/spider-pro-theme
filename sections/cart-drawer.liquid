{% render 'sp-section-color-scheme', section: section %}
{% assign sp_cart_scheme = section.settings.sp_color_scheme %}
{%- liquid
  assign gift_product = section.settings.gift_wrap_product
  assign gift_variant = blank
  assign gift_in_cart = false
  if gift_product != blank
    assign gift_variant = gift_product.selected_or_first_available_variant
    if gift_variant != blank
      for cart_item in cart.items
        if cart_item.variant_id == gift_variant.id
          assign gift_in_cart = true
          break
        endif
      endfor
    endif
  endif

  assign threshold_cents = section.settings.free_shipping_threshold | times: 100
  assign drawer_shadow = section.settings.drawer_shadow
  assign effective_drawer_width = section.settings.drawer_width
  assign effective_image_size = section.settings.item_image_size
  assign effective_image_radius = section.settings.item_image_radius
  assign effective_button_radius = section.settings.button_radius
  assign show_optional_areas = true
  assign show_inline_discount = false
  if section.settings.show_discount and section.settings.premium_inline_discount
    assign show_inline_discount = true
  endif
  assign show_tool_shortcuts = section.settings.show_cart_tool_shortcuts
-%}

{%- unless request.page_type == 'cart' -%}
  {{ 'sp-cart-drawer.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sp-cart-drawer.js' | asset_url }}" defer></script>

  <div
    class="sp-cart-drawer-section"
    data-cart-drawer-section
    data-section-id="{{ section.id }}"
    data-sp-cart-drawer-root
  >
    <dialog
      id="CartDrawer"
      class="sp-cart-drawer sp-drawer sp-drawer--{{ section.settings.drawer_position }} sp-cart-drawer--{{ section.settings.drawer_position }} sp-cart-drawer--shadow-{{ drawer_shadow }} sp-cart-drawer--premium{% unless section.settings.use_theme_editor_summary_order %} sp-cart-drawer--fixed-summary-order{% endunless %}"
      aria-labelledby="CartDrawerTitle-{{ section.id }}"
      data-cart-section
      data-cart-drawer
      data-section-id="{{ section.id }}"
      data-open-editor="{{ section.settings.open_in_editor }}"
      style="
        --sp-cart-drawer-width: {{ effective_drawer_width }}px;
        --sp-cart-progress-height: {{ section.settings.progress_height | default: 6 }}px;
        --sp-cart-header-size: {{ section.settings.header_font_size | default: 26 }}px;
        --sp-cart-payment-height: {{ section.settings.payment_icon_height | default: 24 }}px;
        --sp-cart-drawer-bg: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.card | default: sp_cart_scheme.settings.background }}{% else %}{{ section.settings.background }}{% endif %};
        --sp-cart-drawer-text: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.text }}{% else %}{{ section.settings.text_color }}{% endif %};
        --sp-cart-drawer-muted: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.muted }}{% else %}{{ section.settings.muted_text_color }}{% endif %};
        --sp-cart-drawer-border: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.border }}{% else %}{{ section.settings.border_color }}{% endif %};
        --sp-cart-drawer-divider: {{ section.settings.divider_color }};
        --sp-cart-drawer-backdrop: {{ section.settings.backdrop_color }};
        --sp-cart-drawer-backdrop-opacity: {{ section.settings.backdrop_opacity | divided_by: 100.0 }};
        --sp-cart-drawer-radius: {{ section.settings.drawer_radius }}px;
        --sp-cart-drawer-image-size: {{ effective_image_size }}px;
        --sp-cart-drawer-image-radius: {{ effective_image_radius }}px;
        --sp-cart-drawer-button-radius: {{ effective_button_radius }}px;
        --sp-cart-drawer-accent: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.accent }}{% else %}{{ section.settings.accent_color }}{% endif %};
        --sp-cart-drawer-button-bg: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.primary_button }}{% else %}{{ section.settings.button_background }}{% endif %};
        --sp-cart-drawer-button-text: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.primary_button_label }}{% else %}{{ section.settings.button_text_color }}{% endif %};
        --sp-cart-drawer-view-cart-bg: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.secondary_button }}{% else %}{{ section.settings.view_cart_background }}{% endif %};
        --sp-cart-drawer-view-cart-text: {% if section.settings.sp_use_color_scheme %}{{ sp_cart_scheme.settings.secondary_button_label }}{% else %}{{ section.settings.view_cart_text_color }}{% endif %};
      "
    >
      <div class="sp-cart-drawer__render" data-sp-cart-drawer-render>
        <header class="sp-cart-drawer__header">
          <h2 id="CartDrawerTitle-{{ section.id }}" class="sp-cart-drawer__title">
            {{ section.settings.title | escape }}
            {%- if section.settings.show_item_count -%}
              <span class="sp-cart-drawer__count">(<span data-cart-count>{{ cart.item_count }}</span>)</span>
            {%- endif -%}
          </h2>
          <button class="sp-cart-drawer__close" type="button" data-drawer-close aria-label="Close cart">
            {% render 'icon', name: 'close' %}
          </button>
        </header>

        <div class="sp-cart-drawer__body" aria-busy="false" data-sp-cart-drawer-body>
          {%- if show_optional_areas and section.settings.show_free_shipping_bar and threshold_cents > 0 -%}
            {% render 'sp-cart-drawer-shipping-bar', cart: cart, threshold_cents: threshold_cents, section: section %}
          {%- endif -%}

          <main class="sp-cart-drawer__main" data-sp-cart-drawer-main>
            {%- if cart == empty -%}
              {% render 'sp-cart-drawer-empty', section: section %}
            {%- else -%}
              {% render 'sp-cart-drawer-items', cart: cart, section: section %}

              {%- if show_optional_areas and show_tool_shortcuts -%}
                {% render 'sp-cart-drawer-tools', section: section, cart: cart, gift_product: gift_product, gift_variant: gift_variant, gift_in_cart: gift_in_cart %}

                {%- if section.settings.show_complementary -%}
                  {% render 'sp-cart-drawer-complementary', section: section, cart: cart %}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          </main>

          {%- unless cart == empty -%}
            {%- if show_inline_discount -%}
              {% render 'sp-cart-drawer-discount', section: section, cart: cart, inline: true %}
            {%- endif -%}
            {% render 'sp-cart-drawer-summary', section: section, cart: cart %}
          {%- endunless -%}

          {%- if show_optional_areas -%}
            {% render 'sp-cart-drawer-note', section: section, cart: cart %}
            {%- unless show_inline_discount -%}{% render 'sp-cart-drawer-discount', section: section, cart: cart %}{%- endunless -%}
            {% render 'sp-cart-drawer-gift-wrap', section: section, gift_product: gift_product, gift_variant: gift_variant, gift_in_cart: gift_in_cart %}
            {% render 'sp-cart-drawer-shipping-estimator', section: section %}
          {%- endif -%}
        </div>
      </div>
    </dialog>

    <noscript>
      <div class="sp-cart-drawer__noscript">
        <a href="{{ routes.cart_url }}">View cart</a>
      </div>
    </noscript>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Cart drawer",
  "tag": "section",
  "class": "sp-system-cart-drawer",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Global design system"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Shared Spider color panel. Edit schemes once in Theme settings → Spider Color Schemes."
    },
    {
      "type": "checkbox",
      "id": "sp_use_color_scheme",
      "label": "Use global color scheme",
      "info": "When enabled, this section inherits the selected Spider color panel. Disable only for legacy/local color controls.",
      "default": true
    },
    {
      "type": "header",
      "content": "Drawer"
    },
    {
      "type": "checkbox",
      "id": "use_theme_editor_summary_order",
      "label": "Use Theme Editor summary block order",
      "default": false,
      "info": "Off uses premium purchase flow: Subtotal, shipping note, estimated total, checkout, payment methods."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Cart title",
      "default": "Your cart"
    },
    {
      "type": "checkbox",
      "id": "show_item_count",
      "label": "Show item count",
      "default": true
    },
    {
      "type": "select",
      "id": "drawer_position",
      "label": "Drawer position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "drawer_width",
      "label": "Desktop drawer width",
      "min": 320,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
