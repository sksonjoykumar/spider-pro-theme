{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-toolbar-mobile.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-toolbar-mobile.js' | asset_url }}" defer></script>

{%- liquid
  assign sp_toolbar_breakpoint = 749
  assign sp_toolbar_bg_alpha = section.settings.background_opacity | default: 100 | divided_by: 100.0
  assign sp_toolbar_overlay_alpha = section.settings.sheet_overlay_opacity | default: 40 | divided_by: 100.0
-%}

{%- if section.blocks.size > 0 -%}
  {% style %}
    #SpMobileToolbar-{{ section.id }} {
      --sp-toolbar-height: {{ section.settings.toolbar_height | default: 64 }}px;
      --sp-toolbar-item-min-width: {{ section.settings.item_min_width | default: 48 }}px;
      --sp-toolbar-item-count: {{ section.blocks.size }};
      --sp-toolbar-icon-size: {{ section.settings.icon_size | default: 24 }}px;
      --sp-toolbar-label-size: {{ section.settings.label_size | default: 12 }}px;
      --sp-toolbar-label-weight: {{ section.settings.label_weight | default: '500' }};
      --sp-toolbar-item-gap: {{ section.settings.item_gap | default: 4 }}px;
      --sp-toolbar-bg: {{ section.settings.background | default: '#ffffff' }};
      --sp-toolbar-bg-opacity: {{ sp_toolbar_bg_alpha }};
      --sp-toolbar-text: {{ section.settings.text_color | default: '#171717' }};
      --sp-toolbar-active: {{ section.settings.active_color | default: '#415DFF' }};
      --sp-toolbar-active-bg: {% if section.settings.enable_active_background %}{{ section.settings.active_background | default: '#E8F0FF' }}{% else %}transparent{% endif %};
      --sp-toolbar-border: {{ section.settings.border_color | default: '#e5e5e5' }};
      --sp-toolbar-border-width: {{ section.settings.border_width | default: 1 }}px;
      --sp-toolbar-radius: {{ section.settings.toolbar_radius | default: 0 }}px;
      --sp-toolbar-item-radius: {{ section.settings.item_radius | default: 8 }}px;
      --sp-toolbar-blur: {{ section.settings.blur_strength | default: 8 }}px;
      --sp-toolbar-badge-bg: {{ section.settings.badge_background | default: '#EF3340' }};
      --sp-toolbar-badge-text: {{ section.settings.badge_text | default: '#ffffff' }};
      --sp-toolbar-badge-size: {{ section.settings.badge_size | default: 18 }}px;
      --sp-toolbar-badge-x: {{ section.settings.badge_x | default: -7 }}px;
      --sp-toolbar-badge-y: {{ section.settings.badge_y | default: -6 }}px;
      --sp-toolbar-active-circle: {{ section.settings.active_circle_size | default: 54 }}px;
      --sp-toolbar-sheet-radius: {{ section.settings.sheet_radius | default: 24 }}px;
      --sp-toolbar-backdrop-opacity: {{ sp_toolbar_overlay_alpha }};
      --sp-toolbar-sheet-cols: {{ section.settings.categories_columns | default: '4' }};
      --sp-toolbar-focus: var(--sp-focus-color, var(--sp-color-accent, #415DFF));
      --sp-toolbar-menu-duration: var(--sp-drawer-duration, 300ms);
      {% if section.settings.use_global_colors %}
      --sp-toolbar-bg: var(--sp-color-background, #FFFFFF);
      --sp-toolbar-text: var(--sp-color-heading, var(--sp-color-text, #171717));
      --sp-toolbar-active: var(--sp-color-accent, #415DFF);
      --sp-toolbar-border: var(--sp-color-border, #E4E4E7);
      --sp-toolbar-badge-bg: var(--sp-color-error, #EF3340);
      {% endif %}
      {% case section.settings.toolbar_color_mode %}
        {% when 'dark' %}
          --sp-toolbar-bg: #171717;
          --sp-toolbar-text: #F4F4F5;
          --sp-toolbar-border: #34343B;
          --sp-toolbar-active-bg: rgba(65, 93, 255, .2);
        {% when 'light' %}
          --sp-toolbar-bg: #FFFFFF;
          --sp-toolbar-text: #171717;
          --sp-toolbar-border: #E4E4E7;
      {% endcase %}
    }

    #SpMobileToolbarSpacer-{{ section.id }} {
      --sp-toolbar-height: {{ section.settings.toolbar_height | default: 64 }}px;
    }

    @media (max-width: {{ sp_toolbar_breakpoint }}px) {
      #SpMobileToolbar-{{ section.id }},
      #SpMobileToolbarSpacer-{{ section.id }} { display: block; }
    }
  {% endstyle %}

  <sp-mobile-toolbar
    id="SpMobileToolbar-{{ section.id }}"
    class="sp-mobile-toolbar sp-mobile-toolbar--shadow-{{ section.settings.shadow }}{% if section.settings.top_border %} has-top-border{% endif %}{% if section.settings.enable_blur %} has-blur{% endif %}"
    data-section-id="{{ section.id }}"
    data-page-type="{{ request.page_type }}"
    data-breakpoint="{{ sp_toolbar_breakpoint }}"
    data-behaviour="{{ section.settings.behaviour }}"
    data-scroll-threshold="{{ section.settings.scroll_threshold | default: 10 }}"
    data-active-circle="{{ section.settings.active_circle }}"
    data-toolbar-color-mode="{{ section.settings.toolbar_color_mode | default: 'global' }}"
    data-show-cart-badge="{{ section.settings.show_cart_badge }}"
    data-show-wishlist-badge="{{ section.settings.show_wishlist_badge }}"
    data-label-position="{{ section.settings.label_position }}"
    data-show-labels="{{ section.settings.show_labels }}"
    data-hide-zero="{{ section.settings.hide_zero_count }}"
    data-cap-count="{{ section.settings.cap_count }}"
    data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
    aria-label="Mobile toolbar">
    <div class="sp-mobile-toolbar__surface" aria-hidden="true"></div>
    {% render 'sp-toolbar-mobile-sheets', section: section %}
    <nav class="sp-mobile-toolbar__scroller" aria-label="Quick navigation">
      <div class="sp-mobile-toolbar__inner">
        {%- for block in section.blocks -%}
          {% render 'sp-toolbar-mobile-item', block: block, section: section %}
        {%- endfor -%}
      </div>
    </nav>
  </sp-mobile-toolbar>

  <div id="SpMobileToolbarSpacer-{{ section.id }}" class="sp-mobile-toolbar__spacer" aria-hidden="true"></div>
{%- endif -%}

{% schema %}
