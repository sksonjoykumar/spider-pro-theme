{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'sp-retail-locations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-retail-locations.js' | asset_url }}" defer></script>

{%- liquid
  assign sp_valid_count = 0
  assign sp_first_valid_id = ''
  assign sp_featured_id = ''
  assign sp_valid_coords = 0
  for block in section.blocks
    if block.type == 'location' and block.settings.location_name != blank
      assign sp_store_address = block.settings.address_line_1 | default: block.settings.city | default: block.settings.country
      if sp_store_address != blank
        assign sp_valid_count = sp_valid_count | plus: 1
        if sp_first_valid_id == blank
          assign sp_first_valid_id = block.id
        endif
        if block.settings.featured_location and sp_featured_id == blank
          assign sp_featured_id = block.id
        endif
        if block.settings.latitude != blank and block.settings.longitude != blank
          assign sp_lat = block.settings.latitude | plus: 0
          assign sp_lng = block.settings.longitude | plus: 0
          if sp_lat >= -90 and sp_lat <= 90 and sp_lng >= -180 and sp_lng <= 180
            assign sp_valid_coords = sp_valid_coords | plus: 1
          endif
        endif
      endif
    endif
  endfor
  if sp_featured_id == blank
    assign sp_featured_id = sp_first_valid_id
  endif
  assign sp_map_available = false
  if section.settings.map_mode == 'static_image' and section.settings.static_map_image != blank
    assign sp_map_available = true
  elsif section.settings.map_mode == 'external_embed' and section.settings.external_embed_url != blank
    assign sp_map_available = true
  endif
  if section.settings.layout_style == 'style_2' or section.settings.layout_style == 'style_4' or section.settings.layout_style == 'style_5'
    assign sp_map_available = false
  endif
  assign sp_container_class = 'sp-container'
  if section.settings.section_max_width == 'wide'
    assign sp_container_class = 'sp-container sp-container--wide'
  elsif section.settings.section_max_width == 'full'
    assign sp_container_class = 'sp-rl__container--full'
  endif
  assign sp_header_desktop_size = 44
  assign sp_header_tablet_size = 36
  assign sp_header_mobile_size = 28
  if section.settings.heading_size == 'medium'
    assign sp_header_desktop_size = 34
    assign sp_header_tablet_size = 30
    assign sp_header_mobile_size = 26
  elsif section.settings.heading_size == 'extra'
    assign sp_header_desktop_size = 60
    assign sp_header_tablet_size = 46
    assign sp_header_mobile_size = 34
  endif
  assign sp_section_id = 'sp-rl-' | append: section.id
  assign sp_regions = '|'
  assign sp_region_list = ''
  if section.settings.layout_style == 'style_4'
    for block in section.blocks
      if block.type == 'location' and block.settings.location_name != blank
        assign sp_store_address = block.settings.address_line_1 | default: block.settings.city | default: block.settings.country
        if sp_store_address != blank
          assign sp_region_name = block.settings.region_filter | default: block.settings.state_region | default: block.settings.country | default: 'Other locations'
          assign sp_region_token = '|' | append: sp_region_name | append: '|'
          unless sp_regions contains sp_region_token
            assign sp_regions = sp_regions | append: sp_region_name | append: '|'
            assign sp_region_list = sp_region_list | append: sp_region_name | append: '||'
          endunless
        endif
      endif
    endfor
  endif
-%}
<section
  id="{{ sp_section_id }}"
  class="sp-rl sp-rl--{{ section.settings.layout_style }} sp-rl--featured-button-{{ section.settings.featured_button_style }}{% unless sp_map_available %} sp-rl--no-map{% endunless %} sp-rl--map-{{ section.settings.map_mode }} sp-rl--marker-{{ section.settings.marker_style }} sp-rl--cluster-{{ section.settings.marker_cluster_style }}{% unless section.settings.card_equal_height %} sp-rl--cards-natural{% endunless %} sp-rl--featured-ratio-{{ section.settings.featured_image_ratio }} sp-rl--featured-align-{{ section.settings.featured_content_alignment }} sp-rl--mobile-filter-{{ section.settings.mobile_filter_style }} sp-rl--shadow-{{ section.settings.card_shadow }} sp-rl--filter-{{ section.settings.filter_style }} sp-rl--featured-{{ section.settings.featured_position }} sp-rl--featured-mobile-{{ section.settings.mobile_featured_position }} sp-rl--image-{{ section.settings.location_image_ratio }}"
  data-sp-retail-locations
  data-sp-section-id="{{ section.id }}"
  data-sp-search-mode="{{ section.settings.search_mode }}"
  data-sp-search-fields="{{ section.settings.search_fields }}"
  data-sp-min-chars="{{ section.settings.search_minimum_characters }}"
  data-sp-default-region="{{ section.settings.default_region | escape }}"
  data-sp-all-option="{{ section.settings.show_all_option }}"
  data-sp-all-label="{{ section.settings.all_locations_label | escape }}"
  data-sp-no-results="{{ section.settings.no_results_text | escape }}"
  data-sp-has-map="{{ sp_map_available }}"
  data-sp-mobile-view="{{ section.settings.default_mobile_view }}"
  data-sp-remember-view="{{ section.settings.remember_mobile_view }}"
  data-sp-distance-unit="{{ section.settings.distance_unit }}"
  data-sp-sort-distance="{{ section.settings.sort_by_distance }}"
  data-sp-show-numbers="{{ section.settings.show_marker_numbers }}"
  data-sp-valid-coords="{{ sp_valid_coords }}"
  style="
  --sp-rl-pad-d:{{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  --sp-rl-pt-d:{{ section.settings.padding_top }}px;--sp-rl-pb-d:{{ section.settings.padding_bottom }}px;
  --sp-rl-pt-t:{{ section.settings.padding_top_tablet }}px;--sp-rl-pb-t:{{ section.settings.padding_bottom_tablet }}px;
  --sp-rl-pt-m:{{ section.settings.padding_top_mobile }}px;--sp-rl-pb-m:{{ section.settings.padding_bottom_mobile }}px;
  --sp-rl-locator-height:{{ section.settings.locator_height_desktop }}px;--sp-rl-locator-height-tablet:{{ section.settings.locator_height_tablet }}px;
  --sp-rl-list-width:{{ section.settings.list_panel_width }}%;--sp-rl-header-width:{{ section.settings.header_max_width }}px;
  --sp-rl-description-width:{{ section.settings.description_width }}px;
  --sp-rl-card-radius:{{ section.settings.card_border_radius }}px;
  --sp-rl-card-border-width:{{ section.settings.card_border_width }}px;
  --sp-rl-selected-border:{{ section.settings.selected_border_width }}px;
  --sp-rl-card-pad:{{ section.settings.card_padding_desktop }}px;--sp-rl-card-pad-mobile:{{ section.settings.card_padding_mobile }}px;
  --sp-rl-gap:{{ section.settings.location_card_gap }}px;--sp-rl-search-gap:{{ section.settings.search_to_results_spacing }}px;
  --sp-rl-header-gap:{{ section.settings.header_to_locator_spacing }}px;--sp-rl-results-height:{{ section.settings.results_max_height }}px;
  --sp-rl-desktop-columns:{{ section.settings.desktop_columns }};--sp-rl-tablet-columns:{{ section.settings.tablet_columns }};--sp-rl-mobile-columns:{{ section.settings.mobile_columns }};
  --sp-rl-grid-gap-d:{{ section.settings.grid_gap_desktop }}px;--sp-rl-grid-gap-t:{{ section.settings.grid_gap_tablet }}px;--sp-rl-grid-gap-m:{{ section.settings.grid_gap_mobile }}px;
  --sp-rl-support-cols:{{ section.settings.supporting_location_columns }};
  --sp-rl-marker-size:{{ section.settings.marker_size }}px;
  {% if section.settings.marker_color != blank %}--sp-rl-marker-color:{{ section.settings.marker_color }};{% endif %}
  {% if section.settings.marker_active_color != blank %}--sp-rl-marker-active:{{ section.settings.marker_active_color }};{% endif %}
  {% if section.settings.card_background != blank %}--sp-rl-card-custom:{{ section.settings.card_background }};{% endif %}
  {% if section.settings.card_border_color != blank %}--sp-rl-border-custom:{{ section.settings.card_border_color }};{% endif %}
  {% if section.settings.map_panel_position == 'left' %}--sp-rl-map-order:-1;{% endif %}
  ">
  <div class="sp-rl__container {{ sp_container_class }}">
    {% if section.settings.show_header %}
      <div class="sp-rl__header sp-rl__header--{{ section.settings.heading_alignment }}" style="--sp-rl-header-bottom:{{ section.settings.header_bottom_spacing }}px">
        {% if section.settings.eyebrow != blank %}<p class="sp-rl__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% capture sp_description %}<p>{{ section.settings.description | escape | newline_to_br }}</p>{% endcapture %}
        {% render 'sp-section-heading', heading: section.settings.heading, subheading: sp_description, heading_tag: 'h2', alignment: section.settings.heading_alignment, mobile_alignment: section.settings.heading_alignment, typography_source: 'custom', heading_size_desktop: sp_header_desktop_size, heading_size_tablet: sp_header_tablet_size, heading_size_mobile: sp_header_mobile_size, heading_weight: 750, heading_line_height: 112, bottom_spacing: 0 %}
      </div>
    {% endif %}

    <div class="sp-rl__shell">
      {% if section.settings.enable_search or section.settings.enable_region_filter or section.settings.enable_location_type_filter or section.settings.enable_geolocation %}
        <form class="sp-rl__search" data-sp-form role="search">
          {% if section.settings.enable_search %}
            <div class="sp-rl__search-field">
              <label class="sp-rl__sr-only" for="{{ sp_section_id }}-search">Search stores by city, name or address</label>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 21s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <input id="{{ sp_section_id }}-search" name="query" type="search" data-sp-query placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
              {% if section.settings.show_clear_search %}<button type="button" class="sp-rl__clear" data-sp-clear aria-label="Clear search" hidden>×</button>{% endif %}
            </div>
          {% endif %}
          {% if section.settings.enable_geolocation %}
            <button type="button" class="sp-rl__geo" data-sp-geolocate{% if sp_valid_coords == 0 %} disabled title="Add valid store coordinates to enable location searching"{% endif %}{% if section.settings.geolocation_privacy_text != blank %} aria-describedby="{{ sp_section_id }}-geo-privacy"{% endif %}>
              <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/><circle cx="12" cy="12" r="2"/></svg>
              <span>{{ section.settings.geolocation_button_label | escape }}</span>
            </button>
          {% endif %}
          {% if section.settings.enable_region_filter %}
            <div class="sp-rl__filter-wrap"><label class="sp-rl__sr-only" for="{{ sp_section_id }}-region">Filter stores by region</label><select id="{{ sp_section_id }}-region" class="sp-rl__filter" data-sp-region-select><option value="">{{ section.settings.all_locations_label | escape }}</option></select></div>
          {% endif %}
          {% if section.settings.enable_location_type_filter %}
            <div class="sp-rl__filter-wrap"><label class="sp-rl__sr-only" for="{{ sp_section_id }}-type">Filter by store type</label><select id="{{ sp_section_id }}-type" class="sp-rl__filter" data-sp-type-select><option value="">All store types</option></select></div>
          {% endif %}
          {% if section.settings.enable_search %}<button class="sp-rl__submit" type="submit">{{ section.settings.search_button_label | escape }}</button>{% endif %}
        </form>
      {% endif %}
      {% if section.settings.enable_geolocation and section.settings.geolocation_privacy_text != blank %}
        <p id="{{ sp_section_id }}-geo-privacy" class="sp-rl__sr-only">{{ section.settings.geolocation_privacy_text | escape }}</p>
      {% endif %}
      {% if section.settings.enable_geolocation %}
        <p class="sp-rl__geo-feedback" data-sp-geo-feedback role="status" aria-live="polite" hidden></p>
      {% endif %}
      {% if sp_map_available and section.settings.show_mobile_view_toggle %}
        <div class="sp-rl__view-toggle" aria-label="Location view" data-sp-view-toggle>
          <button type="button" data-sp-view-button="list" aria-pressed="true">{{ section.settings.list_view_label | escape }}</button>
          <button type="button" data-sp-view-button="map" aria-pressed="false">{{ section.settings.map_view_label | escape }}</button>
        </div>
      {% endif %}
      <div class="sp-rl__workspace">
        <div class="sp-rl__results" data-sp-results role="region" aria-label="{{ section.settings.results_aria_label | escape }}" tabindex="0">
          {% if section.settings.layout_style == 'style_4' %}
            <div class="sp-rl__directory">
              {% assign sp_split_regions = sp_region_list | split: '||' %}
              {% for sp_group in sp_split_regions %}
                {% if sp_group != blank %}
                  <details class="sp-rl__region" data-sp-region-group open>
                    <summary class="sp-rl__region-title">{{ sp_group | escape }} <span aria-hidden="true">⌄</span></summary>
                    <ul class="sp-rl__cards sp-rl__region-cards" role="list" data-sp-card-list>
                      {%- assign sp_index = 0 -%}
                      {% for block in section.blocks %}
                        {% assign sp_addr = block.settings.address_line_1 | default: block.settings.city | default: block.settings.country %}
                        {% assign sp_group_check = block.settings.region_filter | default: block.settings.state_region | default: block.settings.country | default: 'Other locations' %}
                        {% if block.type == 'location' and block.settings.location_name != blank and sp_addr != blank and sp_group_check == sp_group %}
                          {% assign sp_index = sp_index | plus: 1 %}
                          {% render 'sp-retail-location-card', block: block, index: sp_index, settings: section.settings, section_id: section.id %}
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </details>
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
            <ul class="sp-rl__cards" role="list" data-sp-card-list>
              {%- assign sp_index = 0 -%}
              {% if section.settings.layout_style == 'style_5' and sp_featured_id != blank %}
                {% for block in section.blocks %}
                  {% if block.id == sp_featured_id %}
                    {% assign sp_index = sp_index | plus: 1 %}
                    {% render 'sp-retail-location-card', block: block, index: sp_index, is_featured: true, settings: section.settings, section_id: section.id %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {% for block in section.blocks %}
                {% assign sp_addr = block.settings.address_line_1 | default: block.settings.city | default: block.settings.country %}
                {% if block.type == 'location' and block.settings.location_name != blank and sp_addr != blank %}
                  {% unless section.settings.layout_style == 'style_5' and block.id == sp_featured_id %}
                    {% assign sp_index = sp_index | plus: 1 %}
                    {% render 'sp-retail-location-card', block: block, index: sp_index, settings: section.settings, section_id: section.id %}
                  {% endunless %}
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
          <div class="sp-rl__empty" data-sp-empty{% if sp_valid_count > 0 %} hidden{% endif %}>
            <h3>{{ section.settings.no_results_heading | escape }}</h3><p>{% if sp_valid_count == 0 %}{% if request.design_mode %}Add a store name and address to a location block to preview your locator.{% else %}Store locations will appear here when available.{% endif %}{% else %}{{ section.settings.no_results_text | escape }}{% endif %}</p>
          </div>
          <p class="sp-rl__sr-only" aria-live="polite" aria-atomic="true" data-sp-count></p>
        </div>
        {% if sp_map_available %}
          <div class="sp-rl__map-panel" data-sp-map-panel>
            <div class="sp-rl__desktop-map-toggle" aria-label="Desktop map or list view">
              <button type="button" data-sp-desktop-view-button="map" aria-pressed="true">{{ section.settings.map_view_label | escape }}</button>
              <button type="button" data-sp-desktop-view-button="list" aria-pressed="false">{{ section.settings.list_view_label | escape }}</button>
            </div>
            {% render 'sp-retail-location-map', section: section, settings: section.settings %}
          </div>
        {% elsif request.design_mode and section.settings.layout_style != 'style_2' and section.settings.layout_style != 'style_4' and section.settings.layout_style != 'style_5' %}
          <p class="sp-rl__setup-help">To display a map, upload a static map image or configure a supported iframe embed. Until then, the store list is displayed.</p>
        {% endif %}
      </div>
      {% if section.settings.show_holiday_disclaimer and section.settings.holiday_disclaimer != blank %}
        <p class="sp-rl__holiday-note">{{ section.settings.holiday_disclaimer | escape }}</p>
      {% endif %}
      {% if sp_map_available and section.settings.map_mode == 'external_embed' %}
        <p class="sp-rl__embed-hint">Map pins are controlled by the external provider. Store cards remain searchable independently.</p>
      {% endif %}
    </div>
  </div>

  {% if section.settings.enable_location_schema %}
    {% for block in section.blocks %}
      {% assign sp_record = block.settings %}
      {% if block.type == 'location' and sp_record.location_name != blank and sp_record.address_line_1 != blank and sp_record.city != blank and sp_record.country != blank %}
        <script type="application/ld+json">{
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": {{ sp_record.location_name | json }},
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ sp_record.address_line_1 | json }},
            "addressLocality": {{ sp_record.city | json }},
            "addressRegion": {{ sp_record.state_region | json }},
            "postalCode": {{ sp_record.postal_code | json }},
            "addressCountry": {{ sp_record.country | json }}
          }{% if sp_record.phone != blank %},"telephone": {{ sp_record.phone | json }}{% endif %}{% if sp_record.details_page.url != blank %},"url": {{ sp_record.details_page.url | json }}{% endif %}
        }</script>
      {% endif %}
    {% endfor %}
  {% endif %}
</section>
{% schema %}
{
  "name": "Retail Locations",
  "tag": "section",
  "class": "sp-section sp-section-retail-locations",
  "max_blocks": 30,
   "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section heading",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VISIT US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a Store Near You"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our retail locations and experience the collection in person."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "extra",
          "label": "Extra large"
        }
      ],
      "default": "extra"
    },
    {
      "type": "range",
      "id": "description_width",
      "label": "Description maximum width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 760,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Heading maximum width",
      "min": 500,
      "max": 1200,
      "step": 20,
      "default": 960,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_bottom_spacing",
      "label": "Heading bottom spacing",
      "min": 8,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout style"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "style_1",
          "label": "Map & Location List"
        },
        {
          "value": "style_2",
          "label": "Location Card Grid"
        },
        {
          "value": "style_3",
          "label": "Full-Width Map Locator"
        },
        {
          "value": "style_4",
          "label": "Region Directory"
        },
        {
          "value": "style_5",
          "label": "Flagship Store Showcase"
        }
      ],
      "default": "style_1"
    },
    {
      "type": "select",
      "id": "section_max_width",
      "label": "Section width",
      "options": [
        {
          "value": "default",
          "label": "Theme container"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "map_panel_position",
      "label": "Map position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "locator_height_desktop",
      "label": "Locator height desktop",
      "min": 400,
      "max": 900,
      "step": 10,
      "default": 570,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "locator_height_tablet",
      "label": "Locator height tablet",
      "min": 340,
      "max": 800,
      "step": 10,
      "default": 530,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "list_panel_width",
      "label": "List panel width",
      "min": 30,
      "max": 60,
      "step": 1,
      "default": 38,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "results_max_height",
      "label": "Results maximum height",
      "min": 300,
      "max": 840,
      "step": 10,
      "default": 570,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "search_to_results_spacing",
      "label": "Search to results spacing",
      "min": 8,
      "max": 36,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Enter city, postcode, or address"
    },
    {
      "type": "text",
      "id": "search_button_label",
      "label": "Search button label",
      "default": "Search"
    },
    {
      "type": "select",
      "id": "search_fields",
      "label": "Searchable fields",
      "options": [
        {
          "value": "all",
          "label": "All fields"
        },
        {
          "value": "address",
          "label": "Name and address"
        },
        {
          "value": "city",
          "label": "Name, city, region, postcode"
        }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "search_mode",
      "label": "Search behavior",
      "options": [
        {
          "value": "submit",
          "label": "When clicking Search"
        },
        {
          "value": "live",
          "label": "Live while typing"
