    },
    {
      "type": "header",
      "content": "Persistence"
    },
    {
      "type": "select",
      "id": "remember_mode",
      "label": "Remember verification for",
      "options": [
        {
          "value": "session",
          "label": "Session only"
        },
        {
          "value": "1",
          "label": "1 day"
        },
        {
          "value": "3",
          "label": "3 days"
        },
        {
          "value": "7",
          "label": "7 days"
        },
        {
          "value": "14",
          "label": "14 days"
        },
        {
          "value": "30",
          "label": "30 days"
        },
        {
          "value": "90",
          "label": "90 days"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "30"
    },
    {
      "type": "checkbox",
      "id": "show_remember_checkbox",
      "label": "Show remember choice checkbox",
