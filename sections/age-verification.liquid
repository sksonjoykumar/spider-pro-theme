      "default": 30,
      "info": "Number of days for Custom persistence (1–365)."
    },
    {
      "type": "range",
      "id": "gate_version",
      "label": "Gate version",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1,
      "info": "Increase this to ask previously verified visitors to verify again."
