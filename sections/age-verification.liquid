      "default": true
    },
    {
      "type": "header",
      "content": "Age / date of birth"
    },
    {
      "type": "range",
      "id": "minimum_age",
      "label": "Minimum age",
      "min": 13,
      "max": 30,
      "step": 1,
      "default": 18
    },
    {
      "type": "select",
      "id": "dob_order",
      "label": "Date field order",
      "options": [
        {
          "value": "ymd",
          "label": "Year / Month / Day"
        },
        {
          "value": "dmy",
          "label": "Day / Month / Year"
