          "value": "dob",
          "label": "Date of birth"
        }
      ],
      "default": "confirm"
    },
    {
      "type": "select",
      "id": "gate_behavior",
      "label": "Gate behaviour",
      "options": [
        {
          "value": "blocking",
          "label": "Blocking"
        },
        {
          "value": "dismissible",
          "label": "Dismissible"
