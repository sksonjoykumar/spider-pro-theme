{{ 'sp-age-verification.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-age-verification.js' | asset_url }}" defer></script>

{%- liquid
  assign page_eligible = false
  if section.settings.page_target_mode == 'all'
    assign page_eligible = true
  else
    case request.page_type
      when 'index'
        assign page_eligible = section.settings.show_home
      when 'product'
        assign page_eligible = section.settings.show_product
      when 'collection'
        assign page_eligible = section.settings.show_collection
      when 'page'
        assign page_eligible = section.settings.show_page
      when 'blog'
        assign page_eligible = section.settings.show_blog
      when 'article'
        assign page_eligible = section.settings.show_article
      when 'cart'
        assign page_eligible = section.settings.show_cart
      when 'search'
        assign page_eligible = section.settings.show_search
      when '404'
        assign page_eligible = section.settings.show_404
    endcase
  endif

  assign should_render = false
  if section.settings.enable_age_verification and page_eligible
    assign should_render = true
  endif
  if request.design_mode
    assign should_render = true
  endif

  assign image_loading = 'lazy'
  if section.settings.gate_behavior == 'blocking' and section.settings.display_delay == 0
    assign image_loading = 'eager'
  endif

  assign media_desktop = false
  assign media_mobile = false
  if section.settings.enable_left_image and section.settings.image != blank
    assign media_desktop = true
  endif
  if section.settings.enable_left_image and section.settings.mobile_image_layout != 'hidden'
    if section.settings.image_mobile != blank or section.settings.image != blank
      assign media_mobile = true
    endif
  endif
  assign show_effective_close = false
  if section.settings.gate_behavior == 'dismissible' and section.settings.show_close_button
    assign show_effective_close = true
  elsif request.design_mode and section.settings.preview_in_editor
    assign show_effective_close = true
  endif
  assign gate_class = 'sp-age-verification__dialog--centered'
  if section.settings.display_style == 'fullscreen'
    assign gate_class = 'sp-age-verification__dialog--fullscreen'
  endif
-%}

{%- if should_render -%}
  <sp-age-verification
    class="sp-age-verification sp-age-verification--layout-{{ section.settings.content_layout }}{% if media_desktop %} sp-age-verification--desktop-media{% endif %}{% if media_mobile %} sp-age-verification--mobile-media{% endif %} sp-age-verification--mobile-media-{{ section.settings.mobile_image_layout }}{% if section.settings.follow_global_colors %} sp-age-verification--global-colors{% endif %}"
    data-section-id="{{ section.id }}"
    data-page-eligible="{{ page_eligible }}"
    data-design-mode="{{ request.design_mode }}"
    style="
      --sp-age-bg: {% if section.settings.follow_global_colors %}var(--sp-color-background, #fff){% else %}{{ section.settings.background_color }}{% endif %};
      --sp-age-heading: {% if section.settings.follow_global_colors %}var(--sp-color-heading, #171717){% else %}{{ section.settings.heading_color }}{% endif %};
      --sp-age-text: {% if section.settings.follow_global_colors %}var(--sp-color-text, #3f3f46){% else %}{{ section.settings.text_color }}{% endif %};
      --sp-age-muted: {% if section.settings.follow_global_colors %}var(--sp-color-muted, #71717a){% else %}{{ section.settings.muted_text_color }}{% endif %};
      --sp-age-border: {% if section.settings.follow_global_colors %}var(--sp-color-border, #e4e4e7){% else %}{{ section.settings.border_color }}{% endif %};
      --sp-age-input-bg: {{ section.settings.input_background }};
      --sp-age-input-text: {{ section.settings.input_text_color }};
      --sp-age-input-border: {{ section.settings.input_border_color }};
      --sp-age-verify-bg: {% if section.settings.follow_global_colors %}var(--sp-color-accent, #415dff){% else %}{{ section.settings.verify_background }}{% endif %};
      --sp-age-verify-text: {% if section.settings.follow_global_colors %}#ffffff{% else %}{{ section.settings.verify_text_color }}{% endif %};
      --sp-age-verify-border: {% if section.settings.follow_global_colors %}var(--sp-color-accent, #415dff){% else %}{{ section.settings.verify_border_color }}{% endif %};
      --sp-age-exit-bg: {% if section.settings.follow_global_colors %}var(--sp-color-background, #fff){% else %}{{ section.settings.exit_background }}{% endif %};
      --sp-age-exit-text: {% if section.settings.follow_global_colors %}var(--sp-color-heading, #171717){% else %}{{ section.settings.exit_text_color }}{% endif %};
      --sp-age-exit-border: {% if section.settings.follow_global_colors %}var(--sp-color-border, #d6d9df){% else %}{{ section.settings.exit_border_color }}{% endif %};
      --sp-age-overlay: {{ section.settings.overlay_color }};
      --sp-age-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --sp-age-backdrop: {{ section.settings.backdrop_color }};
      --sp-age-backdrop-opacity: {{ section.settings.backdrop_opacity | divided_by: 100.0 }};
      --sp-age-content-width: {{ section.settings.content_width }}px;
      --sp-age-modal-width: {{ section.settings.modal_width }}px;
      --sp-age-radius: {{ section.settings.modal_radius }}px;
      --sp-age-padding-d-y: {{ section.settings.padding_desktop_y }}px;
      --sp-age-padding-d-x: {{ section.settings.padding_desktop_x }}px;
      --sp-age-padding-t-y: {{ section.settings.padding_tablet_y }}px;
      --sp-age-padding-t-x: {{ section.settings.padding_tablet_x }}px;
      --sp-age-padding-m-y: {{ section.settings.padding_mobile_y }}px;
      --sp-age-padding-m-x: {{ section.settings.padding_mobile_x }}px;
      --sp-age-button-radius: {% if section.settings.follow_global_colors %}var(--sp-radius-md, 8px){% else %}{{ section.settings.button_radius }}px{% endif %};
      --sp-age-media-width: {{ section.settings.image_column_width }}%;
      --sp-age-heading-size: {{ section.settings.heading_size_desktop }}px;
      --sp-age-heading-mobile: {{ section.settings.heading_size_mobile }}px;
      --sp-age-body-size: {{ section.settings.description_size }}px;
      --sp-age-button-height: {{ section.settings.button_height }}px;
      --sp-age-image-height-mobile: {{ section.settings.mobile_image_height }}px;
      --sp-age-backdrop-blur: {% if section.settings.enable_backdrop_blur %}{{ section.settings.backdrop_blur }}px{% else %}0px{% endif %};
    "
  >
    <dialog
      id="SpAgeVerification-{{ section.id }}"
      class="sp-age-verification__dialog {{ gate_class }} sp-age-verification__shadow--{{ section.settings.shadow }}"
      aria-labelledby="SpAgeVerificationTitle-{{ section.id }}"
      aria-describedby="SpAgeVerificationDescription-{{ section.id }}"
      data-sp-age-dialog
    >
      <div class="sp-age-verification__shell">
        {% if section.settings.enable_left_image and section.settings.content_layout != 'content' %}
          {% render 'sp-age-verification-media', section: section, loading: image_loading %}
        {% endif %}

        <div class="sp-age-verification__content-wrap">
          {%- if show_effective_close -%}
            <button
              type="button"
              class="sp-age-verification__close"
              data-sp-age-close
              aria-label="Close age verification"
            >
              {% render 'sp-age-verification-icon', name: 'close' %}
            </button>
          {%- endif -%}

          {% render 'sp-age-verification-content', section: section %}
        </div>
      </div>
    </dialog>

    <script type="application/json" data-sp-age-config>
      {
        "sectionId": {{ section.id | json }},
        "enabled": {{ section.settings.enable_age_verification | json }},
        "pageEligible": {{ page_eligible | json }},
        "designMode": {{ request.design_mode | json }},
        "previewInEditor": {{ section.settings.preview_in_editor | json }},
        "method": {{ section.settings.verification_method | json }},
        "gateBehavior": {{ section.settings.gate_behavior | json }},
        "minimumAge": {{ section.settings.minimum_age | json }},
        "displayDelay": {{ section.settings.display_delay | json }},
        "rememberMode": {{ section.settings.remember_mode | json }},
        "rememberCheckbox": {{ section.settings.show_remember_checkbox | json }},
        "customRememberDays": {{ section.settings.custom_remember_days | json }},
        "gateVersion": {{ section.settings.gate_version | json }},
        "underageAction": {{ section.settings.underage_action | json }},
        "underageRedirectUrl": {{ section.settings.underage_redirect_url | json }},
        "underageMessage": {{ section.settings.underage_message | json }},
        "allowEscape": {{ section.settings.allow_escape | json }},
        "allowBackdropClose": {{ section.settings.allow_backdrop_close | json }},
        "currentPath": {{ request.path | json }},
        "rootUrl": {{ routes.root_url | json }}
      }
    </script>
  </sp-age-verification>
{%- endif -%}

{% schema %}
