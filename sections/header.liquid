{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-header.js' | asset_url }}" defer></script>

{% assign sp_scheme = section.settings.sp_color_scheme %}
{% liquid
  assign sp_header_logo_width = section.settings.logo_width
  assign sp_header_mobile_logo_width = section.settings.mobile_logo_width
  assign sp_header_menu_size = section.settings.menu_font_size
  assign sp_header_menu_weight = section.settings.menu_font_weight
  assign sp_header_menu_transform = section.settings.menu_transform
  assign sp_header_menu_tracking = section.settings.menu_letter_spacing
  assign sp_header_height = section.settings.desktop_min_height
  assign sp_header_height_mobile = section.settings.mobile_min_height
  assign sp_header_sticky_mode = section.settings.sticky_mode
  assign sp_header_sticky_behavior = section.settings.sticky_behavior
  assign sp_header_layout = section.settings.desktop_layout
  if section.settings.sp_use_global_header
    assign sp_header_logo_width = settings.header_logo_width
    assign sp_header_mobile_logo_width = settings.header_logo_mobile
    assign sp_header_menu_size = settings.nav_font_size
    assign sp_header_menu_weight = settings.nav_font_weight
    assign sp_header_menu_transform = settings.nav_text_transform
    assign sp_header_menu_tracking = settings.nav_letter_space
    assign sp_header_height = settings.header_height
    assign sp_header_height_mobile = settings.header_height_mobile
    assign sp_header_layout = settings.header_layout | default: 'logo-left'
    if settings.header_sticky
      assign sp_header_sticky_mode = 'all'
      if settings.header_sticky_mode == 'smart'
        assign sp_header_sticky_behavior = 'scroll_up'
      else
        assign sp_header_sticky_behavior = 'always'
      endif
    else
      assign sp_header_sticky_mode = 'none'
      assign sp_header_sticky_behavior = 'always'
    endif
  endif
%}

{% assign sp_menu = section.settings.menu %}
{% assign sp_topbar = nil %}
{% assign sp_contact = nil %}
{% for block in section.blocks %}
  {% if block.type == 'topbar' and sp_topbar == nil %}{% assign sp_topbar = block %}{% endif %}
  {% if block.type == 'contact_information' and sp_contact == nil %}{% assign sp_contact = block %}{% endif %}
{% endfor %}

{% assign sp_menu_alignment = section.settings.menu_position | default: 'center' %}
{% unless sp_menu_alignment == 'left' or sp_menu_alignment == 'center' or sp_menu_alignment == 'right' %}
  {% assign sp_menu_alignment = 'center' %}
{% endunless %}

{% capture sp_header_style %}
  --sp-header-logo-width: {{ sp_header_logo_width | default: 160 }}px;
  --sp-header-logo-mobile-width: {{ sp_header_mobile_logo_width | default: 120 }}px;
  --sp-header-menu-size: {{ sp_header_menu_size | default: 14 }}px;
  --sp-header-mobile-menu-size: {{ section.settings.mobile_menu_font_size | default: 16 }}px;
  --sp-header-menu-gap: {{ section.settings.menu_gap | default: 24 }}px;
  --sp-header-global-icon-size: {{ settings.header_icon_size | default: 22 }}px;
  --sp-header-global-icon-gap: {{ settings.header_icon_gap | default: 16 }}px;
  --sp-header-menu-weight: {{ sp_header_menu_weight | default: '500' }};
  --sp-header-menu-transform: {{ sp_header_menu_transform | default: 'none' }};
  --sp-header-letter-spacing: {{ sp_header_menu_tracking | default: 0.2 }}px;
  --sp-header-min-height: {{ sp_header_height | default: 80 }}px;
  --sp-header-mobile-min-height: {{ sp_header_height_mobile | default: 64 }}px;
  --sp-header-sticky-shadow: {% if section.settings.sp_use_global_header and settings.header_sticky_shadow %}0 8px 26px rgb(0 0 0 / .08){% elsif section.settings.sp_use_global_header %}none{% else %}0 8px 26px rgb(0 0 0 / .08){% endif %};
  --sp-header-pad-y: {{ section.settings.desktop_padding_y | default: 8 }}px;
  --sp-header-pad-x: {{ section.settings.desktop_padding_x | default: 24 }}px;
  --sp-header-mobile-pad-y: {{ section.settings.mobile_padding_y | default: 6 }}px;
  --sp-header-mobile-pad-x: {{ section.settings.mobile_padding_x | default: 12 }}px;
  --sp-header-bg: {{ sp_scheme.settings.background | default: section.settings.background_color | default: settings.sp_background | default: '#ffffff' }};
  --sp-header-gradient: {{ sp_scheme.settings.background_gradient | default: section.settings.background_gradient | default: 'linear-gradient(#ffffff, #ffffff)' }};
  --sp-header-overlay: {{ section.settings.overlay_color | default: '#000000' }};
  --sp-header-overlay-opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};
  --sp-header-menu-color: {{ sp_scheme.settings.heading | default: section.settings.menu_color | default: settings.sp_heading | default: '#171717' }};
  --sp-header-menu-hover: {{ sp_scheme.settings.accent | default: section.settings.menu_hover | default: settings.sp_accent | default: '#415DFF' }};
  --sp-header-menu-active: {{ sp_scheme.settings.accent | default: section.settings.menu_active | default: settings.sp_accent | default: '#415DFF' }};
  --sp-header-icon-color: {{ sp_scheme.settings.heading | default: section.settings.icon_color | default: settings.sp_heading | default: '#171717' }};
  --sp-header-icon-hover: {{ sp_scheme.settings.accent | default: section.settings.icon_hover | default: settings.sp_accent | default: '#415DFF' }};
  --sp-header-icon-text: {{ sp_scheme.settings.text | default: section.settings.icon_text | default: settings.sp_text | default: '#3F3F46' }};
  --sp-header-icon-text-hover: {{ sp_scheme.settings.accent | default: section.settings.icon_text_hover | default: settings.sp_accent | default: '#415DFF' }};
  --sp-header-cart-bg: {{ section.settings.cart_count_bg | default: '#ef4444' }};
  --sp-header-cart-color: {{ section.settings.cart_count_text | default: '#ffffff' }};
  --sp-header-dropdown-bg: {{ sp_scheme.settings.card | default: section.settings.dropdown_bg | default: '#ffffff' }};
  --sp-header-dropdown-link: {{ sp_scheme.settings.text | default: section.settings.dropdown_link | default: '#171717' }};
  --sp-header-dropdown-hover: {{ sp_scheme.settings.background | default: section.settings.dropdown_hover | default: '#f5f5f5' }};
  --sp-header-dropdown-border: {{ sp_scheme.settings.border | default: section.settings.dropdown_border | default: '#E4E4E7' }};
  --sp-header-dropdown-shadow: {% if section.settings.dropdown_shadow %}0 18px 46px rgb(0 0 0 / .12){% else %}none{% endif %};
  --sp-header-border: {{ sp_scheme.settings.border | default: section.settings.border_color | default: '#E4E4E7' }};
  --sp-header-border-size: {{ section.settings.border_thickness | default: 1 }}px;
  --sp-header-search-bg: {{ sp_scheme.settings.card | default: section.settings.search_bg | default: '#ffffff' }};
  --sp-header-search-border: {{ sp_scheme.settings.border | default: section.settings.search_border | default: '#D4D4D8' }};
  --sp-header-search-text: {{ sp_scheme.settings.text | default: section.settings.search_text | default: '#171717' }};
  --sp-header-search-focus: {{ sp_scheme.settings.focus | default: section.settings.search_focus | default: '#2563EB' }};
  --sp-mobile-drawer-custom-width: {% if section.settings.sp_use_global_header %}{{ settings.mobile_menu_width | default: 360 }}{% else %}{{ section.settings.mobile_drawer_custom_width | default: 408 }}{% endif %}px;
  --sp-mobile-drawer-radius: {{ section.settings.mobile_drawer_radius | default: 0 }}px;
  --sp-mobile-drawer-animation: {{ section.settings.mobile_drawer_animation_speed | default: 300 }}ms;
  --sp-mobile-drawer-backdrop-color: {{ '#000000' | default: '#000000' }};
  --sp-mobile-drawer-backdrop-opacity: {{ section.settings.mobile_drawer_backdrop_opacity | default: 40 | divided_by: 100.0 }};
  --sp-mobile-drawer-bg: {{ sp_scheme.settings.card | default: section.settings.mobile_drawer_background | default: '#ffffff' }};
  --sp-mobile-drawer-primary: {{ sp_scheme.settings.text | default: section.settings.mobile_drawer_primary_text | default: '#171717' }};
  --sp-mobile-drawer-secondary: {{ '#666666' | default: '#666666' }};
  --sp-mobile-drawer-hover: {{ '#111111' | default: '#111111' }};
  --sp-mobile-drawer-icon: {{ '#222222' | default: '#222222' }};
  --sp-mobile-drawer-icon-hover: {{ '#111111' | default: '#111111' }};
  --sp-mobile-drawer-divider: {{ sp_scheme.settings.border | default: section.settings.mobile_drawer_divider_color | default: '#E4E4E7' }};
  --sp-mobile-drawer-divider-size: {{ 1 | default: 1 }}px;
  --sp-mobile-drawer-focus: {{ '#111111' | default: '#111111' }};
  --sp-mobile-drawer-header-bg: {{ '#e5e5e5' | default: '#e5e5e5' }};
  --sp-mobile-drawer-header-title: {{ '#222222' | default: '#222222' }};
  --sp-mobile-drawer-header-height: {{ 62 | default: 62 }}px;
  --sp-mobile-drawer-title-size: {{ 16 | default: 16 }}px;
  --sp-mobile-drawer-title-weight: {{ '600' | default: '600' }};
  --sp-mobile-drawer-accent: {{ sp_scheme.settings.accent | default: section.settings.mobile_drawer_accent_color | default: '#415DFF' }};
  --sp-mobile-drawer-accent-size: {{ 2 | default: 2 }}px;
  --sp-mobile-drawer-menu-size: {{ 18 | default: 18 }}px;
  --sp-mobile-drawer-menu-weight: {{ '400' | default: '400' }};
  --sp-mobile-drawer-menu-transform: {% if section.settings.mobile_drawer_menu_transform == 'inherit' or section.settings.mobile_drawer_menu_transform == blank %}var(--sp-header-menu-transform, none){% else %}{{ section.settings.mobile_drawer_menu_transform }}{% endif %};
  --sp-mobile-drawer-menu-row-height: {{ 62 | default: 62 }}px;
  --sp-mobile-drawer-menu-pad-x: {{ 24 | default: 24 }}px;
  --sp-mobile-drawer-utility-icon: {{ 21 | default: 21 }}px;
  --sp-mobile-drawer-utility-height: {{ 62 | default: 62 }}px;
  --sp-mobile-drawer-help-bg: {{ '#ffffff' | default: '#ffffff' }};
  --sp-mobile-drawer-help-heading-size: {{ 16 | default: 16 }}px;
  --sp-mobile-drawer-help-text-size: {{ 14 | default: 14 }}px;
  --sp-mobile-drawer-help-pad-x: {{ 24 | default: 24 }}px;
  --sp-mobile-drawer-help-pad-y: {{ 28 | default: 28 }}px;
  --sp-mobile-drawer-section-gap: {{ 0 | default: 0 }}px;
  --sp-mobile-drawer-bottom-pad: {{ 24 | default: 24 }}px;
  --sp-search-drawer-width: {{ section.settings.search_drawer_width | default: 420 }}px;
  --sp-search-drawer-tablet-width: {{ section.settings.search_drawer_tablet_width | default: 420 }}px;
  --sp-search-drawer-mobile-width: {{ section.settings.search_drawer_mobile_custom_width | default: 360 }}px;
  --sp-search-drawer-radius: {{ section.settings.search_drawer_radius | default: 0 }}px;
  --sp-search-drawer-bg: {{ sp_scheme.settings.card | default: section.settings.search_drawer_background | default: '#ffffff' }};
  --sp-search-drawer-text: {{ sp_scheme.settings.text | default: section.settings.search_drawer_text | default: '#171717' }};
  --sp-search-drawer-heading: {{ sp_scheme.settings.heading | default: section.settings.search_drawer_heading | default: '#171717' }};
  --sp-search-drawer-muted: {{ '#6b7280' | default: '#6b7280' }};
  --sp-search-drawer-border: {{ '#e5e7eb' | default: '#e5e7eb' }};
  --sp-search-drawer-divider: {{ '#e5e7eb' | default: '#e5e7eb' }};
  --sp-search-drawer-focus: {{ sp_scheme.settings.focus | default: section.settings.search_drawer_focus | default: '#2563EB' }};
  --sp-search-drawer-animation: {{ section.settings.search_drawer_animation_speed | default: 300 }}ms;
  --sp-search-drawer-title-size: {{ 18 | default: 18 }}px;
  --sp-search-drawer-header-pad: {{ 22 | default: 22 }}px;
  --sp-search-drawer-pad-x: {{ 28 | default: 28 }}px;
  --sp-search-drawer-pad-y: {{ 24 | default: 24 }}px;
  --sp-search-drawer-mobile-pad-x: {{ 18 | default: 18 }}px;
  --sp-search-drawer-mobile-pad-y: {{ 18 | default: 18 }}px;
  --sp-search-section-gap: {{ 28 | default: 28 }}px;
  --sp-search-result-gap: {{ 14 | default: 14 }}px;
  --sp-search-scope-height: {{ 48 | default: 48 }}px;
  --sp-search-scope-radius: {{ 24 | default: 24 }}px;
  --sp-search-scope-bg: {{ '#ffffff' | default: '#ffffff' }};
  --sp-search-scope-text: {{ '#111111' | default: '#111111' }};
  --sp-search-scope-border: {{ '#d1d5db' | default: '#d1d5db' }};
  --sp-search-scope-focus: {{ '#111111' | default: '#111111' }};
  --sp-search-input-height: {{ section.settings.search_input_height | default: 50 }}px;
  --sp-search-input-radius: {{ section.settings.search_input_radius | default: 24 }}px;
  --sp-search-input-size: {{ section.settings.search_input_font_size | default: 15 }}px;
  --sp-search-input-mobile-size: {{ section.settings.search_mobile_input_font_size | default: 16 }}px;
  --sp-search-input-bg: {{ '#ffffff' | default: '#ffffff' }};
  --sp-search-input-border: {{ '#d1d5db' | default: '#d1d5db' }};
  --sp-search-input-focus: var(--sp-form-focus, #415DFF);
  --sp-search-input-text: {{ '#111111' | default: '#111111' }};
  --sp-search-input-placeholder: {{ '#6b7280' | default: '#6b7280' }};
  --sp-search-input-icon: {{ '#111111' | default: '#111111' }};
  --sp-search-clear-icon: {{ '#6b7280' | default: '#6b7280' }};
  --sp-search-product-image-size: {{ section.settings.search_product_image_size | default: 72 }}px;
  --sp-search-product-image-radius: {{ section.settings.search_product_image_radius | default: 8 }}px;
  --sp-search-result-title: {{ '#111111' | default: '#111111' }};
  --sp-search-result-title-hover: {{ '#555555' | default: '#555555' }};
  --sp-search-result-vendor: {{ '#6b7280' | default: '#6b7280' }};
  --sp-search-result-price: {{ '#111111' | default: '#111111' }};
  --sp-search-result-compare: {{ '#9ca3af' | default: '#9ca3af' }};
  --sp-search-result-sale: {{ '#b42318' | default: '#b42318' }};
  --sp-search-result-title-size: {{ 14 | default: 14 }}px;
  --sp-search-section-title-size: {{ 12 | default: 12 }}px;
  --sp-search-chip-bg: {{ '#f5f5f5' | default: '#f5f5f5' }};
  --sp-search-chip-text: {{ '#111111' | default: '#111111' }};
  --sp-search-chip-hover-bg: {{ '#111111' | default: '#111111' }};
  --sp-search-chip-hover-text: {{ '#ffffff' | default: '#ffffff' }};
  --sp-search-chip-border: {{ '#e5e7eb' | default: '#e5e7eb' }};
  --sp-search-chip-radius: {{ section.settings.search_chip_radius | default: 999 }}px;
  --sp-search-chip-gap: {{ 8 | default: 8 }}px;
{% endcapture %}

{% if section.settings.background_image != blank %}
  {% assign sp_header_bg_image = section.settings.background_image | image_url: width: 2400 %}
{% endif %}

<sp-header
  class="sp-header sp-header--premium"
  data-section-id="{{ section.id }}"
  data-search-url="{{ routes.search_url }}"
  data-cart-section
  data-sp-header
  data-layout="{{ sp_header_layout | default: 'logo-left' }}"
  data-menu-position="{{ sp_menu_alignment }}"
  data-dropdown-mode="{{ section.settings.dropdown_open | default: 'hover' }}"
  data-sticky="{{ sp_header_sticky_mode | default: 'all' }}"
  data-sticky-behavior="{{ sp_header_sticky_behavior | default: 'always' }}"
  data-design-mode="{{ request.design_mode }}"
  data-open-mega-editor="{{ section.settings.open_mega_editor }}"
  data-cart-editor-preview="{{ section.settings.cart_open_editor }}"
  data-background-width="{{ section.settings.background_width | default: 'full' }}"
  data-width="{{ section.settings.width | default: 'default' }}"
  data-mobile-labels="{{ section.settings.mobile_action_labels | default: 'icons' }}"
  data-reference-search-pill="{{ section.settings.sp_reference_search_pill }}"
  style="{{ sp_header_style | strip_newlines | strip }}{% if sp_header_bg_image %} --sp-header-bg-image: url('{{ sp_header_bg_image }}');{% endif %}"
>
  {% if sp_topbar %}{% render 'sp-header-topbar', block: sp_topbar, section: section %}{% endif %}
  <div class="sp-header__background" data-bg-type="{{ section.settings.background_type | default: 'color' }}" data-bg-position="{{ section.settings.background_position | default: 'center' }}" data-bg-size="{{ section.settings.background_size | default: 'cover' }}" aria-hidden="true"></div>

  <div class="sp-header__surface{% if section.settings.border_top %} has-top-border{% endif %}{% if section.settings.border_bottom %} has-bottom-border{% endif %}" data-border-width="{{ section.settings.border_width | default: 'full' }}">
    <div class="sp-header__container{% if section.settings.width == 'wide' %} sp-header__container--wide{% elsif section.settings.width == 'full' %} sp-header__container--full{% elsif section.settings.width == 'boxed' %} sp-header__container--boxed{% else %} sp-header__container--default{% endif %}">
      <div class="sp-header__desktop" data-sp-header-desktop>
        {% case sp_header_layout %}
          {% when 'logo-center' %}
            <div class="sp-header__desktop-row sp-header__desktop-row--center-logo">
              <div class="sp-header__slot sp-header__slot--nav">{% render 'sp-header-nav', section: section, menu: sp_menu, part: 'all' %}</div>
              <div class="sp-header__slot sp-header__slot--logo">{% render 'sp-header-logo', section: section %}</div>
              <div class="sp-header__slot sp-header__slot--actions">{% render 'sp-header-actions', section: section, contact_block: sp_contact, instance: 'main' %}</div>
            </div>
          {% when 'split-menu' %}
            <div class="sp-header__desktop-row sp-header__desktop-row--split" data-sp-split-layout>
              <div class="sp-header__slot sp-header__slot--split-left">{% render 'sp-header-nav', section: section, menu: sp_menu, part: 'before' %}</div>
              <div class="sp-header__slot sp-header__slot--logo">{% render 'sp-header-logo', section: section %}</div>
              <div class="sp-header__split-right-zone">
                <div class="sp-header__slot sp-header__slot--split-right">{% render 'sp-header-nav', section: section, menu: sp_menu, part: 'after' %}</div>
                <div class="sp-header__slot sp-header__slot--actions">{% render 'sp-header-actions', section: section, contact_block: sp_contact, instance: 'split' %}</div>
              </div>
            </div>
          {% when 'menu-below-left' %}
            <div class="sp-header__desktop-row sp-header__desktop-row--brand-actions">
              <div class="sp-header__slot sp-header__slot--logo">{% render 'sp-header-logo', section: section %}</div>
              <div class="sp-header__slot sp-header__slot--actions">{% render 'sp-header-actions', section: section, contact_block: sp_contact, instance: 'below-left' %}</div>
            </div>
            <div class="sp-header__desktop-row sp-header__desktop-row--nav-below sp-header__desktop-row--nav-left">{% render 'sp-header-nav', section: section, menu: sp_menu, part: 'all' %}</div>
          {% when 'menu-below-center' %}
            <div class="sp-header__desktop-row sp-header__desktop-row--brand-actions sp-header__desktop-row--brand-center">
              <div class="sp-header__slot sp-header__slot--logo">{% render 'sp-header-logo', section: section %}</div>
              <div class="sp-header__slot sp-header__slot--actions">{% render 'sp-header-actions', section: section, contact_block: sp_contact, instance: 'below-center' %}</div>
            </div>
            <div class="sp-header__desktop-row sp-header__desktop-row--nav-below sp-header__desktop-row--nav-center">{% render 'sp-header-nav', section: section, menu: sp_menu, part: 'all' %}</div>
          {% else %}
            <div class="sp-header__desktop-row sp-header__desktop-row--logo-left">
              <div class="sp-header__slot sp-header__slot--logo">{% render 'sp-header-logo', section: section %}</div>
              <div class="sp-header__slot sp-header__slot--nav">{% render 'sp-header-nav', section: section, menu: sp_menu, part: 'all' %}</div>
              <div class="sp-header__slot sp-header__slot--actions">{% render 'sp-header-actions', section: section, contact_block: sp_contact, instance: 'logo-left' %}</div>
            </div>
        {% endcase %}

      </div>

      <div class="sp-header__mobile" data-sp-header-mobile>
        {% render 'sp-header-mobile', section: section, menu: sp_menu, contact_block: sp_contact %}
      </div>
    </div>
  </div>

  {% comment %} Search overlay migrated to independent System Group / search-modal section. {% endcomment %}
</sp-header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "sp-header-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Global design system"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Shared Spider color panel. Edit schemes once in Theme settings → Spider Color Schemes."
    },
    {
      "type": "checkbox",
      "id": "sp_use_global_header",
      "label": "Use global Header settings",
      "default": true,
      "info": "Uses Theme settings for logo size, header height, navigation typography and sticky behavior. Turn off to use the detailed controls in this Header section."
    },
    {
      "type": "header",
      "content": "GENERAL, BRANDING & LAYOUT"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Header width",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "boxed",
          "label": "Boxed"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Enable sticky header",
      "default": "all",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "all",
          "label": "All screens"
        }
      ]
    },
    {
      "type": "select",
      "id": "sticky_behavior",
      "label": "Sticky behaviour",
      "default": "always",
      "options": [
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "scroll_up",
          "label": "On scroll up"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Desktop logo image"
    },
    {
      "type": "textarea",
      "id": "logo_svg",
      "label": "Optional SVG logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 130
    },
    {
      "type": "checkbox",
      "id": "logo_zoom",
      "label": "Zoom effect on hover",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile logo image"
    },
    {
      "type": "textarea",
      "id": "mobile_logo_svg",
      "label": "Optional mobile SVG"
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 30,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 110
    },
    {
