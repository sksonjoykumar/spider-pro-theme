    },
    {
      "type": "checkbox",
      "id": "show_mobile_icon",
      "label": "Show cookie icon on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "color",
      "id": "accept_bg",
      "label": "Accept background",
      "default": "#52C7D9"
    },
    {
      "type": "color",
      "id": "accept_text",
      "label": "Accept text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accept_hover_bg",
      "label": "Accept hover background",
      "default": "#35B5CA"
    },
    {
      "type": "color",
      "id": "decline_bg",
      "label": "Decline background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "decline_text",
      "label": "Decline text",
      "default": "#26282B"
    },
    {
      "type": "color",
      "id": "decline_border",
      "label": "Decline border",
      "default": "#AEB1B6"
    },
    {
      "type": "color",
      "id": "manage_bg",
      "label": "Manage background",
      "default": "#F4F5F7"
    },
    {
      "type": "color",
      "id": "manage_text",
      "label": "Manage text",
      "default": "#303238"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "background_opacity",
