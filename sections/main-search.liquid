        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "header",
      "content": "Article and page results"
    },
    {
      "type": "checkbox",
      "id": "article_show_image",
      "label": "Show article image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "label": "Show article date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "article_show_excerpt",
      "label": "Show article excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "page_show_excerpt",
      "label": "Show page excerpt",
      "default": true
