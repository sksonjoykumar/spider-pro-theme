      "id": "results_per_page",
      "label": "Results per page",
      "default": 24,
      "min": 8,
      "max": 48,
      "step": 4
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination type",
      "default": "pagination",
      "options": [
        {
          "value": "pagination",
          "label": "Pagination"
        },
        {
          "value": "load_more",
          "label": "Load more"
        }
      ]
    },
    {
      "type": "header",
      "content": "Empty search discovery"
    },
    {
      "type": "text",
      "id": "empty_intro",
      "label": "Intro text",
      "default": "Find products, articles and more."
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading",
      "default": "What are you looking for?"
    },
    {
      "type": "text",
