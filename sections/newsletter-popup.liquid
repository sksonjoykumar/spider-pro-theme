      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "agreement_text",
      "label": "Agreement text",
      "default": "I agree to receive marketing emails.",
      "visible_if": "{{ section.settings.require_agreement }}"
    },
    {
      "type": "select",
      "id": "form_layout",
      "label": "Form layout",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "input_height",
