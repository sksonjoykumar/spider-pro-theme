{%- liquid
  assign spec_product = product | default: section.settings.selected_product
  assign image_to_use = section.settings.custom_product_image | default: spec_product.featured_image
  assign product_title = spec_product.title | default: section.settings.custom_product_title
  assign image_alt = section.settings.product_image_alt | default: product_title
  assign default_active_group_key = section.settings.default_active_group | handleize
  assign model = section.settings.custom_model
  if section.settings.model_source == 'metafield' and spec_product != blank and section.settings.model_metafield_namespace != blank and section.settings.model_metafield_key != blank
    assign model_field = spec_product.metafields[section.settings.model_metafield_namespace][section.settings.model_metafield_key]
    if model_field != blank
      assign model = model_field.value
    endif
  endif
  assign product_variant = spec_product.selected_or_first_available_variant
  assign container = 'sp-container'
  if section.settings.section_max_width == 'wide'
    assign container = 'sp-container sp-container--wide'
  elsif section.settings.section_max_width == 'narrow'
    assign container = 'sp-container sp-container--narrow'
  endif
  assign first_group_id = ''
  assign preferred_group_id = ''
  assign group_count = 0
  assign seen_groups = '|'
  for group in section.blocks
    if group.type == 'specification_group'
      assign group_handle = group.settings.group_key | handleize
      assign group_token = '|' | append: group_handle | append: '|'
      if seen_groups contains group_token
        continue
      endif
      assign seen_groups = seen_groups | append: group_handle | append: '|'
      capture potential_rows
        for candidate in section.blocks
          if candidate.type == 'specification'
            assign candidate_group = candidate.settings.group_key | handleize
            if candidate_group == group_handle
              render 'sp-specification-row', block: candidate, spec_product: spec_product, mode: 'table'
            endif
          endif
        endfor
      endcapture
      assign potential_rows = potential_rows | strip
      if potential_rows != blank
        assign group_count = group_count | plus: 1
        if first_group_id == ''
          assign first_group_id = group.id
        endif
        if group_handle == default_active_group_key
          assign preferred_group_id = group.id
        endif
      endif
    endif
  endfor
  if preferred_group_id != ''
    assign first_group_id = preferred_group_id
  endif
-%}
{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-product-specifications-table.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-product-specifications-table.js' | asset_url }}" defer="defer"></script>
<section id="SpSpecs-{{ section.id }}" class="sp-section sp-specs sp-specs--{{ section.settings.layout_style }} sp-specs--mobile-{{ section.settings.mobile_table_style }}{% unless section.settings.show_product_summary %} sp-specs--no-product{% endunless %}{% if section.settings.alternating_rows %} sp-specs--striped{% endif %}{% if section.settings.card_shadow %} sp-specs--shadow{% endif %}" data-sp-product-specifications data-sp-layout="{{ section.settings.layout_style }}" data-sp-accordion-mode="{{ section.settings.accordion_mode }}" data-sp-section-id="{{ section.id }}"{% if group_count == 0 and request.design_mode == false %} hidden{% endif %}
  style="--sp-specs-top:{% if section.settings.use_global_spacing %}var(--sp-section-pad-top, var(--sp-section-space-d, 72px)){% else %}{{ section.settings.padding_top }}px{% endif %};--sp-specs-bottom:{% if section.settings.use_global_spacing %}var(--sp-section-pad-bottom, var(--sp-section-space-d, 72px)){% else %}{{ section.settings.padding_bottom }}px{% endif %};--sp-specs-top-t:{% if section.settings.use_global_spacing %}var(--sp-section-space-t, 56px){% else %}{{ section.settings.padding_top_tablet }}px{% endif %};--sp-specs-bottom-t:{% if section.settings.use_global_spacing %}var(--sp-section-space-t, 56px){% else %}{{ section.settings.padding_bottom_tablet }}px{% endif %};--sp-specs-top-m:{% if section.settings.use_global_spacing %}var(--sp-section-pad-mobile, var(--sp-section-space-m, 40px)){% else %}{{ section.settings.padding_top_mobile }}px{% endif %};--sp-specs-bottom-m:{% if section.settings.use_global_spacing %}var(--sp-section-pad-mobile, var(--sp-section-space-m, 40px)){% else %}{{ section.settings.padding_bottom_mobile }}px{% endif %};--sp-specs-radius:{% if section.settings.use_global_radius %}var(--sp-radius-lg, 16px){% else %}{{ section.settings.table_border_radius }}px{% endif %};--sp-specs-label-width:{{ section.settings.label_column_width }}%;--sp-specs-cell-padding:{{ section.settings.cell_padding_desktop }}px;--sp-specs-cell-padding-m:{{ section.settings.cell_padding_mobile }}px;--sp-specs-columns-d:{{ section.settings.desktop_columns }};--sp-specs-columns-t:{{ section.settings.tablet_columns }};--sp-specs-columns-m:{{ section.settings.mobile_columns }};--sp-specs-card-gap:{{ section.settings.row_spacing }}px;--sp-specs-panel-width:{{ section.settings.product_panel_width }}%;--sp-specs-border-width:{{ section.settings.table_border_width }}px;--sp-specs-border-color:{% if section.settings.use_scheme_border %}var(--sp-section-border, var(--sp-color-border, #e4e4e7)){% else %}{{ section.settings.table_border_color }}{% endif %};--sp-specs-card-bg:{% if section.settings.use_scheme_card %}var(--sp-section-card, var(--sp-color-card, #fff)){% else %}{{ section.settings.table_background }}{% endif %};">
 <div class="{{ container }}">
  {% if section.settings.show_header %}
    <div class="sp-specs__header sp-specs__header--{{ section.settings.heading_alignment }}">
      {% if section.settings.eyebrow != blank %}<p class="sp-eyebrow sp-specs__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% render 'sp-section-heading', heading: section.settings.heading, subheading: section.settings.description, heading_tag: 'h2', alignment: section.settings.heading_alignment, mobile_alignment: 'center', typography_source: 'global', bottom_spacing: 0 %}
    </div>
  {% endif %}
  <div class="sp-specs__shell">
    {% if section.settings.show_product_summary %}
      <div class="sp-specs__product-summary{% if section.settings.layout_style == 'style_5' and section.settings.product_panel_sticky %} sp-specs__product-summary--sticky{% endif %}" data-sp-product-summary>
        <div class="sp-specs__product-identity">
          {% if section.settings.show_product_image and image_to_use != blank %}
            <div class="sp-specs__product-image">{% render 'responsive-image', image: image_to_use, widths: '120,180,240,360,480', sizes: '(max-width: 749px) 80px, 110px', loading: 'lazy', alt: image_alt %}</div>
          {% elsif request.design_mode and section.settings.show_product_image %}
            <div class="sp-specs__product-image sp-specs__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
          {% endif %}
          <div class="sp-specs__product-meta">
            {% if section.settings.show_product_title and product_title != blank %}<h3>{{ product_title | escape }}</h3>{% elsif request.design_mode and section.settings.show_product_title %}<h3>Preview product</h3>{% endif %}
            {% if section.settings.show_model and model != blank %}<span>{{ model | escape }}</span>{% endif %}
            {% if section.settings.show_vendor and spec_product.vendor != blank %}<span>{{ spec_product.vendor | escape }}</span>{% endif %}
            {% if section.settings.show_sku and product_variant.sku != blank %}<span data-sp-spec-field="sku">{{ product_variant.sku | escape }}</span>{% endif %}
            {% if section.settings.show_variant_title and product_variant.title != blank and product_variant.title != 'Default Title' %}<span>{{ product_variant.title | escape }}</span>{% endif %}
            {% if section.settings.show_product_link and spec_product.url != blank %}<a href="{{ spec_product.url }}">{{ section.settings.product_link_label | escape }}</a>{% endif %}
          </div>
        </div>
        <div class="sp-specs__actions">
          {% if section.settings.show_download_button and section.settings.download_file_url != blank %}
            {% capture dl_label %}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ section.settings.download_button_label | escape }}{% endcapture %}
            {% capture dl_attrs %}{% if section.settings.download_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}{% if section.settings.force_download_when_supported %} download{% endif %}{% endcapture %}
            {% render 'button', label: dl_label, href: section.settings.download_file_url, style: section.settings.download_button_style, class: 'sp-specs__download', attributes: dl_attrs %}
          {% endif %}
          {% if section.settings.show_print_button %}<button type="button" class="sp-button sp-button--secondary sp-specs__print" data-sp-spec-print>{{ section.settings.print_button_label | escape }}</button>{% endif %}
        </div>
      </div>
    {% endif %}
    <div class="sp-specs__content">
      {% if section.settings.layout_style == 'style_1' and group_count > 0 %}
        <div class="sp-specs__tabs" role="tablist" aria-label="Specification groups">
          {% assign seen_tab_keys = '|' %}
          {% for block in section.blocks %}{% if block.type == 'specification_group' %}
            {% assign block_key = block.settings.group_key | handleize %}
            {% assign block_token = '|' | append: block_key | append: '|' %}
            {% unless seen_tab_keys contains block_token %}
              {% assign seen_tab_keys = seen_tab_keys | append: block_key | append: '|' %}
            {% capture eligible_rows %}{% for candidate in section.blocks %}{% if candidate.type == 'specification' %}{% assign candidate_key = candidate.settings.group_key | handleize %}{% if candidate_key == block_key %}{% render 'sp-specification-row', block: candidate, spec_product: spec_product, mode: 'table' %}{% endif %}{% endif %}{% endfor %}{% endcapture %}
            {% assign eligible_rows = eligible_rows | strip %}
            {% if eligible_rows != blank %}
              {% assign tab_active = false %}{% if block.id == first_group_id %}{% assign tab_active = true %}{% endif %}
              <button class="sp-specs__tab" type="button" role="tab" id="SpSpecsTab-{{ section.id }}-{{ block.id }}" aria-controls="SpSpecsPanel-{{ section.id }}-{{ block.id }}" aria-selected="{{ tab_active }}" tabindex="{% if tab_active %}0{% else %}-1{% endif %}" data-sp-spec-tab="{{ block.id }}">{{ block.settings.group_label | escape }}</button>
            {% endif %}
            {% endunless %}
          {% endif %}{% endfor %}
        </div>
      {% endif %}
      <div class="sp-specs__groups">
        {% assign group_position = 0 %}
        {% assign seen_rendered_groups = '|' %}
        {% for group in section.blocks %}{% if group.type == 'specification_group' %}
          {% assign active_group_key = group.settings.group_key | handleize %}
          {% assign active_group_token = '|' | append: active_group_key | append: '|' %}
          {% unless seen_rendered_groups contains active_group_token %}
          {% assign seen_rendered_groups = seen_rendered_groups | append: active_group_key | append: '|' %}
          {% assign group_position = group_position | plus: 1 %}
          {% assign group_active = false %}{% if group.id == first_group_id %}{% assign group_active = true %}{% endif %}
          {% assign is_first_group = false %}{% if group_position == 1 %}{% assign is_first_group = true %}{% endif %}
          {% render 'sp-specification-table', group: group, spec_product: spec_product, section: section, active: group_active, for_first: is_first_group %}
          {% endunless %}
        {% endif %}{% endfor %}
      </div>
    </div>
    {% if section.settings.show_information_notice and section.settings.notice_text != blank %}
      <div class="sp-specs__notice" role="note"><span class="sp-specs__notice-icon" aria-hidden="true">i</span><div class="rte">{{ section.settings.notice_text }}</div></div>
    {% endif %}
  </div>
 </div>
</section>
{% schema %}
{
  "name": "Product Specs Table",
  "tag": "section",
  "class": "sp-product-specifications-table-wrapper",
    "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
