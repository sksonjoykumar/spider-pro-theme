{{ 'sp-collection-spotlight.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-collection-spotlight.js' | asset_url }}" defer="defer"></script>

{% render 'sp-section-color-scheme', section: section %}

{%- liquid
  assign spotlight_collection = section.settings.collection
  assign spotlight_products = spotlight_collection.products
  assign product_limit = section.settings.products_to_show | default: 8
  assign product_count = 0
  if spotlight_products != blank
    assign product_count = spotlight_products.size | at_most: product_limit
  endif

  assign heading = section.settings.heading
  if heading == blank and section.settings.use_collection_title and spotlight_collection != blank
    assign heading = spotlight_collection.title
  endif

  assign button_url = section.settings.button_link
  if button_url == blank and spotlight_collection != blank
    assign button_url = spotlight_collection.url
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and spotlight_collection != blank
    assign view_all_url = spotlight_collection.url
  endif

  assign desktop_image = section.settings.image
  if desktop_image == blank and spotlight_collection != blank
    assign desktop_image = spotlight_collection.featured_image
  endif
  assign mobile_image = section.settings.mobile_image

  # A mobile image may be the only supplied image. Use it as the picture fallback
  # when there is no desktop or collection image, so the section never stays blank.
  assign fallback_image = desktop_image
  if fallback_image == blank and mobile_image != blank
    assign fallback_image = mobile_image
  endif
  if mobile_image == blank
    assign mobile_image = fallback_image
  endif

  assign desktop_position = '50% 50%'
  if desktop_image != blank and desktop_image.presentation.focal_point != blank
    assign desktop_position = desktop_image.presentation.focal_point
  endif
  assign mobile_position = desktop_position
  if mobile_image != blank and mobile_image.presentation.focal_point != blank
    assign mobile_position = mobile_image.presentation.focal_point
  endif

  assign image_alt = section.settings.image_alt
  if image_alt == blank and fallback_image != blank
    assign image_alt = fallback_image.alt
  endif

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if section.index <= 2
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign container_class = 'sp-container'
  assign container_width = settings.sp_container_width | default: 1280
  if section.settings.section_width == 'wide'
    assign container_class = 'sp-container sp-container--wide'
    assign container_width = settings.sp_wide_width | default: 1600
  elsif section.settings.section_width == 'full'
    assign container_class = 'sp-collection-spotlight__container--full'
    assign container_width = 1920
  endif

  assign cols_d = section.settings.products_desktop | plus: 0
  assign cols_t = section.settings.products_tablet | plus: 0
  assign cols_m = section.settings.products_mobile | plus: 0
  assign desktop_gutter = settings.sp_page_gutter_d | default: 32 | times: 2
  assign tablet_gutter = settings.sp_page_gutter_d | default: 32 | times: 2
  assign mobile_gutter = settings.sp_page_gutter_m | default: 20 | times: 2
  capture product_sizes
    echo '(min-width: 1100px) calc((min(52vw, ' | append: container_width | append: 'px) - ' | append: desktop_gutter | append: 'px) / ' | append: cols_d | append: '), '
    echo '(min-width: 750px) calc((100vw - ' | append: tablet_gutter | append: 'px) / ' | append: cols_t | append: '), '
    echo 'calc((100vw - ' | append: mobile_gutter | append: 'px) / ' | append: cols_m | append: ')'
  endcapture

  assign card_design = section.settings.product_card_design
  if card_design == 'global'
    assign card_design = blank
  endif

  assign prev_label = 'accessibility.slider.previous_slide' | t
  assign next_label = 'accessibility.slider.next_slide' | t
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .sp-collection-spotlight {
    --sp-cs-media-position-d: {{ desktop_position }};
    --sp-cs-media-position-m: {{ mobile_position }};
    --sp-cs-media-ratio-d: {{ section.settings.image_ratio_desktop }};
    --sp-cs-media-ratio-m: {{ section.settings.image_ratio_mobile }};
    --sp-cs-split: {{ section.settings.image_width }}%;
    --sp-cs-radius: {% if section.settings.corner_radius == 0 %}var(--sp-radius-lg, 16px){% else %}{{ section.settings.corner_radius }}px{% endif %};
    --sp-cs-gap-d: {{ section.settings.product_gap_desktop }}px;
    --sp-cs-gap-t: {{ section.settings.product_gap_tablet }}px;
    --sp-cs-gap-m: {{ section.settings.product_gap_mobile }}px;
    --sp-cs-peek-m: {% if section.settings.show_next_card_peek %}{{ section.settings.mobile_peek }}px{% else %}0px{% endif %};
    --sp-cs-overlay-opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    --sp-cs-pad-top-d: {{ section.settings.padding_top_desktop }}px;
    --sp-cs-pad-bottom-d: {{ section.settings.padding_bottom_desktop }}px;
    --sp-cs-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --sp-cs-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
  }
{%- endstyle -%}

<sp-collection-spotlight
  class="sp-section sp-collection-spotlight sp-collection-spotlight--image-{{ section.settings.image_position }}{% if section.settings.show_arrows == false %} sp-collection-spotlight--no-arrows{% endif %}"
  data-section-id="{{ section.id }}"
  data-sp-product-section
  data-money-format="{{ shop.money_with_currency_format | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
>
  <div class="{{ container_class }} sp-collection-spotlight__container">
    <div class="sp-collection-spotlight__layout">
      <div class="sp-collection-spotlight__media" data-sp-animate>
        {%- if fallback_image != blank -%}
          <picture class="sp-collection-spotlight__picture">
            {%- if mobile_image != blank and mobile_image.id != fallback_image.id -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 900 }} 900w"
                sizes="100vw"
              >
            {%- endif -%}
            {{ fallback_image
              | image_url: width: 2000
              | image_tag:
                class: 'sp-collection-spotlight__image',
                widths: '550, 750, 900, 1100, 1280, 1440, 1600, 1800, 2000',
                sizes: '(min-width: 990px) 48vw, 100vw',
                loading: image_loading,
                fetchpriority: image_fetchpriority,
                alt: image_alt
            }}
          </picture>
        {%- else -%}
          <div class="sp-collection-spotlight__placeholder" role="img" aria-label="Collection lifestyle image placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'sp-collection-spotlight__placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_image_overlay -%}
          <span class="sp-collection-spotlight__media-shade" aria-hidden="true"></span>
        {%- endif -%}

        {%- if section.settings.show_editorial_overlay and section.settings.editorial_heading != blank -%}
          <div class="sp-collection-spotlight__editorial sp-collection-spotlight__editorial--{{ section.settings.editorial_position }}">
            <p class="sp-collection-spotlight__editorial-heading">{{ section.settings.editorial_heading | newline_to_br }}</p>
            {%- if section.settings.editorial_text != blank -%}
              <p class="sp-collection-spotlight__editorial-text">{{ section.settings.editorial_text | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
          <div class="sp-collection-spotlight__badge" aria-label="{{ section.settings.badge_text | strip_newlines | escape }}">
            <span>{{ section.settings.badge_text | newline_to_br }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="sp-collection-spotlight__panel">
        <div class="sp-collection-spotlight__intro" data-sp-animate>
          <div class="sp-collection-spotlight__copy">
            {%- if section.settings.eyebrow != blank -%}
              <p class="sp-collection-spotlight__eyebrow">
                <span>{{ section.settings.eyebrow | escape }}</span>
                {%- if section.settings.show_eyebrow_line -%}<i aria-hidden="true"></i>{%- endif -%}
              </p>
            {%- endif -%}

            {%- if heading != blank -%}
              <{{ heading_tag }} class="sp-heading sp-collection-spotlight__heading">{{ heading | escape }}</{{ heading_tag }}>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
              <div class="sp-collection-spotlight__description rte">{{ section.settings.description }}</div>
            {%- endif -%}

            {%- if section.settings.button_label != blank and button_url != blank -%}
              <a class="sp-button sp-button--{{ section.settings.button_style }} sp-collection-spotlight__button" href="{{ button_url }}">
                <span>{{ section.settings.button_label | escape }}</span>
                {%- if section.settings.show_button_arrow -%}{% render 'icon', name: 'chevron-right', class: 'sp-collection-spotlight__button-icon' %}{%- endif -%}
              </a>
            {%- endif -%}
          </div>

          {%- if section.settings.show_features -%}
            <ul class="sp-collection-spotlight__features" role="list">
              {%- for block in section.blocks -%}
                <li class="sp-collection-spotlight__feature" {{ block.shopify_attributes }}>
                  <span class="sp-collection-spotlight__feature-icon" aria-hidden="true">
                    {% render 'icon', name: block.settings.icon %}
                  </span>
                  <div>
                    {%- if block.settings.heading != blank -%}<p class="sp-collection-spotlight__feature-heading">{{ block.settings.heading | escape }}</p>{%- endif -%}
                    {%- if block.settings.text != blank -%}<p class="sp-collection-spotlight__feature-text">{{ block.settings.text | escape }}</p>{%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {%- if product_count > 0 -%}
          <div class="sp-collection-spotlight__products" data-sp-animate>
            <div class="sp-collection-spotlight__products-header">
              {%- if section.settings.products_heading != blank -%}
                <h3 class="sp-collection-spotlight__products-heading">{{ section.settings.products_heading | escape }}</h3>
              {%- endif -%}
              {%- if section.settings.show_view_all and section.settings.view_all_label != blank and view_all_url != blank -%}
                <a class="sp-collection-spotlight__view-all" href="{{ view_all_url }}">
                  <span>{{ section.settings.view_all_label | escape }}</span>
                  {% render 'icon', name: 'chevron-right' %}
                </a>
              {%- endif -%}
            </div>

            <div
              class="sp-collection-spotlight__carousel sp-carousel-block"
              data-sp-collection-spotlight-carousel
              data-cols-desktop="{{ section.settings.products_desktop }}"
              data-cols-tablet="{{ section.settings.products_tablet }}"
              data-cols-mobile="{{ section.settings.products_mobile }}"
              data-peek="{{ section.settings.show_next_card_peek }}"
              data-loop="false"
              data-autoplay="false"
              data-drag="true"
              data-outside-opacity="false"
              data-design-mode="{{ request.design_mode }}"
              data-pagination-style="default"
              aria-roledescription="carousel"
              aria-label="{{ section.settings.products_heading | default: heading | default: 'Featured products' | escape }}"
            >
              <div class="sp-collection-spotlight__viewport" data-sp-carousel-viewport tabindex="0">
                <div class="sp-collection-spotlight__track sp-carousel-track" data-sp-carousel-track>
                  {%- for product in spotlight_products limit: product_limit -%}
                    {% render 'sp-product-card',
                      product: product,
                      context: 'collection-spotlight',
                      section_id: section.id,
                      instance_id: section.id,
                      design: card_design,
                      sizes: product_sizes,
                      product_index: forloop.index,
                      section_index: section.index
                    %}
                  {%- endfor -%}
                </div>
              </div>

              {%- if section.settings.show_arrows -%}
                <div class="sp-collection-spotlight__navigation" aria-label="Product carousel navigation">
                  {% render 'icon-button', label: prev_label, icon: 'chevron-left', class: 'sp-collection-spotlight__arrow', attributes: 'data-sp-carousel-prev' %}
                  {% render 'icon-button', label: next_label, icon: 'chevron-right', class: 'sp-collection-spotlight__arrow', attributes: 'data-sp-carousel-next' %}
                </div>
              {%- endif -%}
            </div>

            {%- if section.settings.footer_text != blank -%}
              <p class="sp-collection-spotlight__footer-text">{{ section.settings.footer_text | escape }}</p>
            {%- endif -%}
          </div>
        {%- elsif request.design_mode -%}
          <div class="sp-collection-spotlight__empty" role="status" data-sp-animate>
            {% render 'icon', name: 'cart' %}
            <div><strong>Select a collection</strong><span>Products from that collection will appear here automatically.</span></div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</sp-collection-spotlight>

{% schema %}
{
  "name": "Collection Spotlight",
  "tag": "section",
  "class": "sp-section-collection-spotlight",
  "disabled_on": { "groups": ["header", "footer", "custom.system"] },
  "settings": [
    { "type": "header", "content": "Collection and content" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "use_collection_title", "label": "Use collection title when heading is blank", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection spotlight" },
    { "type": "checkbox", "id": "show_eyebrow_line", "label": "Show eyebrow line", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Modern Essentials" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2", "options": [
      { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
    ] },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Timeless pieces for everyday life. Minimal design, premium comfort and effortless style.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Uses the selected collection when left blank." },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "primary", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }
    ] },
    { "type": "checkbox", "id": "show_button_arrow", "label": "Show button arrow", "default": true },

    { "type": "header", "content": "Editorial image" },
    { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "Falls back to the collection image." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "select", "id": "image_position", "label": "Desktop image position", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "range", "id": "image_width", "label": "Desktop image width", "min": 38, "max": 58, "step": 1, "unit": "%", "default": 48 },
    { "type": "range", "id": "image_ratio_desktop", "label": "Desktop image height ratio", "min": 100, "max": 145, "step": 5, "unit": "%", "default": 130 },
    { "type": "range", "id": "image_ratio_mobile", "label": "Mobile image height ratio", "min": 85, "max": 140, "step": 5, "unit": "%", "default": 115 },
    { "type": "checkbox", "id": "show_image_overlay", "label": "Show image overlay", "default": true },
    { "type": "range", "id": "image_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 10 },

    { "type": "header", "content": "Image editorial details" },
    { "type": "checkbox", "id": "show_editorial_overlay", "label": "Show editorial text", "default": true },
    { "type": "textarea", "id": "editorial_heading", "label": "Editorial heading", "default": "Everyday\nLooks Better" },
    { "type": "textarea", "id": "editorial_text", "label": "Editorial text", "default": "CLEAN\nCOMFORTABLE\nCONFIDENT" },
    { "type": "select", "id": "editorial_position", "label": "Editorial position", "default": "top-left", "options": [
      { "value": "top-left", "label": "Top left" }, { "value": "top-right", "label": "Top right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-right", "label": "Bottom right" }
    ] },
    { "type": "checkbox", "id": "show_badge", "label": "Show collection badge", "default": true },
    { "type": "textarea", "id": "badge_text", "label": "Badge text", "default": "NEW COLLECTION\n2026" },

    { "type": "header", "content": "Features" },
    { "type": "checkbox", "id": "show_features", "label": "Show feature blocks", "default": true },

    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "Featured styles" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "product_card_design", "label": "Product card design", "default": "global", "options": [
      { "value": "global", "label": "Use global setting" },
      { "value": "01", "label": "1 - Essential Minimal" }, { "value": "02", "label": "2 - Default Overlay" },
      { "value": "03", "label": "3 - Floating Actions" }, { "value": "04", "label": "4 - Image Focus Compact" },
      { "value": "05", "label": "5 - Sale Conversion" }, { "value": "06", "label": "6 - Clean Divider" },
      { "value": "07", "label": "7 - Add to Cart Premium" }
    ] },
    { "type": "range", "id": "products_desktop", "label": "Desktop products", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "products_tablet", "label": "Tablet products", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "select", "id": "products_mobile", "label": "Mobile products", "default": "1", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ] },
    { "type": "checkbox", "id": "show_next_card_peek", "label": "Show a peek of the next card on mobile", "default": true },
    { "type": "range", "id": "mobile_peek", "label": "Mobile next-card peek", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "product_gap_desktop", "label": "Desktop product gap", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "product_gap_tablet", "label": "Tablet product gap", "min": 8, "max": 28, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "product_gap_mobile", "label": "Mobile product gap", "min": 8, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show carousel arrows", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link", "info": "Uses the selected collection when left blank." },
    { "type": "text", "id": "footer_text", "label": "Footer note", "default": "Minimal pieces. A brighter everyday." },

    { "type": "header", "content": "Section layout" },
    { "type": "color_scheme", "id": "sp_color_scheme", "label": "Color scheme" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "wide", "options": [
      { "value": "standard", "label": "Standard" }, { "value": "wide", "label": "Wide" }, { "value": "full", "label": "Full width" }
    ] },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "info": "Set to 0 to inherit the theme radius.", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_desktop", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "star", "label": "Star" },
          { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" },
          { "value": "heart", "label": "Heart" }
        ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Premium materials" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Collection Spotlight",
      "category": "03. Collections",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shield", "heading": "Premium materials" } },
        { "type": "feature", "settings": { "icon": "star", "heading": "Timeless designs" } },
        { "type": "feature", "settings": { "icon": "truck", "heading": "Fast & secure shipping" } }
      ]
    }
  ]
}
{% endschema %}
