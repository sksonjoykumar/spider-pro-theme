{%- comment -%}Spider Social Gallery · Shopify OS 2.0. No external social scripts.{%- endcomment -%}
{%- liquid
  assign valid_count = 0
  assign featured_id = blank
  assign first_valid_id = blank
  assign contains_video = false
  for block in section.blocks
    if block.type == 'social_item'
      assign valid = false
      if block.settings.image != blank or block.settings.mobile_image != blank
        assign valid = true
      endif
      if block.settings.media_type == 'video' and block.settings.shopify_video != blank
        assign valid = true
        assign contains_video = true
      endif
      if request.design_mode
        assign valid = true
      endif
      if valid
        assign valid_count = valid_count | plus: 1
        if first_valid_id == blank
          assign first_valid_id = block.id
        endif
        if block.settings.featured_item and featured_id == blank
          assign featured_id = block.id
        endif
      endif
    endif
  endfor
  if featured_id == blank
    assign featured_id = first_valid_id
  endif
  assign gallery_style = section.settings.layout_style | default: 'style_1'
  assign has_featured_layout = false
  if gallery_style == 'style_2' or gallery_style == 'style_4'
    assign has_featured_layout = true
  endif
  assign media_ratio_value = '4 / 5'
  case section.settings.media_ratio
    when 'square'
      assign media_ratio_value = '1 / 1'
    when 'landscape'
      assign media_ratio_value = '4 / 3'
    when 'vertical_social'
      assign media_ratio_value = '9 / 16'
    when 'natural'
      if section.settings.media_equal_height
        assign media_ratio_value = '4 / 5'
      else
        assign media_ratio_value = 'auto'
      endif
  endcase
  assign follow_label = section.settings.follow_button_label | default: 'Follow'
  if follow_label == 'Follow @spiderstore'
    assign follow_label = 'Follow'
  endif
  assign show_follow = false
  if section.settings.show_follow_button and section.settings.social_profile_url != blank
    assign show_follow = true
  endif
  assign needs_js = false
  if section.settings.enable_lightbox or gallery_style == 'style_3' or contains_video or section.settings.show_product_hotspot or section.settings.enable_mobile_scroll
    assign needs_js = true
  endif
-%}
{%- if valid_count > 0 or request.design_mode or section.settings.disable_gallery_on_empty == false -%}
  {% render 'sp-section-color-scheme', section: section %}
  {{ 'sp-section-heading.css' | asset_url | stylesheet_tag }}
  {{ 'sp-social-gallery.css' | asset_url | stylesheet_tag }}
  {%- if needs_js -%}<script src="{{ 'sp-social-gallery.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  <section id="sp-social-gallery-{{ section.id }}" class="sp-section sp-social-gallery sp-social-gallery--{{ gallery_style }}" data-sp-social-gallery data-sp-style="{{ gallery_style }}" data-sp-lightbox-caption="{{ section.settings.lightbox_show_caption }}" data-sp-lightbox-creator="{{ section.settings.lightbox_show_creator }}" data-sp-lightbox-product="{{ section.settings.lightbox_show_product }}" data-sp-close-overlay="{{ section.settings.lightbox_close_on_overlay }}" data-sp-autoplay="{{ section.settings.enable_autoplay }}" data-sp-autoplay-speed="{{ section.settings.autoplay_speed }}" data-sp-infinite="{{ section.settings.infinite_loop }}" data-sp-pointer-drag="{{ section.settings.enable_pointer_drag }}" data-sp-design-mode="{{ request.design_mode }}" data-sp-video-autoplay="{{ section.settings.allow_video_autoplay }}" data-sp-overlay-behavior="{{ section.settings.overlay_behavior }}" data-sp-partial="{{ section.settings.show_partial_next_item }}" data-sp-swipe="{{ section.settings.enable_swipe }}" data-sp-pause-hover="{{ section.settings.pause_on_hover }}" data-sp-image-position="{{ section.settings.media_position }}" data-sp-tile-shadow="{{ section.settings.tile_shadow }}" data-sp-mobile-intro="{{ section.settings.mobile_split_content_position }}" data-sp-featured-position="{{ section.settings.featured_item_position }}" data-sp-mobile-featured-position="{{ section.settings.mobile_featured_position }}" data-sp-equal-height="{{ section.settings.media_equal_height }}" data-sp-ratio="{{ section.settings.media_ratio }}" data-sp-arrow-position="{{ section.settings.arrow_position }}" data-sp-follow-enabled="{{ show_follow }}" data-sp-show-quick-view="{{ section.settings.show_quick_view }}" data-sp-social-platform="{{ section.settings.social_platform }}" style="--sp-sg-width:{{ section.settings.section_max_width }}px;--sp-sg-header-width:{{ section.settings.header_max_width }}px;--sp-sg-heading-size:{{ section.settings.heading_size }}px;--sp-sg-description-width:{{ section.settings.description_width }}px;--sp-sg-header-gap:{{ section.settings.header_bottom_spacing }}px;--sp-sg-button-gap:{{ section.settings.header_to_button_spacing }}px;--sp-sg-gallery-gap:{{ section.settings.button_to_gallery_spacing }}px;--sp-sg-carousel-gap:{{ section.settings.gallery_item_gap }}px;--sp-sg-gap-d:{{ section.settings.grid_gap_desktop }}px;--sp-sg-gap-t:{{ section.settings.grid_gap_tablet }}px;--sp-sg-gap-m:{{ section.settings.grid_gap_mobile }}px;--sp-sg-columns-d:{{ section.settings.desktop_columns }};--sp-sg-columns-t:{{ section.settings.tablet_columns }};--sp-sg-columns-m:{{ section.settings.mobile_columns }};--sp-sg-slide-d:{{ section.settings.desktop_slides }};--sp-sg-slide-t:{{ section.settings.tablet_slides }};--sp-sg-slide-m:{{ section.settings.mobile_slides }};--sp-sg-radius:{{ section.settings.tile_border_radius }}px;--sp-sg-border-width:{{ section.settings.tile_border_width }}px;--sp-sg-border-color:{% if section.settings.use_custom_tile_border_color %}{{ section.settings.tile_border_color }}{% else %}var(--sp-section-border,#e4e4e7){% endif %};--sp-sg-tile-bg:{% if section.settings.use_custom_tile_background %}{{ section.settings.tile_background }}{% else %}var(--sp-section-card,#f5f5f5){% endif %};--sp-sg-overlay-color:{{ section.settings.overlay_color }};--sp-sg-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--sp-sg-overflow-ratio:{{ media_ratio_value }};--sp-sg-image-fit:{{ section.settings.media_fit }};--sp-sg-pt:{{ section.settings.padding_top }}px;--sp-sg-pb:{{ section.settings.padding_bottom }}px;--sp-sg-pt-t:{{ section.settings.padding_top_tablet }}px;--sp-sg-pb-t:{{ section.settings.padding_bottom_tablet }}px;--sp-sg-pt-m:{{ section.settings.padding_top_mobile }}px;--sp-sg-pb-m:{{ section.settings.padding_bottom_mobile }}px;--sp-sg-hotspot-color:var(--sp-section-accent,var(--sp-color-accent,#415dff));" aria-label="{{ section.settings.heading | default: 'Social gallery' | escape }}">
    <div class="sp-container sp-container--wide sp-social-gallery__container">
      <div class="sp-social-gallery__layout {% if gallery_style == 'style_5' and section.settings.split_content_position == 'right' %}sp-social-gallery__layout--intro-right{% endif %}">
        {%- if section.settings.show_header -%}
          <div class="sp-social-gallery__intro sp-social-gallery__intro--{{ section.settings.heading_alignment }}">
            {%- if section.settings.eyebrow != blank -%}<p class="sp-social-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if section.settings.heading != blank or section.settings.description != blank -%}
              {% render 'sp-section-heading', heading: section.settings.heading, subheading: section.settings.description, alignment: section.settings.heading_alignment, mobile_alignment: 'center', heading_size_desktop: section.settings.heading_size, heading_size_tablet: 34, heading_size_mobile: 28, typography_source: 'custom', heading_tag: 'h2', bottom_spacing: 0 %}
            {%- endif -%}
            {%- if section.settings.show_follow_button and section.settings.social_profile_url != blank -%}
              <a class="sp-button sp-button--{{ section.settings.follow_button_style }} sp-social-gallery__follow" href="{{ section.settings.social_profile_url }}" aria-label="{{ follow_label | escape }}{% if section.settings.social_handle != blank and follow_label == 'Follow' %} {{ section.settings.social_handle | escape }}{% endif %}" {% if section.settings.follow_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {%- if section.settings.show_platform_icon and section.settings.social_platform != 'none' -%}
                  <span class="sp-social-gallery__platform-icon" aria-hidden="true">
                    {%- case section.settings.social_platform -%}
                      {%- when 'instagram' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.7 6.4h.01"/></svg>
                      {%- when 'tiktok' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.4 3h3.1c.3 2.2 1.5 3.5 4 3.8v3.1a9.1 9.1 0 0 1-4-1.2v6.2a6.3 6.3 0 1 1-6.3-6.3c.4 0 .8 0 1.2.1V12a3.1 3.1 0 1 0 2 2.9V3z"/></svg>
                      {%- when 'pinterest' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.1-2 .1-2.9l1.3-5.5s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.6-.3 1.1.5 2 1.6 2 1.9 0 3.3-2.5 3.3-5.5 0-2.3-1.6-4-4.4-4-3.2 0-5.2 2.4-5.2 5 0 .9.3 1.8.8 2.3.2.3.3.4.2.7l-.2.9c-.1.3-.3.4-.6.2-1.4-.6-2-2.3-2-4.2 0-3.1 2.6-6.7 7.7-6.7 4.1 0 6.8 3 6.8 6.3 0 4.3-2.4 7.5-6 7.5-1.2 0-2.3-.7-2.7-1.4l-.8 3.1c-.3.9-.7 1.8-1.1 2.5A10 10 0 1 0 12 2z"/></svg>
                      {%- when 'youtube' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none"/></svg>
                      {%- when 'facebook' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.4 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v1.9H7V13h2.7v8h3.7z"/></svg>
                      {%- when 'x' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4l16 16M20 4 4 20"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7M21 3l-9 9"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    {%- endcase -%}
                  </span>
                {%- endif -%}
                <span class="sp-social-gallery__follow-label">{{ follow_label | escape }}</span>
                {%- if section.settings.social_handle != blank and follow_label == 'Follow' -%}<span class="sp-social-gallery__follow-handle">{{ section.settings.social_handle | escape }}</span>{%- endif -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="sp-social-gallery__gallery{% if gallery_style == 'style_1' and section.settings.enable_mobile_scroll %} sp-social-gallery__gallery--mobile-scroll{% endif %}">
          {%- if gallery_style == 'style_3' and section.settings.show_arrows -%}
            <nav class="sp-social-gallery__arrows" aria-label="Gallery carousel controls"><button type="button" data-sp-prev aria-label="Previous gallery items">{% render 'icon', name: 'chevron-left' %}</button><button type="button" data-sp-next aria-label="Next gallery items">{% render 'icon', name: 'chevron-right' %}</button></nav>
          {%- endif -%}
          <ul class="sp-social-gallery__list{% if section.settings.hover_effect != 'none' %} sp-social-gallery__list--hover-{{ section.settings.hover_effect }}{% endif %}" data-sp-list aria-label="{{ section.settings.gallery_accessible_label | escape }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_item' -%}
                {%- assign item_is_featured = false -%}
                {%- if has_featured_layout and block.id == featured_id -%}
                  {%- assign item_is_featured = true -%}
                {%- endif -%}
                {% render 'sp-social-gallery-item', section: section, block: block, featured: item_is_featured, editor_mode: request.design_mode %}
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if gallery_style == 'style_3' -%}
            {%- if section.settings.show_progress_bar -%}<div class="sp-social-gallery__progress" role="progressbar" aria-label="Gallery browsing progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-sp-progress><span data-sp-progress-fill></span></div>{%- endif -%}
            {%- if section.settings.show_dots -%}<div class="sp-social-gallery__dots" data-sp-dots aria-label="Gallery pages"></div>{%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- if section.settings.enable_lightbox -%}{% render 'sp-social-gallery-lightbox', section: section %}{%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Spider Social Gallery",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FOLLOW ALONG"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look. Share the Moment."
    },
    {
      "type": "richtext",
