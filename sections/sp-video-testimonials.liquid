      "label": "Transcript disclosure label",
      "default": "Read transcript"
    },
    {
      "type": "select",
      "id": "transcript_behavior",
      "label": "Transcript placement",
      "options": [
        {
          "value": "accordion",
          "label": "Collapsible below card"
        },
        {
          "value": "below_video",
          "label": "Below video"
        }
      ],
      "default": "accordion"
    },
    {
      "type": "header",
      "content": "Customer information"
    },
    {
      "type": "checkbox",
      "id": "show_customer_name",
      "label": "Show customer name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_customer_location",
      "label": "Show broad location",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_customer_image",
      "label": "Show customer avatar",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_verified_purchase",
      "label": "Show verified badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_review_date",
      "label": "Show review date",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show testimonial star rating",
      "default": false
    },
    {
      "type": "select",
      "id": "customer_name_style",
      "label": "Name typography",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "customer_image_shape",
      "label": "Avatar shape",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "customer_image_size",
      "label": "Avatar size",
      "min": 32,
      "max": 96,
      "step": 4,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Product links"
    },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "Show linked product",
      "default": false
    },
    {
      "type": "select",
      "id": "product_display_style",
      "label": "Product placement",
      "options": [
        {
          "value": "below_video",
