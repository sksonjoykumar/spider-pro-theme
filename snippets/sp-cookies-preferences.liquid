{% if section.settings.enable_preferences and section.settings.display_mode != 'notice_only' %}
<dialog id="SpCookiesPreferences-{{ section.id }}" class="sp-cookies__preferences" data-sp-cookies-preferences-dialog
 aria-labelledby="SpCookiesPreferencesHeading-{{ section.id }}" aria-describedby="SpCookiesPreferencesDescription-{{ section.id }}"
 style="--sp-cookie-bg: {% if section.settings.sp_use_color_scheme %}var(--sp-color-card, #fff){% else %}{{ section.settings.background_color }}{% endif %}; --sp-cookie-text: {% if section.settings.sp_use_color_scheme %}var(--sp-color-text, #3F3F46){% else %}{{ section.settings.text_color }}{% endif %}; --sp-cookie-muted: {% if section.settings.sp_use_color_scheme %}var(--sp-color-muted, #71717A){% else %}{{ section.settings.muted_text_color }}{% endif %}; --sp-cookie-border: {% if section.settings.sp_use_color_scheme %}var(--sp-color-border, #E4E4E7){% else %}{{ section.settings.border_color }}{% endif %}; --sp-cookie-accept-bg: {% if section.settings.sp_use_color_scheme %}var(--sp-btn-primary-bg, var(--sp-color-accent, #415DFF)){% else %}{{ section.settings.accept_bg }}{% endif %}; --sp-cookie-accept-text: {% if section.settings.sp_use_color_scheme %}var(--sp-btn-primary-text, #fff){% else %}{{ section.settings.accept_text }}{% endif %}; --sp-cookie-button-radius: {{ section.settings.button_radius }}px;">
 <div class="sp-cookies__preferences-card">
  <div class="sp-cookies__preferences-head"><div><h2 class="sp-cookies__preferences-title" id="SpCookiesPreferencesHeading-{{ section.id }}">{{ section.settings.preferences_heading | escape }}</h2><p class="sp-cookies__preferences-intro" id="SpCookiesPreferencesDescription-{{ section.id }}">{{ section.settings.preferences_intro | escape }}</p></div>
   <button class="sp-cookies__preferences-close" type="button" data-sp-cookies-preferences-close aria-label="Close cookie preferences"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></button>
  </div>
  <form class="sp-cookies__preferences-form" data-sp-cookies-preferences-form>
    <div class="sp-cookies__preference-row"><span class="sp-cookies__preference-copy"><strong>{{ section.settings.necessary_title | escape }}</strong><span>{{ section.settings.necessary_dialog_description | escape }}</span></span>
      <span class="sp-cookies__switch sp-cookies__switch--locked"><input type="checkbox" checked disabled aria-label="Necessary cookies always active"><span aria-hidden="true"></span></span></div>
    {% if section.settings.enable_analytics_category %}<div class="sp-cookies__preference-row"><label class="sp-cookies__preference-copy" for="SpCookiesAnalytics-{{ section.id }}"><strong>{{ section.settings.analytics_title | escape }}</strong><span>{{ section.settings.analytics_dialog_description | escape }}</span></label><label class="sp-cookies__switch"><input id="SpCookiesAnalytics-{{ section.id }}" type="checkbox" data-sp-consent="analytics"><span aria-hidden="true"></span></label></div>{% endif %}
    {% if section.settings.enable_marketing_category %}<div class="sp-cookies__preference-row"><label class="sp-cookies__preference-copy" for="SpCookiesMarketing-{{ section.id }}"><strong>{{ section.settings.marketing_title | escape }}</strong><span>{{ section.settings.marketing_dialog_description | escape }}</span></label><label class="sp-cookies__switch"><input id="SpCookiesMarketing-{{ section.id }}" type="checkbox" data-sp-consent="marketing"><span aria-hidden="true"></span></label></div>{% endif %}
    {% if section.settings.enable_preference_category %}<div class="sp-cookies__preference-row"><label class="sp-cookies__preference-copy" for="SpCookiesPrefs-{{ section.id }}"><strong>{{ section.settings.preferences_title | escape }}</strong><span>{{ section.settings.preferences_dialog_description | escape }}</span></label><label class="sp-cookies__switch"><input id="SpCookiesPrefs-{{ section.id }}" type="checkbox" data-sp-consent="preferences"><span aria-hidden="true"></span></label></div>{% endif %}
    {% if section.settings.show_data_sale %}<div class="sp-cookies__preference-row" data-sp-data-sale-row hidden><label class="sp-cookies__preference-copy" for="SpCookiesDataSale-{{ section.id }}"><strong>Data sale / sharing opt-out</strong><span>When available in your region, opt out of sale or sharing of personal data.</span></label><label class="sp-cookies__switch"><input id="SpCookiesDataSale-{{ section.id }}" type="checkbox" data-sp-consent-sale-opt-out><span aria-hidden="true"></span></label></div>{% endif %}
    <div class="sp-cookies__preferences-actions"><button class="sp-cookies__button sp-cookies__accept" type="submit" data-sp-cookies-save-preferences>{{ section.settings.save_preferences_label | escape }}</button></div>
    <p class="sp-cookies__preferences-feedback" data-sp-cookies-preferences-status role="status" aria-live="polite"></p>
  </form>
 </div>
</dialog>
{% endif %}
