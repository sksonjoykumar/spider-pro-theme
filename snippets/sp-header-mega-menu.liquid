{% if block.settings.sp_mega_design == 'classic' %}
{% comment %}
  Spider Premium Header — original mega menu renderer.
  Params: link (required), block (required), section (required)
{% endcomment %}
{% assign sp_ratio = block.settings.image_ratio | default: 'auto' %}
<div
  class="sp-header-mega-menu"
  data-sp-mega-menu
  data-sp-mega-block-id="{{ block.id }}"
  data-columns="{{ block.settings.columns | default: '4' }}"
  data-align="{{ block.settings.text_alignment | default: 'left' }}"
  style="
    --sp-mega-columns: {{ block.settings.columns | default: 4 }};
    --sp-mega-gap-y: {{ block.settings.vertical_spacing | default: 18 }}px;
    --sp-mega-heading-size: {{ block.settings.heading_size | default: 15 }}px;
    --sp-mega-link-size: {{ block.settings.link_size | default: 14 }}px;
  "
  {{ block.shopify_attributes }}>
  <div class="sp-header-mega-menu__nav">
    {% for child in link.links %}
      <div class="sp-header-mega-menu__group">
        <a class="sp-header-mega-menu__heading" href="{{ child.url }}">{{ child.title | escape }}</a>
        {% if child.links != blank %}
          <ul class="sp-header-mega-menu__links" role="list">
            {% for grandchild in child.links %}
              <li>
                <a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% assign sp_has_promos = false %}
  {% if block.settings.promo_1_image != blank or block.settings.promo_1_heading != blank %}
    {% assign sp_has_promos = true %}{% endif %}
  {% if block.settings.promo_2_image != blank or block.settings.promo_2_heading != blank %}
    {% assign sp_has_promos = true %}{% endif %}
  {% if block.settings.promo_3_image != blank or block.settings.promo_3_heading != blank %}
    {% assign sp_has_promos = true %}{% endif %}

  {% if sp_has_promos %}
    <div
      class="sp-header-mega-menu__promos"
      data-ratio="{{ sp_ratio }}"
      data-hover="{{ block.settings.image_hover | default: 'zoom' }}">
      {% for sp_i in (1..3) %}
        {% case sp_i %}
          {% when 1 %}
            {% assign sp_image = block.settings.promo_1_image %}
            {% assign sp_heading = block.settings.promo_1_heading %}
            {% assign sp_text = block.settings.promo_1_text %}
            {% assign sp_link = block.settings.promo_1_link %}
            {% assign sp_label = block.settings.promo_1_label %}
          {% when 2 %}
            {% assign sp_image = block.settings.promo_2_image %}
            {% assign sp_heading = block.settings.promo_2_heading %}
            {% assign sp_text = block.settings.promo_2_text %}
            {% assign sp_link = block.settings.promo_2_link %}
            {% assign sp_label = block.settings.promo_2_label %}
          {% when 3 %}
            {% assign sp_image = block.settings.promo_3_image %}
            {% assign sp_heading = block.settings.promo_3_heading %}
            {% assign sp_text = block.settings.promo_3_text %}
            {% assign sp_link = block.settings.promo_3_link %}
            {% assign sp_label = block.settings.promo_3_label %}
        {% endcase %}
        {% if sp_image != blank or sp_heading != blank %}
          <article class="sp-header-mega-menu__promo">
            {% if sp_link != blank %}<a class="sp-header-mega-menu__promo-link" href="{{ sp_link }}">{% endif %}
            {% if sp_image != blank %}
              <div class="sp-header-mega-menu__promo-media">
                {{ sp_image | image_url: width: 720 | image_tag: widths: '180, 240, 320, 480, 640, 720', sizes: '(min-width: 1440px) 260px, (min-width: 990px) 20vw, 45vw', loading: 'lazy', class: 'sp-header-mega-menu__promo-image', alt: sp_heading
                }}
              </div>
            {% endif %}
            {% if sp_heading != blank or sp_text != blank or sp_label != blank %}
              <div class="sp-header-mega-menu__promo-content">
                {% if sp_heading != blank %}
                  <strong>{{ sp_heading | escape }}</strong>
                {% endif %}
                {% if sp_text != blank %}
                  <span>{{ sp_text | escape }}</span>
                {% endif %}
                {% if sp_label != blank %}
                  <span class="sp-header-mega-menu__promo-cta">{{ sp_label | escape }}</span>
                {% endif %}
              </div>
            {% endif %}
            {% if sp_link != blank %}</a>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>
{% else %}
{% comment %}Spider Premium reference mega menu. Reuses the saved mega_menu block; no static links/products.{% endcomment %}
{% assign sp_cat_links = link.links %}
{% if block.settings.sp_category_menu != blank %}
  {% assign sp_cat_links = block.settings.sp_category_menu.links %}
{% endif %}
{% assign sp_has_featured = false %}
{% for sp_i in (1..4) %}
  {% assign sp_key = 'sp_featured_collection_' | append: sp_i %}
  {% if block.settings[sp_key] != blank %}{% assign sp_has_featured = true %}{% endif %}
{% endfor %}
{% if sp_has_featured == false and block.settings.promo_2_image != blank %}{% assign sp_has_featured = true %}{% endif %}
{% assign sp_has_brands = false %}
{% if block.settings.sp_brands_menu != blank and block.settings.sp_brands_menu.links.size > 0 %}{% assign sp_has_brands = true %}{% endif %}
{% assign sp_hero_image = block.settings.sp_hero_image | default: block.settings.promo_1_image %}
{% assign sp_hero_title = block.settings.sp_hero_heading | default: block.settings.promo_1_heading %}
{% assign sp_hero_text = block.settings.sp_hero_text | default: block.settings.promo_1_text %}
{% assign sp_hero_link = block.settings.sp_hero_url | default: block.settings.promo_1_link %}
{% assign sp_hero_button = block.settings.sp_hero_button | default: block.settings.promo_1_label %}
{% assign sp_has_banner = false %}
{% if sp_hero_image != blank or sp_hero_title != blank %}{% assign sp_has_banner = true %}{% endif %}
{% assign sp_has_trust = false %}
{% if block.settings.sp_show_trust and block.settings.sp_benefit_1_title != blank or block.settings.sp_show_trust and block.settings.sp_benefit_2_title != blank or block.settings.sp_show_trust and block.settings.sp_benefit_3_title != blank %}{% assign sp_has_trust = true %}{% endif %}
<div class="sp-header-mega-menu sp-header-mega-menu--reference" data-sp-mega-menu data-sp-mega-block-id="{{ block.id }}" data-align="{{ block.settings.text_alignment | default: 'left' }}" {{ block.shopify_attributes }}>
  <div class="sp-header-mega-menu__reference-grid">
    {% if sp_cat_links != blank %}
    <div class="sp-mega-ref__column sp-mega-ref__categories">
      <h3 class="sp-mega-ref__title">{{ block.settings.sp_category_title | default: 'Shop by Category' | escape }}</h3>
      <ul class="sp-mega-ref__category-list" role="list">
        {% for item in sp_cat_links limit: 12 %}
          <li><a href="{{ item.url }}" class="sp-mega-ref__category{% if item.current or item.active %} is-active{% endif %}"{% if item.current %} aria-current="page"{% endif %}>
            <span class="sp-mega-ref__category-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 12h8M12 8v8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
            <span>{{ item.title | escape }}</span>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    {% if sp_has_featured %}
    <div class="sp-mega-ref__column sp-mega-ref__featured">
      <h3 class="sp-mega-ref__title">{{ block.settings.sp_featured_title | default: 'Featured Collections' | escape }}</h3>
      <div class="sp-mega-ref__featured-list">
        {% for sp_i in (1..4) %}
          {% assign sp_key = 'sp_featured_collection_' | append: sp_i %}
          {% assign sp_collection = block.settings[sp_key] %}
          {% if sp_collection != blank %}
            <a class="sp-mega-ref__feature" href="{{ sp_collection.url }}">
              <span class="sp-mega-ref__feature-image">
              {% if sp_collection.image %}
                {{ sp_collection.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80, 120, 160, 200', sizes: '76px', alt: sp_collection.title }}
              {% elsif sp_collection.products.first.featured_image %}
                {{ sp_collection.products.first.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80, 120, 160, 200', sizes: '76px', alt: sp_collection.title }}
              {% endif %}
              </span><span class="sp-mega-ref__feature-copy"><strong>{{ sp_collection.title | escape }}</strong><span>{{ block.settings.promo_1_label | default: 'Shop Now' | escape }} →</span></span>
            </a>
          {% endif %}
        {% endfor %}
        {% if block.settings.sp_featured_collection_1 == blank and block.settings.sp_featured_collection_2 == blank and block.settings.sp_featured_collection_3 == blank and block.settings.sp_featured_collection_4 == blank %}
          {% for sp_i in (2..3) %}
            {% if sp_i == 2 %}
              {% assign sp_image = block.settings.promo_2_image %}{% assign sp_title = block.settings.promo_2_heading %}{% assign sp_link = block.settings.promo_2_link %}
            {% else %}
              {% assign sp_image = block.settings.promo_3_image %}{% assign sp_title = block.settings.promo_3_heading %}{% assign sp_link = block.settings.promo_3_link %}
            {% endif %}
            {% if sp_link != blank and sp_image != blank %}
              <a class="sp-mega-ref__feature" href="{{ sp_link }}"><span class="sp-mega-ref__feature-image">{{ sp_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80, 120, 160, 200', sizes: '76px', alt: sp_title }}</span><span class="sp-mega-ref__feature-copy"><strong>{{ sp_title | escape }}</strong><span>Shop Now →</span></span></a>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
    {% endif %}
    {% if sp_has_brands %}
    <div class="sp-mega-ref__column sp-mega-ref__brands">
      <h3 class="sp-mega-ref__title">{{ block.settings.sp_brands_title | default: 'Popular Brands' | escape }}</h3>
      <ul role="list">
        {% for brand in block.settings.sp_brands_menu.links limit: 9 %}<li><a href="{{ brand.url }}">{{ brand.title | escape }}</a></li>{% endfor %}
      </ul>
      {% if block.settings.sp_brands_url != blank %}<a class="sp-mega-ref__view-all" href="{{ block.settings.sp_brands_url }}">{{ block.settings.sp_brands_cta | default: 'View all brands' | escape }} →</a>{% endif %}
    </div>
    {% endif %}
    {% if sp_has_banner or sp_has_trust %}
    <div class="sp-mega-ref__column sp-mega-ref__editorial">
      {% if sp_has_banner %}
      <div class="sp-mega-ref__banner">
        {% if sp_hero_image != blank %}{{ sp_hero_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 450, 600, 800, 1000', sizes: '(min-width: 1280px) 430px, 40vw', class: 'sp-mega-ref__banner-image', alt: sp_hero_title }}{% endif %}
        {% if sp_hero_title != blank or sp_hero_text != blank %}
        <div class="sp-mega-ref__banner-copy">
          {% if sp_hero_title != blank %}<h3>{{ sp_hero_title | escape }}</h3>{% endif %}
          {% if sp_hero_text != blank %}<p>{{ sp_hero_text | escape }}</p>{% endif %}
          {% if sp_hero_link != blank %}<a class="sp-mega-ref__banner-button" href="{{ sp_hero_link }}">{{ sp_hero_button | default: 'Shop Collection' | escape }} <span aria-hidden="true">→</span></a>{% endif %}
        </div>{% endif %}
      </div>
      {% endif %}
      {% if sp_has_trust %}
      <div class="sp-mega-ref__benefits">
        {% for sp_i in (1..3) %}
          {% assign sp_title_key = 'sp_benefit_' | append: sp_i | append: '_title' %}
          {% assign sp_text_key = 'sp_benefit_' | append: sp_i | append: '_text' %}
          {% if block.settings[sp_title_key] != blank %}
            <div class="sp-mega-ref__benefit">
              {% case sp_i %}{% when 1 %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v12H3zM14 10h4l3 4v4h-7zM7 18a2 2 0 1 0 4 0M17 18a2 2 0 1 0 4 0"/></svg>{% when 2 %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 7 9-4 9 4v10l-9 4-9-4zM3 7l9 5 9-5M12 12v9"/></svg>{% else %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 6v6c0 5 3 8 8 10 5-2 8-5 8-10V6zM8 12l3 3 5-6"/></svg>{% endcase %}
              <strong>{{ block.settings[sp_title_key] | escape }}</strong>
              {% if block.settings[sp_text_key] != blank %}<small>{{ block.settings[sp_text_key] | escape }}</small>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>
{% endif %}
