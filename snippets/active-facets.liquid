{% assign has_active = false %}{% for filter in collection.filters %}{% if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value %}{% assign has_active = true %}{% endif %}{% endfor %}
{% if has_active %}<div class="sp-active-facets" aria-label="{{ 'collections.filtering.active_filters' | t }}">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.min_value.value or filter.max_value.value %}<a href="{{ filter.url_to_remove }}">{{ filter.label | escape }} ×</a>{% endif %}{% endfor %}<a href="{{ collection.url }}">{{ 'collections.filtering.clear_all' | t }}</a></div>{% endif %}
