{% comment %}
  Spider Header Wishlist link integration.
  Spider Core does not include a complete Wishlist controller/page contract,
  so this renders only when the merchant supplies a real Wishlist URL.

  Params:
  - section (required)
  - context: 'action' for desktop Header action, otherwise mobile drawer row
{% endcomment %}
{%- assign sp_wishlist_context = context | default: 'drawer' -%}
{% if section.settings.mobile_wishlist_url != blank %}
  {% if sp_wishlist_context == 'action' %}
    <a
      class="sp-header__action sp-header__wishlist"
      href="{{ section.settings.mobile_wishlist_url }}"
      aria-label="Wishlist"
      data-sp-wishlist-link>
      <span class="sp-header__wishlist-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M12 20.5 4.6 13.7C1.6 11 1.4 6.5 4.2 4.2c2.1-1.8 5.3-1.4 7 1 .3.4.5.8.8 1.3.3-.5.5-.9.8-1.3 1.7-2.4 4.9-2.8 7-1 2.8 2.3 2.6 6.8-.4 9.5L12 20.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="sp-header__action-label">Wishlist</span>
    </a>
  {% else %}
    <a class="sp-header-mobile-utilities__row" href="{{ section.settings.mobile_wishlist_url }}" data-sp-wishlist-link>
      <span class="sp-header-mobile-utilities__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M12 20.5 4.6 13.7C1.6 11 1.4 6.5 4.2 4.2c2.1-1.8 5.3-1.4 7 1 .3.4.5.8.8 1.3.3-.5.5-.9.8-1.3 1.7-2.4 4.9-2.8 7-1 2.8 2.3 2.6 6.8-.4 9.5L12 20.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="sp-header-mobile-utilities__label">Wishlist</span>
    </a>
  {% endif %}
{% endif %}
