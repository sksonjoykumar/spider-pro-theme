{% comment %}LiquidDoc: Empty-state component. Parameters: heading, text, action_label, action_url optional.{% endcomment %}
<div class="sp-empty">
  {% if settings.sp_brand_image != blank %}{% render 'responsive-image', image: settings.sp_brand_image, class: 'sp-empty__image', widths: '160,240,320,480', sizes: '192px', alt: settings.sp_brand_image.alt %}{% endif %}
  <h2>{{ heading }}</h2>
  {% if text != blank %}<p>{{ text }}</p>{% endif %}
  {% if action_label != blank and action_url != blank %}{% render 'button', label: action_label, href: action_url, style: 'primary' %}{% endif %}
</div>
