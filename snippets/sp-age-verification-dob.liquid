{%- liquid
  assign now_year = 'now' | date: '%Y' | plus: 0
  assign first_year = now_year | minus: 120
-%}

<div class="sp-age-verification__dob sp-age-verification__dob--{{ section.settings.dob_order }}" data-sp-age-dob>
  {%- capture year_field -%}
    <div class="sp-age-verification__field sp-age-verification__field--year">
      <label class="visually-hidden" for="SpAgeYear-{{ section.id }}">Year</label>
      <select id="SpAgeYear-{{ section.id }}" class="sp-age-verification__select" data-sp-age-year>
        <option value="">Year</option>
        {%- for year in (first_year..now_year) reversed -%}
          <option value="{{ year }}">{{ year }}</option>
        {%- endfor -%}
      </select>
    </div>
  {%- endcapture -%}

  {%- capture month_field -%}
    <div class="sp-age-verification__field sp-age-verification__field--month">
      <label class="visually-hidden" for="SpAgeMonth-{{ section.id }}">Month</label>
      <select id="SpAgeMonth-{{ section.id }}" class="sp-age-verification__select" data-sp-age-month>
        <option value="">Month</option>
        <option value="1">January</option>
        <option value="2">February</option>
        <option value="3">March</option>
        <option value="4">April</option>
        <option value="5">May</option>
        <option value="6">June</option>
        <option value="7">July</option>
        <option value="8">August</option>
        <option value="9">September</option>
        <option value="10">October</option>
        <option value="11">November</option>
        <option value="12">December</option>
      </select>
    </div>
  {%- endcapture -%}

  {%- capture day_field -%}
    <div class="sp-age-verification__field sp-age-verification__field--day">
      <label class="visually-hidden" for="SpAgeDay-{{ section.id }}">Day</label>
      <select id="SpAgeDay-{{ section.id }}" class="sp-age-verification__select" data-sp-age-day>
        <option value="">Day</option>
        {%- for day in (1..31) -%}
          <option value="{{ day }}">{{ day }}</option>
        {%- endfor -%}
      </select>
    </div>
  {%- endcapture -%}

  {%- case section.settings.dob_order -%}
    {%- when 'dmy' -%}
      {{ day_field }}{{ month_field }}{{ year_field }}
    {%- when 'mdy' -%}
      {{ month_field }}{{ day_field }}{{ year_field }}
    {%- else -%}
      {{ year_field }}{{ month_field }}{{ day_field }}
  {%- endcase -%}
</div>
