<svg
  class="sp-product-comparison-icon"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'capacity' -%}
      <path d="M7 4h10l-1 16H8L7 4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M6 4h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {%- when 'material' -%}
      <path d="m12 3 8 4-8 4-8-4 8-4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="m4 12 8 4 8-4M4 17l8 4 8-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'snowflake' -%}
      <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <path d="m9.5 5.5 2.5 2.2 2.5-2.2M9.5 18.5l2.5-2.2 2.5 2.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'droplet' -%}
      <path d="M12 3s6 6.2 6 11a6 6 0 1 1-12 0c0-4.8 6-11 6-11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l1 12H4L5 8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {%- when 'weight' -%}
      <path d="M8 7h8l3 13H5L8 7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <circle cx="12" cy="6" r="3" stroke="currentColor" stroke-width="1.7"/>
    {%- when 'target' -%}
      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="12" cy="12" r="1.2" fill="currentColor"/>
    {%- when 'dishwasher' -%}
      <rect x="4" y="3.5" width="16" height="17" rx="2" stroke="currentColor" stroke-width="1.7"/>
      <path d="M4 8h16" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="8" cy="5.8" r=".8" fill="currentColor"/>
      <circle cx="11" cy="5.8" r=".8" fill="currentColor"/>
      <path d="M8 16c1.2-2.4 2.5-3.6 4-3.6s2.8 1.2 4 3.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {%- when 'check' -%}
      <path d="m6.8 12.2 3.2 3.2 7.2-7.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'compare' -%}
      <path d="M8 5h11M16 2l3 3-3 3M16 19H5M8 16l-3 3 3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"/>
  {%- endcase -%}
</svg>
