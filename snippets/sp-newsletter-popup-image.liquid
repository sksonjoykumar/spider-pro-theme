{%- liquid
  assign desktop_position = section.settings.image_position_desktop
  assign mobile_position = section.settings.image_position_mobile
  if desktop_image != blank and desktop_image.presentation.focal_point != blank
    assign desktop_position = desktop_image.presentation.focal_point
  endif
  if mobile_image != blank and mobile_image.presentation.focal_point != blank
    assign mobile_position = mobile_image.presentation.focal_point
  endif
  assign alt_text = ''
  if section.settings.image_purpose == 'informative'
    assign alt_text = section.settings.image_alt | default: desktop_image.alt
  endif
-%}
<div
  class="sp-newsletter-popup__media sp-newsletter-popup__media--{{ section.settings.image_fit }}"
  style="--sp-newsletter-popup-image-position-d: {{ desktop_position }}; --sp-newsletter-popup-image-position-m: {{ mobile_position }};"
>
  <picture class="sp-newsletter-popup__picture">
    {%- if section.settings.mobile_image != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="
          {{ section.settings.mobile_image | image_url: width: 320 }} 320w,
          {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
          {{ section.settings.mobile_image | image_url: width: 640 }} 640w,
          {{ section.settings.mobile_image | image_url: width: 800 }} 800w
        "
        sizes="calc(100vw - 24px)"
      >
    {%- endif -%}
    {%- if desktop_image != blank -%}
      {{ desktop_image
        | image_url: width: 1000
        | image_tag:
          class: 'sp-newsletter-popup__image',
          loading: 'lazy',
          fetchpriority: 'low',
          widths: '320,480,640,800,1000',
          sizes: '(min-width: 750px) min(48vw, 500px), calc(100vw - 24px)',
          alt: alt_text
      }}
    {%- elsif section.settings.use_reference_image -%}
      <img
        class="sp-newsletter-popup__image"
        src="{{ 'sp-newsletter-popup-editorial.jpg' | asset_url }}"
        width="497" height="690" loading="lazy" decoding="async"
        alt="{% if section.settings.image_purpose == 'informative' %}{{ section.settings.image_alt | default: 'Streetwear editorial photograph' | escape }}{% endif %}"
      >
    {%- endif -%}
  </picture>
</div>
