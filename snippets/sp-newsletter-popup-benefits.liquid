{%- comment -%}
  Icon-only mode renders an accessible decorative SVG for offer cards.
  The benefit list uses Shopify blocks; fallback benefits remain configurable
  for existing installed section instances without blocks.
{%- endcomment -%}
{% if icon_only %}
  {% case icon %}
    {% when 'bolt' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 10-12h-7z"/></svg>
    {% when 'tag' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9Z"/><circle cx="8" cy="8" r="1"/></svg>
    {% when 'box' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 7 9-4 9 4v10l-9 4-9-4z"/><path d="m3 7 9 4 9-4M12 11v10"/></svg>
    {% when 'truck' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h12v11H2zM14 10h4l4 4v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
    {% when 'shield' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 4v6c0 5-4 8-9 10-5-2-9-5-9-10V6z"/><path d="m8 12 3 3 5-5"/></svg>
    {% when 'star' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 6 7 1-5 5 1 8-6-4-6 4 1-8-5-5 7-1z"/></svg>
    {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="12" rx="1"/><path d="M12 9v12M3 13h18M4 9c-4-6 5-9 8 0 3-9 12-6 8 0"/></svg>
  {% endcase %}
{% else %}
  {% assign show_fallback = false %}
  {% if section.blocks.size == 0 and section.settings.show_default_benefits %}
    {% assign show_fallback = true %}
  {% endif %}
  {% if section.blocks.size > 0 or show_fallback %}
  <div class="sp-newsletter-popup__benefits" aria-label="Newsletter benefits">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
      <div class="sp-newsletter-popup__benefit{% unless block.settings.show_mobile %} sp-newsletter-popup__benefit--desktop-only{% endunless %}" style="--sp-benefit-icon-color:{{ block.settings.icon_color }};--sp-benefit-icon-bg:{{ block.settings.icon_background }}" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}<a class="sp-newsletter-popup__benefit-link" href="{{ block.settings.link }}">{% endif %}
          <span class="sp-newsletter-popup__benefit-icon" aria-hidden="true">
            {% if block.settings.custom_icon != blank %}
              {{ block.settings.custom_icon | image_url: width: 64 | image_tag: loading: 'lazy', alt: '', widths: '32,48,64' }}
            {% else %}
              {% render 'sp-newsletter-popup-benefits', icon: block.settings.icon, icon_only: true %}
            {% endif %}
          </span>
          <span class="sp-newsletter-popup__benefit-copy"><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.description | escape }}</small></span>
        {% if block.settings.link != blank %}</a>{% endif %}
      </div>
      {% endif %}
    {% endfor %}
    {% if show_fallback %}
      <div class="sp-newsletter-popup__benefit"><span class="sp-newsletter-popup__benefit-icon" aria-hidden="true">{% render 'sp-newsletter-popup-benefits', icon: 'bolt', icon_only: true %}</span><span class="sp-newsletter-popup__benefit-copy"><strong>{{ section.settings.benefit_1_title | escape }}</strong><small>{{ section.settings.benefit_1_description | escape }}</small></span></div>
      <div class="sp-newsletter-popup__benefit"><span class="sp-newsletter-popup__benefit-icon" aria-hidden="true">{% render 'sp-newsletter-popup-benefits', icon: 'tag', icon_only: true %}</span><span class="sp-newsletter-popup__benefit-copy"><strong>{{ section.settings.benefit_2_title | escape }}</strong><small>{{ section.settings.benefit_2_description | escape }}</small></span></div>
      <div class="sp-newsletter-popup__benefit"><span class="sp-newsletter-popup__benefit-icon" aria-hidden="true">{% render 'sp-newsletter-popup-benefits', icon: 'box', icon_only: true %}</span><span class="sp-newsletter-popup__benefit-copy"><strong>{{ section.settings.benefit_3_title | escape }}</strong><small>{{ section.settings.benefit_3_description | escape }}</small></span></div>
    {% endif %}
  </div>
  {% endif %}
{% endif %}
