{% comment %}Scoped product feature icon, no global icon changes.{% endcomment %}
<svg class="sp-product-feature__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'battery' %}<rect x="5" y="4" width="13" height="16" rx="2"/><path d="M9 1h5M18 9h2v6h-2M13 7l-3 5h4l-3 5"/>
    {% when 'snowflake' %}<path d="M12 2v20M4 7l16 10M4 17 20 7M8 4l4 3 4-3M8 20l4-3 4 3M3 10l1-3 4 0M16 17l4 0 1-3M3 14l1 3 4 0M16 7l4 0 1 3"/>
    {% when 'droplet' %}<path d="M12 3C10 6.4 6 10.1 6 14a6 6 0 0 0 12 0c0-3.9-4-7.6-6-11Z"/>
    {% when 'return' %}<path d="M8 7H4v-4M4.5 7A8 8 0 1 1 5 17"/>
    {% when 'audio' %}<path d="M3 10v4M7 6v12M11 3v18M15 7v10M19 5v14M23 10v4"/>
    {% when 'bluetooth' %}<path d="M7 7l10 10-5 4V3l5 4L7 17"/>
    {% when 'truck' %}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {% when 'star' %}<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/>
    {% when 'leaf' %}<path d="M20 4C10 4 5 7 5 13a6 6 0 0 0 6 6c6 0 9-7 9-15Z"/><path d="M4 21c3-6 7-9 12-12"/>
    {% else %}<path d="M12 3 20 6v5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-3Z"/><path d="m8 12 3 3 5-6"/>
  {% endcase %}
</svg>
