<div class="sp-field"><label for="SortBy-{{ section.id }}">{{ 'collections.sorting.sort_by' | t }}</label><select id="SortBy-{{ section.id }}" name="sort_by" data-sort-by>{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></div>
