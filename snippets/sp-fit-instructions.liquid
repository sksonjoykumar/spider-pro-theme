<ul class="sp-fit__instruction-list">
{%- for block in section.blocks -%}
  {%- if block.type == 'measurement_instruction' and block.settings.measurement_name != blank -%}
    <li data-sp-block-id="{{ block.id }}" {{ block.shopify_attributes }}><strong>{{ block.settings.measurement_name | escape }}:</strong> {{ block.settings.instruction | escape }}</li>
  {%- endif -%}
{%- endfor -%}
</ul>
