<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex,nofollow">
    {% render 'meta-tags' %}
    {% render 'global-settings-css' %}
    {{ 'sp-reset.css' | asset_url | stylesheet_tag }}
    {{ 'sp-base.css' | asset_url | stylesheet_tag }}
    {{ 'sp-components.css' | asset_url | stylesheet_tag }}
    {{ 'sp-global-forms.css' | asset_url | stylesheet_tag }}
    {{ 'sp-premium-interactions.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <style>
      /* Scope the standalone layout to the password page only. */
      body.sp-password-layout { margin: 0; width: 100%; min-height: 100vh; min-height: 100dvh; }
      .sp-password-layout #MainContent {
        display: flex;
        flex-direction: column;
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        padding: 0;
        margin: 0;
      }
      .sp-password-layout #MainContent > .shopify-section {
        display: flex;
        flex-direction: column;
        flex: 1 0 auto;
        width: 100%;
        min-width: 0;
      }
      .sp-password-layout #MainContent > .shopify-section > .sp-pw {
        flex: 1 0 auto;
      }
    </style>
  </head>
  <body class="sp-password-layout">
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% render 'global-settings-json' %}
    <script src="{{ 'sp-core.js' | asset_url }}" defer></script>
  </body>
</html>
